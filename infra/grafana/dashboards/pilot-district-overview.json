      "title": "IEPs Managed",
      "type": "stat",
      "targets": [
        {
          "expr": "aivo_ieps_total{namespace=\"aivo-prod\", tenant_id=\"anoka-hennepin\", status=\"ACTIVE\"}",
          "legendFormat": "Active IEPs"
