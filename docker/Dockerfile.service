# ==============================================================================
# AIVO Platform - Service Dockerfile
# ==============================================================================
# Multi-stage build for NestJS services

# Stage 1: Builder
FROM node:20.18.1-alpine AS builder

# Install build dependencies
RUN apk add --no-cache g++ make python3

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate

# Copy workspace files
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json tsconfig.base.json tsconfig.compat.json ./
COPY packages/ ./packages/
COPY libs/ ./libs/

# Copy service files
ARG SERVICE_NAME
COPY services/${SERVICE_NAME}/ ./services/${SERVICE_NAME}/

# Prepare entrypoint (fallback if service script is missing)
# All current services use dist/index.js as their entry point
RUN if [ -f "services/${SERVICE_NAME}/scripts/docker-entrypoint.sh" ]; then \
            cp "services/${SERVICE_NAME}/scripts/docker-entrypoint.sh" /app/docker-entrypoint.sh; \
        elif [ -f "services/${SERVICE_NAME}/src/main.ts" ]; then \
            printf '#!/bin/sh\nexec node dist/main.js\n' > /app/docker-entrypoint.sh; \
        else \
            printf '#!/bin/sh\nexec node dist/index.js\n' > /app/docker-entrypoint.sh; \
        fi

# Install dependencies
RUN pnpm install --frozen-lockfile

# Generate Prisma client if schema exists (with checksum bypass for offline builds)
ENV PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1
RUN if [ -f "services/${SERVICE_NAME}/prisma/schema.prisma" ]; then \
      cd services/${SERVICE_NAME} && npx prisma generate --schema=prisma/schema.prisma; \
    fi

# Build the service and its workspace dependencies
RUN pnpm turbo build --filter="@aivo/${SERVICE_NAME}..."

# Prune dev dependencies
RUN pnpm prune --prod

# Stage 2: Runner
FROM node:20.18.1-alpine AS runner

# Security: Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001 -G nodejs

WORKDIR /app

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init

# Copy built application
ARG SERVICE_NAME
COPY --from=builder --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nodejs:nodejs /app/services/${SERVICE_NAME}/dist ./dist
COPY --from=builder --chown=nodejs:nodejs /app/services/${SERVICE_NAME}/package.json ./

# Copy scripts
COPY --from=builder --chown=nodejs:nodejs /app/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Service-specific port configuration
# Each service defines its own default port in config.ts; this ARG allows
# the CI pipeline to set the correct port per service at build time.
ARG SERVICE_PORT=3000
ENV NODE_ENV=production \
    PORT=${SERVICE_PORT}

# Expose the service port
EXPOSE ${SERVICE_PORT}

# Health check using the correct service port
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:${PORT}/health || exit 1

# Switch to non-root user
USER nodejs

# Use dumb-init as entrypoint
ENTRYPOINT ["/usr/bin/dumb-init", "--"]

CMD ["/usr/local/bin/docker-entrypoint.sh"]
