{
  "name": "@aivo/ts-api-utils",
  "version": "1.0.0",
  "description": "TypeScript API utilities for Aivo services",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./versioning": {
      "import": "./dist/versioning.js",
      "types": "./dist/versioning.d.ts"
    },
    "./versioned-routes": {
      "import": "./dist/versioned-routes.js",
      "types": "./dist/versioned-routes.d.ts"
    },
    "./internal-versioning": {
      "import": "./dist/internal-versioning.js",
      "types": "./dist/internal-versioning.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aivo/rate-limiter": "workspace:*",
    "dataloader": "^2.2.3",
    "pino": "^9.6.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.10.4",
    "fastify": "^4.29.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "fastify": ">=4.0.0",
    "@prisma/client": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    },
    "@prisma/client": {
      "optional": true
    }
  },
  "files": [
    "dist"
  ],
  "license": "UNLICENSED",
  "private": true
}
