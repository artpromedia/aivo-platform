{
  "name": "@aivo/auth-web",
  "version": "0.1.0",
  "private": true,
  "description": "Shared authentication utilities for AIVO Next.js web apps",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./middleware": {
      "import": "./src/middleware.ts",
      "types": "./src/middleware.ts"
    },
    "./client": {
      "import": "./src/client.tsx",
      "types": "./src/client.tsx"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "jose": "^5.2.0"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "next": "15.5.12",
    "react": "^19.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
