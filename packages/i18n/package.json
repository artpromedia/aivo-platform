{
  "name": "@aivo/i18n",
  "version": "1.0.0",
  "description": "Internationalization framework for AIVO platform",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./rtl": {
      "import": "./dist/rtl/index.mjs",
      "require": "./dist/rtl/index.js",
      "types": "./dist/rtl/index.d.ts"
    },
    "./core": {
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./formatters": {
      "import": "./dist/formatters/index.mjs",
      "require": "./dist/formatters/index.js",
      "types": "./dist/formatters/index.d.ts"
    },
    "./styles": {
      "import": "./dist/styles/index.mjs",
      "require": "./dist/styles/index.js",
      "types": "./dist/styles/index.d.ts"
    },
    "./config": {
      "import": "./dist/config.mjs",
      "require": "./dist/config.js",
      "types": "./dist/config.d.ts"
    },
    "./components": {
      "import": "./dist/components/index.mjs",
      "require": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    },
    "./locales": {
      "import": "./dist/locales/index.mjs",
      "require": "./dist/locales/index.js",
      "types": "./dist/locales/index.d.ts"
    },
    "./locales/*": {
      "import": "./src/locales/*.json"
    },
    "./middleware": {
      "import": "./dist/middleware.mjs",
      "require": "./dist/middleware.js",
      "types": "./dist/middleware.d.ts"
    },
    "./server": {
      "import": "./dist/server.mjs",
      "require": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./rtl.css": "./src/rtl.css"
  },
  "scripts": {
    "build": "tsup src/index.ts src/react/index.ts src/rtl/index.ts src/core/index.ts src/formatters/index.ts src/styles/index.ts src/config.ts src/components/index.ts src/locales/index.ts src/middleware.ts src/server.ts --format cjs,esm --dts --external next",
    "dev": "tsup src/index.ts src/react/index.ts src/rtl/index.ts src/core/index.ts src/formatters/index.ts src/styles/index.ts src/config.ts src/components/index.ts src/locales/index.ts src/middleware.ts src/server.ts --format cjs,esm --dts --watch --external next",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "extract": "node scripts/extract-translations.js"
  },
  "dependencies": {
    "intl-messageformat": "^10.5.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.0.0",
    "@types/node": "^20.10.0",
    "@types/react": "^19.0.0",
    "jsdom": "^24.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "tailwindcss": ">=3.0.0",
    "next": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "translation",
    "rtl",
    "react"
  ],
  "license": "MIT"
}
