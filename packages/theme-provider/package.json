{
  "name": "@aivo/theme-provider",
  "version": "0.1.0",
  "private": true,
  "description": "White-label theming & branding provider for AIVO web apps",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./react": {
      "import": "./src/react.tsx",
      "types": "./src/react.tsx"
    },
    "./tailwind": {
      "import": "./src/tailwind.ts",
      "types": "./src/tailwind.ts"
    },
    "./next-api": {
      "import": "./src/next-api.ts",
      "types": "./src/next-api.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {},
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "next": "15.5.12",
    "react": "^19.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
