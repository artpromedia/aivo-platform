{
  "name": "@aivo/ts-agents",
  "version": "1.0.0",
  "description": "AI Agent infrastructure framework with Redis-backed state persistence, episodic memory, and tool execution capabilities",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.mts",
        "default": "./dist/core/index.mjs"
      },
      "require": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      }
    },
    "./state": {
      "import": {
        "types": "./dist/state/index.d.mts",
        "default": "./dist/state/index.mjs"
      },
      "require": {
        "types": "./dist/state/index.d.ts",
        "default": "./dist/state/index.js"
      }
    },
    "./memory": {
      "import": {
        "types": "./dist/memory/index.d.mts",
        "default": "./dist/memory/index.mjs"
      },
      "require": {
        "types": "./dist/memory/index.d.ts",
        "default": "./dist/memory/index.js"
      }
    },
    "./tools": {
      "import": {
        "types": "./dist/tools/index.d.mts",
        "default": "./dist/tools/index.mjs"
      },
      "require": {
        "types": "./dist/tools/index.d.ts",
        "default": "./dist/tools/index.js"
      }
    },
    "./providers": {
      "import": {
        "types": "./dist/providers/index.d.mts",
        "default": "./dist/providers/index.mjs"
      },
      "require": {
        "types": "./dist/providers/index.d.ts",
        "default": "./dist/providers/index.js"
      }
    },
    "./conversation": {
      "import": {
        "types": "./dist/conversation/index.d.mts",
        "default": "./dist/conversation/index.mjs"
      },
      "require": {
        "types": "./dist/conversation/index.d.ts",
        "default": "./dist/conversation/index.js"
      }
    },
    "./educational": {
      "import": {
        "types": "./dist/educational/index.d.mts",
        "default": "./dist/educational/index.mjs"
      },
      "require": {
        "types": "./dist/educational/index.d.ts",
        "default": "./dist/educational/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ai",
    "agents",
    "llm",
    "state-management",
    "redis",
    "memory",
    "tools",
    "educational",
    "tutoring",
    "anthropic",
    "openai"
  ],
  "author": "Aivo Platform Team",
  "license": "UNLICENSED",
  "dependencies": {
    "uuid": "^9.0.0",
    "zod": "^3.22.4"
  },
  "peerDependencies": {
    "ioredis": "^5.3.0",
    "@anthropic-ai/sdk": ">=0.20.0",
    "openai": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.0",
    "ioredis": "^5.3.2",
    "openai": "^4.28.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
