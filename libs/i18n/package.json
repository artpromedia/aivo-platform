{
  "name": "@aivo/i18n",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./messages/*": "./src/messages/*.json",
    "./provider": "./src/provider/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./utils": "./src/utils/index.ts",
    "./constants": "./src/constants/index.ts"
  },
  "scripts": {
    "lint": "eslint src",
    "test": "vitest run",
    "build": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "extract": "formatjs extract 'src/**/*.ts*' --out-file lang/en.json --id-interpolation-pattern '[sha512:contenthash:base64:6]'",
    "compile": "formatjs compile-folder --ast src/messages compiled",
    "pseudo": "formatjs compile lang/en.json --ast --pseudo-locale en-XA --out-file compiled/en-XA.json"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@formatjs/intl-datetimeformat": "^6.14.0",
    "@formatjs/intl-displaynames": "^6.8.0",
    "@formatjs/intl-listformat": "^7.7.0",
    "@formatjs/intl-locale": "^4.2.0",
    "@formatjs/intl-numberformat": "^8.13.0",
    "@formatjs/intl-pluralrules": "^5.4.0",
    "@formatjs/intl-relativetimeformat": "^11.4.0",
    "react-intl": "^7.1.0"
  },
  "devDependencies": {
    "@formatjs/cli": "^6.4.0",
    "@types/react": "^18.3.12",
    "typescript": "^5.5.4",
    "vitest": "^3.0.4"
  }
}
