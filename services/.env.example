# AIVO Platform - Services Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# This file documents ALL environment variables used across AIVO services.
# Copy this to .env and fill in your values.
# ═══════════════════════════════════════════════════════════════════════════════

# ===========================================
# Environment Detection
# ===========================================
# Set to 'production' for production deployments
NODE_ENV=development
ENVIRONMENT=development
LOG_LEVEL=INFO

# Development mode flags - MUST BE false in production
IS_DEVELOPMENT=true

# ===========================================
# Database Configuration
# ===========================================
# PostgreSQL - Main database
DATABASE_URL=postgresql://aivo:aivo@localhost:5433/aivo
POSTGRES_USER=aivo
POSTGRES_PASSWORD=aivo
POSTGRES_DB=aivo

# Service-specific databases
AI_INFERENCE_DB_URL=postgresql+asyncpg://aivo:aivo@localhost:5433/ai_inference
TRAINING_DB_URL=postgresql://aivo:aivo@localhost:5433/training
CURRICULUM_DB_URL=postgresql+asyncpg://aivo:aivo@localhost:5433/curriculum
GATEWAY_DB_URL=postgresql://aivo:aivo@localhost:5433/gateway

# ===========================================
# Redis Configuration
# ===========================================
REDIS_URL=redis://localhost:6380/0

# ═══════════════════════════════════════════════════════════════════════════════
# LLM PROVIDER CONFIGURATION (AI Orchestrator)
# ═══════════════════════════════════════════════════════════════════════════════
#
# LOCAL DEVELOPMENT: Use Ollama (free, no API costs)
#   LLM_PRIMARY_PROVIDER=ollama
#   LLM_FALLBACK_ORDER=ollama
#
# PRODUCTION: Use Google Gemini as primary, OpenAI/Anthropic as fallbacks
#   LLM_PRIMARY_PROVIDER=google
#   LLM_FALLBACK_ORDER=google,openai,anthropic
#
# ═══════════════════════════════════════════════════════════════════════════════

# Provider Selection (ollama for dev, google for production)
LLM_PRIMARY_PROVIDER=ollama
LLM_FALLBACK_ORDER=ollama

# ───────────────────────────────────────────────────────────────────────────────
# Ollama (Local Development - Free, No API Key Required)
# ───────────────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=120000

# ───────────────────────────────────────────────────────────────────────────────
# Google Gemini (Production Primary)
# Get API key from: https://aistudio.google.com/app/apikey
# Or use Vertex AI with service account for enterprise
# ───────────────────────────────────────────────────────────────────────────────
GOOGLE_GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_PROJECT_ID=
GOOGLE_LOCATION=us-central1
GOOGLE_RATE_LIMIT_TPM=100000
GOOGLE_RATE_LIMIT_RPM=500

# ───────────────────────────────────────────────────────────────────────────────
# OpenAI (Production Fallback 1)
# Get API key from: https://platform.openai.com/api-keys
# ───────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_ORGANIZATION_ID=
OPENAI_RATE_LIMIT_TPM=150000
OPENAI_RATE_LIMIT_RPM=500

# ───────────────────────────────────────────────────────────────────────────────
# Anthropic Claude (Production Fallback 2)
# Get API key from: https://console.anthropic.com/
# ───────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_RATE_LIMIT_TPM=100000
ANTHROPIC_RATE_LIMIT_RPM=500

# ───────────────────────────────────────────────────────────────────────────────
# LLM Cache Configuration (Redis required for production)
# ───────────────────────────────────────────────────────────────────────────────
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=3600
LLM_CACHE_REDIS_URL=redis://localhost:6380/1

# ===========================================
# Service URLs (for Docker Compose)
# ===========================================
AI_ORCHESTRATOR_URL=http://ai-orchestrator:3000
AI_INFERENCE_URL=http://ai-inference-svc:8000
TRAINING_URL=http://training-svc:8000
CURRICULUM_URL=http://curriculum-py-svc:8000
GATEWAY_URL=http://python-api-gateway:8000

# ===========================================
# CORS Configuration
# ===========================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8000"]

# ===========================================
# JWT/Auth Configuration
# ===========================================
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===========================================
# Safety Configuration
# ===========================================
SAFETY_STRICT_MODE=true
SAFETY_LOG_BLOCKED_CONTENT=true

# ===========================================
# ML/Training Configuration (optional)
# ===========================================
# Weights & Biases (optional - for ML experiment tracking)
# WANDB_API_KEY=your-wandb-key
# WANDB_PROJECT=aivo-training

# MLflow (optional - for MLOps)
# MLFLOW_TRACKING_URI=http://mlflow:5000
