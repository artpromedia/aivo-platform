# Translation Service Environment Configuration
# Copy this file to .env and fill in the appropriate values

# =============================================================================
# Server Configuration
# =============================================================================
NODE_ENV=development
PORT=4080

# =============================================================================
# Database Configuration (PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql://aivo:aivo_dev_password@localhost:5432/aivo_translation

# Enable SSL for database connections (set to true in production)
PGSSL=false

# =============================================================================
# Authentication
# =============================================================================
JWT_PUBLIC_KEY=
JWT_SECRET=dev-only-not-for-production

# =============================================================================
# Service Discovery
# =============================================================================
NATS_URL=nats://localhost:4222

# =============================================================================
# Translation Provider Configuration
# =============================================================================
# Primary provider (google, aws, azure, deepl)
TRANSLATION_PROVIDER=google

# Google Cloud Translation
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=

# AWS Translate
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Azure Translator
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# DeepL
DEEPL_API_KEY=

# =============================================================================
# Translation Settings
# =============================================================================
# Default source language
DEFAULT_SOURCE_LANGUAGE=en

# Supported target languages (comma-separated)
SUPPORTED_LANGUAGES=en,es,fr,de,zh,ja,ko,pt,ar,hi

# Cache translations
ENABLE_TRANSLATION_CACHE=true

# =============================================================================
# Redis for Translation Cache
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# Observability
# =============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
