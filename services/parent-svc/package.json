{
  "name": "@aivo/parent-svc",
  "version": "1.0.0",
  "description": "Parent engagement service for AIVO platform",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && node scripts/strip-prisma-sourcemaps.js && tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "seed:families": "tsx prisma/seed-families.ts"
  },
  "dependencies": {
    "@aivo/events": "workspace:*",
    "@aivo/seed-data": "workspace:*",
    "@aivo/ts-observability": "workspace:*",
    "@aivo/ts-rbac": "workspace:*",
    "@aivo/ts-resilience": "workspace:*",
    "@aivo/ts-shared": "workspace:*",
    "@aivo/ts-types": "workspace:*",
    "@aivo/ts-utils": "workspace:*",
    "@aws-sdk/client-comprehend": "^3.971.0",
    "@prisma/client": "^5.10.0",
    "@types/nodemailer": "^7.0.5",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.2.3",
    "firebase-admin": "^12.7.0",
    "handlebars": "^4.7.8",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.12",
    "pdfkit": "^0.14.0",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/archiver": "^6.0.3",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.5",
    "@types/pdfkit": "^0.13.4",
    "prisma": "^5.10.0",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1"
  },
  "aivo": {
    "phase": 1,
    "disposition": "keep",
    "framework": "fastify"
  }
}
