    "@fastify/rate-limit": "^9.1.0",
    "@octokit/rest": "^21.0.0",
    "@prisma/client": "^5.22.0",
    "archiver": "^7.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-plugin": "^5.0.1",
    "node-cron": "^3.0.3",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.0",
    "@types/node": "^22.7.5",
    "@types/node-cron": "^3.0.11",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1",
