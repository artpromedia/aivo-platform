# ══════════════════════════════════════════════════════════════════════════════
# Compliance Evidence Service — Environment
# ══════════════════════════════════════════════════════════════════════════════

PORT=3092
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ── S3 Evidence Storage ──────────────────────────────────────────────────────
S3_BUCKET=aivo-compliance-evidence
S3_REGION=us-east-1
S3_ENDPOINT=                         # leave blank for AWS, set for MinIO/R2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Internal Service URLs ────────────────────────────────────────────────────
AUTH_SVC_URL=http://localhost:3000
AUDIT_SVC_URL=http://localhost:3004
COMPLIANCE_SVC_URL=http://localhost:3012
PROMETHEUS_URL=http://localhost:9090

# ── GitHub (change management evidence) ──────────────────────────────────────
GITHUB_TOKEN=                        # PAT with repo + read:org scope
GITHUB_OWNER=artpromedia
GITHUB_REPO=aivo-platform

# ── Database (evidence metadata) ─────────────────────────────────────────────
DATABASE_URL=postgresql://aivo:aivo@localhost:5432/compliance_evidence

# ── Evidence Retention ────────────────────────────────────────────────────────
EVIDENCE_RETENTION_DAYS=2555         # ~7 years
IMMUTABLE_LOCK_DAYS=365              # S3 Object Lock governance period
