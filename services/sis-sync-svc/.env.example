# ──────────────────────────────────────────────────────────────────
# SIS Sync Service — Environment Configuration
# ──────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://aivo:aivo_dev_password@localhost:5432/aivo_tenant

# ── Server ───────────────────────────────────────────────────────
PORT=4016
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# Base URL for OAuth redirect callbacks (must be reachable by the browser)
BASE_URL=http://localhost:4016

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── NATS ─────────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222

# ── Sync Engine ──────────────────────────────────────────────────
MAX_CONCURRENT_SYNCS=2
SYNC_LOCK_TIMEOUT=1800000

# ── Clever ───────────────────────────────────────────────────────
# 1. Register at https://dev.clever.com  →  create a Development App
# 2. In Sandbox → add a test district (e.g. "Aivo QA District")
# 3. Copy Client ID & Secret from Settings → Basic Information
# 4. Set Redirect URI to ${BASE_URL}/api/v1/oauth/clever/callback
CLEVER_CLIENT_ID=
CLEVER_CLIENT_SECRET=
# Clever sandbox base URL (switch to https://api.clever.com for production)
CLEVER_BASE_URL=https://api.clever.com

# ── ClassLink ────────────────────────────────────────────────────
CLASSLINK_TENANT_ID=
CLASSLINK_CLIENT_ID=
CLASSLINK_CLIENT_SECRET=

# ── Google Workspace ─────────────────────────────────────────────
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=

# ── Microsoft Entra (Azure AD) ───────────────────────────────────
MICROSOFT_ENTRA_CLIENT_ID=
MICROSOFT_ENTRA_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ── OneRoster ────────────────────────────────────────────────────
# ONEROSTER_BASE_URL=
# ONEROSTER_CLIENT_ID=
# ONEROSTER_CLIENT_SECRET=

# ── Ed-Fi ────────────────────────────────────────────────────────
# EDFI_BASE_URL=
# EDFI_CLIENT_ID=
# EDFI_CLIENT_SECRET=

# ── PowerSchool ──────────────────────────────────────────────────
# POWERSCHOOL_BASE_URL=
# POWERSCHOOL_CLIENT_ID=
# POWERSCHOOL_CLIENT_SECRET=

# ── Infinite Campus ──────────────────────────────────────────────
