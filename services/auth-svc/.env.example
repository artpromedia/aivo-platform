# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aivo_auth

# Auth — RS256 asymmetric keys (paths or inline PEM)
# For local dev, run: bash scripts/generate-keys.sh
JWT_PRIVATE_KEY_PATH=.keys/private.pem
JWT_PUBLIC_KEY_PATH=.keys/public.pem
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
CONSUMER_TENANT_ID=00000000-0000-0000-0000-000000000000

# Cookie & CSRF
COOKIE_SECRET=generate-with-openssl-rand-hex-32
CSRF_ENABLED=true

# Server
PORT=4001

# SCIM 2.0 Directory Sync
SCIM_ENABLED=true
NATS_URL=nats://localhost:4222
