# ══════════════════════════════════════════════════════════════════════════════
# AIVO Event Collector Service - Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════

# Server
PORT=4060
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
INSTANCE_ID=collector-1

# Database (PostgreSQL)
DATABASE_URL=postgresql://localhost:5432/aivo_events

# JWT Authentication
JWT_PUBLIC_KEY_PATH=../../.keys/jwt-public.pem
INTERNAL_API_KEY=dev-internal-key

# Redis (for deduplication)
REDIS_URL=redis://localhost:6379

# NATS (for event routing)
NATS_URL=nats://localhost:4222
NATS_ENABLED=true

# Ingestion Settings
MAX_BATCH_SIZE=1000
MAX_PAYLOAD_SIZE=1048576
DEDUPLICATION_TTL_MS=86400000

# Batching Settings
BATCH_SIZE=100
BATCH_TIMEOUT_MS=5000
STALE_BATCH_THRESHOLD_MS=30000

# Processing Settings
BATCH_CONCURRENCY=4
WORKER_CONCURRENCY=10

# Service URLs
AUTH_SVC_URL=http://auth-svc:4001
