# ══════════════════════════════════════════════════════════════════════════════
# AIVO Audit Service - Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════

# Server
PORT=4050
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL - immutable audit log)
DATABASE_URL=postgresql://localhost:5432/aivo_audit

# JWT Authentication
JWT_PUBLIC_KEY_PATH=../../.keys/jwt-public.pem
INTERNAL_API_KEY=dev-internal-key

# Redis (for caching audit queries)
REDIS_URL=redis://localhost:6379

# NATS (for consuming events from other services)
NATS_URL=nats://localhost:4222
NATS_ENABLED=true

# Retention Settings
AUDIT_RETENTION_DAYS=2555
EXPORT_RETENTION_DAYS=90

# Service URLs
AUTH_SVC_URL=http://auth-svc:4001
