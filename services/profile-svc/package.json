{
  "name": "@aivo/profile-svc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Neurodiversity profiles and accommodations service for learners",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "seed:families": "tsx prisma/seed-families.ts"
  },
  "dependencies": {
    "@aivo/events": "workspace:*",
    "@aivo/seed-data": "workspace:*",
    "@aivo/ts-api-utils": "workspace:*",
    "@aivo/ts-rbac": "workspace:*",
    "@fastify/cors": "^8.5.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "nats": "^2.29.3",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
