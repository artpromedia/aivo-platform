// ══════════════════════════════════════════════════════════════════════════════
// AIVO Legal Hold Service - Prisma Schema
// ══════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════════════════════════════════════════════
// LEGAL MATTERS
// ══════════════════════════════════════════════════════════════════════════════

model LegalMatter {
  id              String       @id @default(uuid())
  tenantId        String
  matterNumber    String       // External reference number
  name            String
  description     String?
  matterType      MatterType
  status          MatterStatus @default(ACTIVE)

  // Key dates
  openedAt        DateTime     @default(now())
  closedAt        DateTime?
  anticipatedEnd  DateTime?

  // Legal team
  leadCounsel     String?
  outsideCounsel  String?
  paralegal       String?

  // Case details
  jurisdiction    String?
  caseNumber      String?
  opposingParty   String?
  claimAmount     Decimal?     @db.Decimal(15, 2)

  // Risk assessment
  riskLevel       RiskLevel    @default(MEDIUM)
  riskNotes       String?

  // Metadata
  tags            String[]
  metadata        Json?

  createdBy       String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  holds           LegalHold[]
  custodians      MatterCustodian[]
  documents       MatterDocument[]
  notes           MatterNote[]
  activities      MatterActivity[]

  @@unique([tenantId, matterNumber])
  @@index([tenantId, status])
  @@index([tenantId, matterType])
  @@index([tenantId, openedAt])
}

enum MatterType {
  LITIGATION
  REGULATORY
  INVESTIGATION
  AUDIT
  ARBITRATION
  COMPLIANCE
  OTHER
}

enum MatterStatus {
  ACTIVE
  ON_HOLD
  SETTLED
  CLOSED
  ARCHIVED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ══════════════════════════════════════════════════════════════════════════════
// LEGAL HOLDS
// ══════════════════════════════════════════════════════════════════════════════

model LegalHold {
  id                  String          @id @default(uuid())
  tenantId            String
  matterId            String
  matter              LegalMatter     @relation(fields: [matterId], references: [id])

  holdNumber          String          // Internal hold reference
  name                String
  description         String?
  status              HoldStatus      @default(DRAFT)

  // Hold scope
  scopeDescription    String?
  dataTypes           String[]        // Email, Documents, Chat, etc.
  dateRangeStart      DateTime?
  dateRangeEnd        DateTime?
  keywords            String[]

  // Hold dates
  issuedAt            DateTime?
  effectiveAt         DateTime?
  releasedAt          DateTime?

  // Notifications
  notificationSubject String?
  notificationBody    String?         @db.Text
  reminderFrequency   Int?            // Days between reminders
  escalationAfter     Int?            // Days before escalation

  // Compliance tracking
  acknowledgmentDue   DateTime?
  complianceDeadline  DateTime?

  // Metadata
  isConfidential      Boolean         @default(false)
  priority            HoldPriority    @default(NORMAL)
  tags                String[]
  metadata            Json?

  createdBy           String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  // Relations
  custodians          HoldCustodian[]
  dataSources         HoldDataSource[]
  notifications       HoldNotification[]
  acknowledgments     HoldAcknowledgment[]
  releases            HoldRelease[]
  auditLog            HoldAuditLog[]

  @@unique([tenantId, holdNumber])
  @@index([tenantId, status])
  @@index([tenantId, matterId])
  @@index([tenantId, issuedAt])
}

enum HoldStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ISSUED
  ACTIVE
  SUSPENDED
  RELEASED
  ARCHIVED
}

enum HoldPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ══════════════════════════════════════════════════════════════════════════════
// CUSTODIANS
// ══════════════════════════════════════════════════════════════════════════════

model Custodian {
  id              String       @id @default(uuid())
  tenantId        String

  // Identity
  userId          String?      // Link to auth user if exists
  employeeId      String?
  email           String
  firstName       String
  lastName        String
  displayName     String

  // Organization
  department      String?
  title           String?
  location        String?
  manager         String?

  // Contact
  phone           String?
  alternateEmail  String?

  // Employment
  status          CustodianStatus @default(ACTIVE)
  hireDate        DateTime?
  terminationDate DateTime?

  // Metadata
  metadata        Json?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  matters         MatterCustodian[]
  holds           HoldCustodian[]
  dataSources     CustodianDataSource[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([tenantId, department])
  @@index([tenantId, userId])
}

enum CustodianStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  ON_LEAVE
}

model MatterCustodian {
  id          String      @id @default(uuid())
  matterId    String
  matter      LegalMatter @relation(fields: [matterId], references: [id])
  custodianId String
  custodian   Custodian   @relation(fields: [custodianId], references: [id])

  role        String?     // Witness, Subject, etc.
  relevance   String?
  notes       String?

  addedAt     DateTime    @default(now())
  addedBy     String
  removedAt   DateTime?
  removedBy   String?

  @@unique([matterId, custodianId])
  @@index([matterId])
  @@index([custodianId])
}

model HoldCustodian {
  id                  String    @id @default(uuid())
  holdId              String
  hold                LegalHold @relation(fields: [holdId], references: [id])
  custodianId         String
  custodian           Custodian @relation(fields: [custodianId], references: [id])

  status              HoldCustodianStatus @default(PENDING)

  // Notification tracking
  notifiedAt          DateTime?
  notificationMethod  String?
  reminderCount       Int       @default(0)
  lastReminderAt      DateTime?
  escalatedAt         DateTime?
  escalatedTo         String?

  // Acknowledgment
  acknowledgedAt      DateTime?
  acknowledgmentNotes String?

  // Release
  releasedAt          DateTime?
  releaseReason       String?
  releasedBy          String?

  // Metadata
  notes               String?
  metadata            Json?

  addedAt             DateTime  @default(now())
  addedBy             String

  @@unique([holdId, custodianId])
  @@index([holdId, status])
  @@index([custodianId])
}

enum HoldCustodianStatus {
  PENDING
  NOTIFIED
  ACKNOWLEDGED
  NON_COMPLIANT
  ESCALATED
  RELEASED
  EXEMPT
}

// ══════════════════════════════════════════════════════════════════════════════
// DATA SOURCES
// ══════════════════════════════════════════════════════════════════════════════

model DataSource {
  id              String       @id @default(uuid())
  tenantId        String

  name            String
  description     String?
  sourceType      DataSourceType

  // Connection info (encrypted in production)
  connectionInfo  Json?

  // Capabilities
  canPreserve     Boolean      @default(true)
  canExport       Boolean      @default(true)
  canSearch       Boolean      @default(true)

  // Status
  isActive        Boolean      @default(true)
  lastSyncAt      DateTime?

  // Metadata
  metadata        Json?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  custodians      CustodianDataSource[]
  holds           HoldDataSource[]

  @@unique([tenantId, name])
  @@index([tenantId, sourceType])
}

enum DataSourceType {
  EMAIL
  FILE_SHARE
  SHAREPOINT
  ONEDRIVE
  GOOGLE_DRIVE
  SLACK
  TEAMS
  DATABASE
  APPLICATION
  ARCHIVE
  BACKUP
  OTHER
}

model CustodianDataSource {
  id            String     @id @default(uuid())
  custodianId   String
  custodian     Custodian  @relation(fields: [custodianId], references: [id])
  dataSourceId  String
  dataSource    DataSource @relation(fields: [dataSourceId], references: [id])

  identifier    String?    // Email address, user path, etc.
  estimatedSize BigInt?    // Bytes
  itemCount     Int?

  lastScanned   DateTime?

  @@unique([custodianId, dataSourceId])
  @@index([custodianId])
  @@index([dataSourceId])
}

model HoldDataSource {
  id            String     @id @default(uuid())
  holdId        String
  hold          LegalHold  @relation(fields: [holdId], references: [id])
  dataSourceId  String
  dataSource    DataSource @relation(fields: [dataSourceId], references: [id])

  status        PreservationStatus @default(PENDING)

  // Preservation details
  preservedAt   DateTime?
  preservedBy   String?
  preservationId String?   // External system reference

  // Metrics
  itemsPreserved Int?
  sizePreserved  BigInt?

  // Release
  releasedAt    DateTime?
  releasedBy    String?

  notes         String?

  @@unique([holdId, dataSourceId])
  @@index([holdId, status])
}

enum PreservationStatus {
  PENDING
  IN_PROGRESS
  PRESERVED
  FAILED
  RELEASED
}

// ══════════════════════════════════════════════════════════════════════════════
// NOTIFICATIONS
// ══════════════════════════════════════════════════════════════════════════════

model HoldNotification {
  id              String       @id @default(uuid())
  holdId          String
  hold            LegalHold    @relation(fields: [holdId], references: [id])

  notificationType NotificationType
  recipientEmail  String
  recipientName   String

  subject         String
  body            String       @db.Text

  status          NotificationStatus @default(PENDING)
  sentAt          DateTime?
  deliveredAt     DateTime?
  failedAt        DateTime?
  failureReason   String?

  // Tracking
  openedAt        DateTime?
  clickedAt       DateTime?

  createdAt       DateTime     @default(now())

  @@index([holdId, status])
  @@index([recipientEmail])
}

enum NotificationType {
  INITIAL_NOTICE
  REMINDER
  ESCALATION
  RELEASE_NOTICE
  UPDATE_NOTICE
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  OPENED
  FAILED
  BOUNCED
}

// ══════════════════════════════════════════════════════════════════════════════
// ACKNOWLEDGMENTS
// ══════════════════════════════════════════════════════════════════════════════

model HoldAcknowledgment {
  id              String    @id @default(uuid())
  holdId          String
  hold            LegalHold @relation(fields: [holdId], references: [id])

  custodianEmail  String
  custodianName   String

  // Acknowledgment details
  acknowledgedAt  DateTime
  ipAddress       String?
  userAgent       String?

  // Certification
  certificationText String   @db.Text
  signature       String?    // Digital signature or typed name

  // Questions/Concerns
  hasQuestions    Boolean    @default(false)
  questions       String?    @db.Text

  createdAt       DateTime   @default(now())

  @@index([holdId])
  @@index([custodianEmail])
}

// ══════════════════════════════════════════════════════════════════════════════
// HOLD RELEASES
// ══════════════════════════════════════════════════════════════════════════════

model HoldRelease {
  id              String       @id @default(uuid())
  holdId          String
  hold            LegalHold    @relation(fields: [holdId], references: [id])

  releaseType     ReleaseType
  reason          String
  notes           String?      @db.Text

  // Approval
  approvedBy      String
  approvedAt      DateTime

  // Execution
  executedAt      DateTime?
  executedBy      String?

  // Affected scope
  affectedCustodians String[]
  affectedSources    String[]

  createdAt       DateTime     @default(now())

  @@index([holdId])
}

enum ReleaseType {
  FULL
  PARTIAL_CUSTODIAN
  PARTIAL_SOURCE
  PARTIAL_DATE_RANGE
}

// ══════════════════════════════════════════════════════════════════════════════
// MATTER DOCUMENTS
// ══════════════════════════════════════════════════════════════════════════════

model MatterDocument {
  id              String       @id @default(uuid())
  matterId        String
  matter          LegalMatter  @relation(fields: [matterId], references: [id])

  name            String
  description     String?
  documentType    DocumentType

  // Storage
  filePath        String?
  fileSize        BigInt?
  mimeType        String?
  checksum        String?

  // Metadata
  tags            String[]
  isConfidential  Boolean      @default(false)

  uploadedBy      String
  uploadedAt      DateTime     @default(now())

  @@index([matterId, documentType])
}

enum DocumentType {
  PLEADING
  DISCOVERY
  CORRESPONDENCE
  CONTRACT
  EVIDENCE
  REPORT
  POLICY
  OTHER
}

// ══════════════════════════════════════════════════════════════════════════════
// NOTES & ACTIVITY
// ══════════════════════════════════════════════════════════════════════════════

model MatterNote {
  id          String      @id @default(uuid())
  matterId    String
  matter      LegalMatter @relation(fields: [matterId], references: [id])

  content     String      @db.Text
  isPrivate   Boolean     @default(false)

  createdBy   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([matterId, createdAt])
}

model MatterActivity {
  id          String       @id @default(uuid())
  matterId    String
  matter      LegalMatter  @relation(fields: [matterId], references: [id])

  activityType String
  description String
  details     Json?

  performedBy String
  performedAt DateTime     @default(now())

  @@index([matterId, performedAt])
}

// ══════════════════════════════════════════════════════════════════════════════
// AUDIT LOG
// ══════════════════════════════════════════════════════════════════════════════

model HoldAuditLog {
  id          String    @id @default(uuid())
  holdId      String
  hold        LegalHold @relation(fields: [holdId], references: [id])

  action      String
  description String
  previousState Json?
  newState    Json?

  performedBy String
  performedAt DateTime  @default(now())
  ipAddress   String?

  @@index([holdId, performedAt])
  @@index([performedBy])
}

// ══════════════════════════════════════════════════════════════════════════════
// REPORTS & EXPORTS
// ══════════════════════════════════════════════════════════════════════════════

model HoldReport {
  id          String       @id @default(uuid())
  tenantId    String

  reportType  ReportType
  name        String
  parameters  Json

  status      ReportStatus @default(PENDING)

  // Generation
  generatedAt DateTime?
  generatedBy String

  // Output
  filePath    String?
  fileSize    BigInt?
  expiresAt   DateTime?

  createdAt   DateTime     @default(now())

  @@index([tenantId, reportType])
  @@index([tenantId, status])
}

enum ReportType {
  HOLD_STATUS
  CUSTODIAN_COMPLIANCE
  ACKNOWLEDGMENT_SUMMARY
  DATA_SOURCE_INVENTORY
  MATTER_SUMMARY
  AUDIT_TRAIL
}

enum ReportStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
  EXPIRED
}
