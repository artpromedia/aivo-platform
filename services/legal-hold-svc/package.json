{
  "name": "@aivo/legal-hold-svc",
  "version": "1.0.0",
  "description": "AIVO Legal Hold Service - Litigation hold and e-discovery management",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@aivo/ts-api-utils": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/multipart": "^8.1.0",
    "@prisma/client": "^5.22.0",
    "fast-jwt": "^4.0.1",
    "fastify": "^4.28.1",
    "ioredis": "^5.3.2",
    "nats": "^2.18.0",
    "nodemailer": "^6.9.8",
    "p-limit": "^5.0.0",
    "pino": "^8.16.2",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^6.4.14",
    "@types/uuid": "^9.0.7",
    "pino-pretty": "^10.2.3",
    "prisma": "^5.22.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  }
}
