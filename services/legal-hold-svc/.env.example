# ══════════════════════════════════════════════════════════════════════════════
# AIVO Legal Hold Service - Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════

# Server
PORT=4061
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://localhost:5432/aivo_legal_hold

# JWT Authentication
JWT_PUBLIC_KEY_PATH=../../.keys/jwt-public.pem
INTERNAL_API_KEY=dev-internal-key

# Redis
REDIS_URL=redis://localhost:6379

# NATS
NATS_URL=nats://localhost:4222
NATS_ENABLED=true

# Email (SMTP)
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=legal-hold@aivo.com
EMAIL_REPLY_TO=legal@aivo.com

# Hold Settings
DEFAULT_REMINDER_DAYS=7
DEFAULT_ESCALATION_DAYS=14
ACKNOWLEDGMENT_DEADLINE_DAYS=5
MAX_REMINDERS=5

# Notification Settings
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_RETRY_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY_MS=5000

# Report Settings
REPORT_EXPIRATION_DAYS=7
MAX_EXPORT_SIZE=100000

# Service URLs
AUTH_SVC_URL=http://auth-svc:4001
AUDIT_SVC_URL=http://audit-svc:4050
