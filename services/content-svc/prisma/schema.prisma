generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════════════════════════════════════════════
// ENUMS
// ══════════════════════════════════════════════════════════════════════════════

enum LearningObjectSubject {
  ELA
  MATH
  SCIENCE
  SEL
  SPEECH
  OTHER

  @@map("learning_object_subject")
}

enum LearningObjectGradeBand {
  K_2
  G3_5
  G6_8
  G9_12

  @@map("learning_object_grade_band")
}

enum LearningObjectVersionState {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  RETIRED

  @@map("learning_object_version_state")
}

// ══════════════════════════════════════════════════════════════════════════════
// MODELS
// ══════════════════════════════════════════════════════════════════════════════

/// Logical identity of a learning content unit.
/// Examples: "ELA G3 reading passage: Dogs in Winter"
model LearningObject {
  id               String                   @id @default(uuid()) @db.Uuid
  tenantId         String?                  @map("tenant_id") @db.Uuid
  slug             String
  title            String
  subject          LearningObjectSubject
  gradeBand        LearningObjectGradeBand  @map("grade_band")
  primarySkillId   String?                  @map("primary_skill_id") @db.Uuid
  isActive         Boolean                  @default(true) @map("is_active")
  createdByUserId  String                   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  versions     LearningObjectVersion[]
  tags         LearningObjectTag[]
  lessonDrafts LessonDraft[]

  @@unique([tenantId, slug])
  @@index([tenantId, subject, gradeBand])
  @@index([primarySkillId])
  @@map("learning_objects")
}

/// Versioned content with review workflow.
/// Only one PUBLISHED version per LO at a time.
model LearningObjectVersion {
  id                 String                      @id @default(uuid()) @db.Uuid
  learningObjectId   String                      @map("learning_object_id") @db.Uuid
  versionNumber      Int                         @map("version_number")
  state              LearningObjectVersionState  @default(DRAFT)
  createdByUserId    String                      @map("created_by_user_id") @db.Uuid
  reviewedByUserId   String?                     @map("reviewed_by_user_id") @db.Uuid
  approvedByUserId   String?                     @map("approved_by_user_id") @db.Uuid
  changeSummary      String?                     @map("change_summary")
  reviewNotes        String?                     @map("review_notes")
  contentJson        Json                        @map("content_json")
  accessibilityJson  Json                        @default("{}") @map("accessibility_json")
  standardsJson      Json                        @default("{}") @map("standards_json")
  metadataJson       Json                        @default("{}") @map("metadata_json")
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.Timestamptz
  publishedAt        DateTime?                   @map("published_at") @db.Timestamptz
  retiredAt          DateTime?                   @map("retired_at") @db.Timestamptz

  // Relations
  learningObject  LearningObject                   @relation(fields: [learningObjectId], references: [id], onDelete: Cascade)
  skills          LearningObjectSkill[]
  transitions     LearningObjectVersionTransition[]
  reviews         LearningObjectReview[]
  sensoryMetadata ContentSensoryMetadata?          // ND-2.1 Sensory matching

  @@unique([learningObjectId, versionNumber])
  @@index([learningObjectId, state, versionNumber(sort: Desc)])
  @@index([state])
  @@map("learning_object_versions")
}

/// Flexible tags for content discovery and filtering.
model LearningObjectTag {
  id               String   @id @default(uuid()) @db.Uuid
  learningObjectId String   @map("learning_object_id") @db.Uuid
  tag              String
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  learningObject LearningObject @relation(fields: [learningObjectId], references: [id], onDelete: Cascade)

  @@unique([learningObjectId, tag])
  @@index([tag])
  @@map("learning_object_tags")
}

/// Version-specific skill alignments beyond the primary skill.
model LearningObjectSkill {
  id                       String   @id @default(uuid()) @db.Uuid
  learningObjectVersionId  String   @map("learning_object_version_id") @db.Uuid
  skillId                  String   @map("skill_id") @db.Uuid
  isPrimary                Boolean  @default(false) @map("is_primary")
  weight                   Decimal? @db.Decimal(4, 3)
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  learningObjectVersion LearningObjectVersion @relation(fields: [learningObjectVersionId], references: [id], onDelete: Cascade)

  @@unique([learningObjectVersionId, skillId])
  @@index([skillId])
  @@map("learning_object_skills")
}

/// Audit trail for all workflow state changes.
model LearningObjectVersionTransition {
  id                    String                      @id @default(uuid()) @db.Uuid
  versionId             String                      @map("version_id") @db.Uuid
  fromState             LearningObjectVersionState  @map("from_state")
  toState               LearningObjectVersionState  @map("to_state")
  transitionedByUserId  String                      @map("transitioned_by_user_id") @db.Uuid
  reason                String?
  transitionedAt        DateTime                    @default(now()) @map("transitioned_at") @db.Timestamptz

  // Relations
  version LearningObjectVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, transitionedAt(sort: Desc)])
  @@map("learning_object_version_transitions")
}

// ══════════════════════════════════════════════════════════════════════════════
// CONTENT REVIEW
// ══════════════════════════════════════════════════════════════════════════════

enum ReviewDecision {
  APPROVED
  CHANGES_REQUESTED
  REJECTED

  @@map("review_decision")
}

/// Formal review records for learning object versions.
/// Supports multiple reviewers and detailed feedback tracking.
model LearningObjectReview {
  id                String                      @id @default(uuid()) @db.Uuid
  versionId         String                      @map("version_id") @db.Uuid
  reviewerUserId    String                      @map("reviewer_user_id") @db.Uuid
  decision          ReviewDecision
  comments          String?                     @db.Text
  validationErrors  Json                        @default("[]") @map("validation_errors")
  checklist         Json                        @default("{}") @map("checklist")
  createdAt         DateTime                    @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  version LearningObjectVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, createdAt(sort: Desc)])
  @@index([reviewerUserId])
  @@map("learning_object_reviews")
}

// ══════════════════════════════════════════════════════════════════════════════
// CONTENT INGESTION
// ══════════════════════════════════════════════════════════════════════════════

enum IngestionJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED

  @@map("ingestion_job_status")
}

enum IngestionSource {
  MANUAL      // Structured JSON via API
  FILE_CSV    // CSV file upload
  FILE_JSON   // JSON file upload
  AI_DRAFT    // AI-generated content

  @@map("ingestion_source")
}

/// Tracks bulk content ingestion jobs with row-level error reporting.
model IngestionJob {
  id                String                   @id @default(uuid()) @db.Uuid
  tenantId          String?                  @map("tenant_id") @db.Uuid
  source            IngestionSource
  status            IngestionJobStatus       @default(PENDING)
  
  // Input metadata
  inputFileUrl      String?                  @map("input_file_url")
  inputMetadata     Json                     @default("{}") @map("input_metadata")
  
  // Results
  totalRows         Int                      @default(0) @map("total_rows")
  successCount      Int                      @default(0) @map("success_count")
  errorCount        Int                      @default(0) @map("error_count")
  createdLoIds      String[]                 @default([]) @map("created_lo_ids") @db.Uuid
  
  // Error details (array of { row, field, message })
  errors            Json                     @default("[]")
  
  // Tracking
  createdByUserId   String                   @map("created_by_user_id") @db.Uuid
  startedAt         DateTime?                @map("started_at") @db.Timestamptz
  completedAt       DateTime?                @map("completed_at") @db.Timestamptz
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  @@index([tenantId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([createdByUserId])
  @@map("ingestion_jobs")
}

// ══════════════════════════════════════════════════════════════════════════════
// CONTENT PACKAGING
// ══════════════════════════════════════════════════════════════════════════════

enum ContentPackageStatus {
  PENDING
  BUILDING
  READY
  EXPIRED
  FAILED

  @@map("content_package_status")
}

enum ContentLocale {
  en
  es
  fr
  zh
  ar

  @@map("content_locale")
}

/// Content package for bulk device preloading and delta updates.
model ContentPackage {
  id                 String                @id @default(uuid()) @db.Uuid
  tenantId           String                @map("tenant_id") @db.Uuid
  gradeBands         LearningObjectGradeBand[] @map("grade_bands")
  subjects           LearningObjectSubject[]   @map("subjects")
  locales            ContentLocale[]       @default([en])
  status             ContentPackageStatus  @default(PENDING)
  manifestUrl        String?               @map("manifest_url")
  bundleUrl          String?               @map("bundle_url")
  totalItems         Int                   @default(0) @map("total_items")
  totalSizeBytes     BigInt                @default(0) @map("total_size_bytes")
  requestedAt        DateTime              @default(now()) @map("requested_at") @db.Timestamptz
  completedAt        DateTime?             @map("completed_at") @db.Timestamptz
  expiresAt          DateTime?             @map("expires_at") @db.Timestamptz
  requestedByUserId  String                @map("requested_by_user_id") @db.Uuid
  errorMessage       String?               @map("error_message")
  urlExpirationHours Int                   @default(24) @map("url_expiration_hours")
  updatedSince       DateTime?             @map("updated_since") @db.Timestamptz
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  @@index([tenantId, status])
  @@index([tenantId, requestedAt(sort: Desc)])
  @@map("content_packages")
}

/// Track content version changes for delta updates.
model ContentVersionChange {
  id                String                   @id @default(uuid()) @db.Uuid
  loVersionId       String                   @map("lo_version_id") @db.Uuid
  learningObjectId  String                   @map("learning_object_id") @db.Uuid
  tenantId          String?                  @map("tenant_id") @db.Uuid
  subject           LearningObjectSubject
  gradeBand         LearningObjectGradeBand  @map("grade_band")
  versionNumber     Int                      @map("version_number")
  changeType        String                   @map("change_type") // ADDED, UPDATED, REMOVED
  checksum          String?
  sizeBytes         BigInt?                  @map("size_bytes")
  locale            ContentLocale            @default(en)
  changedAt         DateTime                 @default(now()) @map("changed_at") @db.Timestamptz

  @@index([tenantId, changedAt(sort: Desc)])
  @@index([tenantId, subject, gradeBand, changedAt(sort: Desc)])
  @@map("content_version_changes")
}

// ══════════════════════════════════════════════════════════════════════════════
// FILE STORAGE
// ══════════════════════════════════════════════════════════════════════════════

/// File category for access control and lifecycle policies.
enum FileCategory {
  IEP_DOCUMENT        // Individualized Education Program documents
  HOMEWORK_IMAGE      // Student-uploaded homework photos
  ASSESSMENT_AUDIO    // Recorded audio responses
  ASSESSMENT_VIDEO    // Recorded video responses
  AVATAR_IMAGE        // User profile images
  EXPORTED_REPORT     // Generated PDF/CSV reports
  ATTACHMENT          // General file attachments
  OTHER               // Uncategorized files

  @@map("file_category")
}

/// Owner type for files - user or system.
enum FileOwnerType {
  USER                // Owned by a specific user
  SYSTEM              // System-generated file
  TENANT              // Tenant-level shared resource

  @@map("file_owner_type")
}

/// Virus scan status for uploaded files.
enum VirusScanStatus {
  PENDING             // Not yet scanned
  SCANNING            // Currently being scanned
  CLEAN               // No threats detected
  INFECTED            // Threat detected and file quarantined
  ERROR               // Scan failed

  @@map("virus_scan_status")
}

/// Tenant-scoped file storage with virus scanning and access control.
/// S3 key format: {tenantId}/{ownerType}/{ownerId}/{category}/{fileId}/{filename}
model StoredFile {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  ownerId           String           @map("owner_id") @db.Uuid
  ownerType         FileOwnerType    @default(USER) @map("owner_type")
  category          FileCategory     @default(OTHER)
  
  // File metadata
  filename          String
  mimeType          String           @map("mime_type")
  sizeBytes         BigInt           @map("size_bytes")
  checksum          String?          // SHA-256 hash for integrity
  
  // S3 storage location
  s3Bucket          String           @map("s3_bucket")
  s3Key             String           @map("s3_key")
  s3Region          String?          @map("s3_region")
  
  // Virus scanning
  virusScanStatus   VirusScanStatus  @default(PENDING) @map("virus_scan_status")
  virusScannedAt    DateTime?        @map("virus_scanned_at") @db.Timestamptz
  virusScanResult   Json?            @map("virus_scan_result")
  
  // Soft delete
  isDeleted         Boolean          @default(false) @map("is_deleted")
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamptz
  deletedByUserId   String?          @map("deleted_by_user_id") @db.Uuid
  
  // Extended metadata (tags, description, etc.)
  metadataJson      Json             @default("{}") @map("metadata_json")
  
  // Timestamps
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  
  // Lifecycle
  expiresAt         DateTime?        @map("expires_at") @db.Timestamptz

  // Indexes for efficient tenant-scoped queries
  @@index([tenantId, ownerId, category])
  @@index([tenantId, category, createdAt(sort: Desc)])
  @@index([tenantId, virusScanStatus])
  @@index([s3Key], type: Hash)
  @@index([tenantId, isDeleted, expiresAt])
  @@map("stored_files")
}

// ══════════════════════════════════════════════════════════════════════════════
// SOCIAL STORIES - ND-1.2
// Evidence-based visual narratives for neurodiverse learners
// ══════════════════════════════════════════════════════════════════════════════

/// Categories for social stories following Carol Gray's Social Stories framework
enum SocialStoryCategory {
  // Transition & Routine
  STARTING_LESSON          // Beginning academic activities
  ENDING_LESSON            // Completing and wrapping up activities
  CHANGING_ACTIVITY        // Moving between different tasks
  UNEXPECTED_CHANGE        // Handling schedule changes
  
  // Assessment & Testing
  TAKING_QUIZ              // Quiz and assessment situations
  TEST_TAKING              // Formal test-taking strategies
  RECEIVING_FEEDBACK       // Getting grades or corrections
  
  // Communication & Help
  ASKING_FOR_HELP          // Requesting assistance
  ASKING_FOR_BREAK         // Requesting sensory/mental breaks
  RAISING_HAND             // Classroom participation
  TALKING_TO_TEACHER       // Teacher communication
  
  // Emotional Regulation
  FEELING_FRUSTRATED       // Managing frustration
  FEELING_OVERWHELMED      // Handling sensory/cognitive overload
  FEELING_ANXIOUS          // Anxiety management
  CALMING_DOWN             // Self-regulation strategies
  CELEBRATING_SUCCESS      // Appropriate celebration
  
  // Focus & Attention
  STAYING_ON_TASK          // Maintaining focus
  IGNORING_DISTRACTIONS    // Handling interruptions
  WAITING_TURN             // Patient waiting
  
  // Technology
  USING_DEVICE             // Device handling expectations
  TECHNICAL_PROBLEM        // Handling tech issues
  
  // Social Interactions
  WORKING_WITH_PEERS       // Group work situations
  SHARING_MATERIALS        // Resource sharing
  RESPECTFUL_DISAGREEMENT  // Handling different opinions
  
  // Sensory & Physical
  SENSORY_BREAK            // Taking sensory breaks
  MOVEMENT_BREAK           // Physical activity breaks
  QUIET_SPACE              // Using calm-down areas
  
  // Safety & Emergencies
  FIRE_DRILL               // Emergency procedures
  LOCKDOWN                 // Safety procedures
  FEELING_UNSAFE           // Reporting concerns
  
  // Custom
  CUSTOM                   // User-defined category

  @@map("social_story_category")
}

/// Reading level for social story content
enum SocialStoryReadingLevel {
  PRE_READER       // Picture-only with minimal text
  EARLY_READER     // Simple sentences, large text
  DEVELOPING       // Short paragraphs
  INTERMEDIATE     // Grade-level text
  
  @@map("social_story_reading_level")
}

/// Visual style preferences for social stories
enum SocialStoryVisualStyle {
  PHOTOGRAPHS      // Real photographs
  REALISTIC_ART    // Realistic illustrations
  CARTOON          // Cartoon-style illustrations
  SIMPLE_ICONS     // Simple symbolic icons
  ABSTRACT         // Abstract/minimalist visuals
  
  @@map("social_story_visual_style")
}

/// Social story content - visual narratives for behavioral support
model SocialStory {
  id                String                    @id @default(uuid()) @db.Uuid
  tenantId          String?                   @map("tenant_id") @db.Uuid
  
  // Basic metadata
  slug              String                    @unique
  title             String
  description       String?                   @db.Text
  category          SocialStoryCategory
  
  // Content
  pages             Json                      @default("[]") // Array of StoryPage
  readingLevel      SocialStoryReadingLevel   @default(DEVELOPING) @map("reading_level")
  estimatedDuration Int                       @default(60) @map("estimated_duration") // seconds
  
  // Targeting
  minAge            Int?                      @map("min_age")
  maxAge            Int?                      @map("max_age")
  gradeBands        LearningObjectGradeBand[] @map("grade_bands")
  
  // Personalization tokens
  supportsPersonalization Boolean             @default(true) @map("supports_personalization")
  personalizationTokens   String[]            @default([]) @map("personalization_tokens")
  
  // Visual preferences
  defaultVisualStyle SocialStoryVisualStyle   @default(CARTOON) @map("default_visual_style")
  hasAudio          Boolean                   @default(false) @map("has_audio")
  hasVideo          Boolean                   @default(false) @map("has_video")
  
  // Accessibility
  accessibilityFeatures Json                  @default("{}") @map("accessibility_features")
  translations      Json                      @default("{}") // Locale -> translated content
  
  // Source & versioning
  isBuiltIn         Boolean                   @default(false) @map("is_built_in")
  sourceTemplate    String?                   @map("source_template")
  version           Int                       @default(1)
  
  // Status
  isActive          Boolean                   @default(true) @map("is_active")
  isApproved        Boolean                   @default(false) @map("is_approved")
  approvedByUserId  String?                   @map("approved_by_user_id") @db.Uuid
  approvedAt        DateTime?                 @map("approved_at") @db.Timestamptz
  
  // Tracking
  createdByUserId   String?                   @map("created_by_user_id") @db.Uuid
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz
  
  // Relations
  views             SocialStoryView[]
  assignments       SocialStoryAssignment[]

  @@unique([tenantId, slug])
  @@index([tenantId, category, isActive])
  @@index([tenantId, isActive, readingLevel])
  @@index([category, isBuiltIn, isActive])
  @@map("social_stories")
}

/// Learner preferences for social story presentation
model LearnerStoryPreferences {
  id               String                    @id @default(uuid()) @db.Uuid
  tenantId         String                    @map("tenant_id") @db.Uuid
  learnerId        String                    @map("learner_id") @db.Uuid

  // Visual preferences
  preferredVisualStyle SocialStoryVisualStyle @default(CARTOON) @map("preferred_visual_style")
  preferredReadingLevel SocialStoryReadingLevel @default(DEVELOPING) @map("preferred_reading_level")
  
  // Audio preferences
  enableAudio       Boolean                   @default(true) @map("enable_audio")
  enableTts         Boolean                   @default(true) @map("enable_tts")
  ttsVoice          String?                   @map("tts_voice")
  ttsSpeed          Float                     @default(1.0) @map("tts_speed")
  
  // Pacing preferences
  autoAdvance       Boolean                   @default(false) @map("auto_advance")
  pageDisplayTime   Int                       @default(10) @map("page_display_time") // seconds
  
  // Personalization
  characterName     String?                   @map("character_name") // Custom character name
  favoriteColor     String?                   @map("favorite_color")
  interests         String[]                  @default([])
  
  // Accessibility
  highContrast      Boolean                   @default(false) @map("high_contrast")
  largeText         Boolean                   @default(false) @map("large_text")
  reducedMotion     Boolean                   @default(false) @map("reduced_motion")
  
  // Timestamps
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  // TENANT ISOLATION: One preferences per learner per tenant
  @@unique([tenantId, learnerId])
  @@index([tenantId, learnerId])
  @@map("learner_story_preferences")
}

/// Tracks social story views for analytics and recommendations
model SocialStoryView {
  id               String    @id @default(uuid()) @db.Uuid
  storyId          String    @map("story_id") @db.Uuid
  learnerId        String    @map("learner_id") @db.Uuid
  sessionId        String?   @map("session_id") @db.Uuid
  
  // View context
  triggerType      String    @map("trigger_type") // MANUAL, AUTO, SCHEDULED, RECOMMENDED
  triggerContext   Json      @default("{}") @map("trigger_context")
  
  // Completion tracking
  pagesViewed      Int       @default(0) @map("pages_viewed")
  totalPages       Int       @map("total_pages")
  completedAt      DateTime? @map("completed_at") @db.Timestamptz
  durationSeconds  Int?      @map("duration_seconds")
  
  // Engagement metrics
  replayCount      Int       @default(0) @map("replay_count")
  audioPlayed      Boolean   @default(false) @map("audio_played")
  interactions     Json      @default("[]") // Array of interaction events
  
  // Effectiveness tracking
  preEmotionalState  String?  @map("pre_emotional_state")
  postEmotionalState String?  @map("post_emotional_state")
  helpfulnessRating  Int?     @map("helpfulness_rating") // 1-5
  
  // Timestamps
  viewedAt         DateTime  @default(now()) @map("viewed_at") @db.Timestamptz

  // Relations
  story            SocialStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([learnerId, viewedAt(sort: Desc)])
  @@index([storyId, viewedAt(sort: Desc)])
  @@index([learnerId, storyId])
  @@map("social_story_views")
}

/// Teacher/parent assigned stories for specific learners
model SocialStoryAssignment {
  id               String    @id @default(uuid()) @db.Uuid
  storyId          String    @map("story_id") @db.Uuid
  learnerId        String    @map("learner_id") @db.Uuid
  assignedByUserId String    @map("assigned_by_user_id") @db.Uuid
  
  // Assignment configuration
  priority         Int       @default(0)
  isRequired       Boolean   @default(false) @map("is_required")
  
  // Scheduling
  showBefore       String[]  @default([]) @map("show_before") // Activity types
  showAfter        String[]  @default([]) @map("show_after")  // Activity types
  scheduledTimes   Json      @default("[]") @map("scheduled_times") // Specific times
  
  // Frequency limits
  maxDailyViews    Int?      @map("max_daily_views")
  minHoursBetween  Float?    @map("min_hours_between")
  
  // Status
  isActive         Boolean   @default(true) @map("is_active")
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz
  
  // Notes
  notes            String?   @db.Text
  
  // Timestamps
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  story            SocialStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, learnerId])
  @@index([learnerId, isActive])
  @@index([learnerId, isActive, priority(sort: Desc)])
  @@map("social_story_assignments")
}

// ══════════════════════════════════════════════════════════════════════════════
// SENSORY PROFILE & CONTENT MATCHING - ND-2.1
// ══════════════════════════════════════════════════════════════════════════════

enum SensoryCategory {
  HYPOSENSITIVE
  TYPICAL
  HYPERSENSITIVE
  AVOIDING

  @@map("sensory_category")
}

enum SensoryWarningLevel {
  INFO
  WARNING
  CRITICAL

  @@map("sensory_warning_level")
}

enum VisualComplexity {
  SIMPLE
  MODERATE
  COMPLEX

  @@map("visual_complexity")
}

enum AnimationIntensity {
  NONE
  MILD
  MODERATE
  INTENSE

  @@map("animation_intensity")
}

enum CognitiveLoadLevel {
  LOW
  MEDIUM
  HIGH

  @@map("cognitive_load_level")
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("incident_severity")
}

enum IncidentStatus {
  REPORTED
  ACKNOWLEDGED
  INVESTIGATING
  RESOLVED
  DISMISSED

  @@map("incident_status")
}

/// Sensory metadata attached to content for matching with learner profiles
model ContentSensoryMetadata {
  id                       String             @id @default(uuid()) @db.Uuid
  learningObjectVersionId  String             @unique @map("learning_object_version_id") @db.Uuid
  
  // Audio characteristics
  hasAudio                 Boolean            @default(false) @map("has_audio")
  hasSuddenSounds          Boolean            @default(false) @map("has_sudden_sounds")
  hasBackgroundMusic       Boolean            @default(false) @map("has_background_music")
  audioLevel               Int                @default(5) @map("audio_level") // 1-10
  peakVolume               Int?               @map("peak_volume") // 0-100
  canMuteAudio             Boolean            @default(true) @map("can_mute_audio")
  
  // Visual characteristics
  hasFlashing              Boolean            @default(false) @map("has_flashing")
  flashFrequency           Float?             @map("flash_frequency") // Hz
  visualComplexity         VisualComplexity   @default(MODERATE) @map("visual_complexity")
  hasVibrantColors         Boolean            @default(false) @map("has_vibrant_colors")
  contrastLevel            Int                @default(5) @map("contrast_level") // 1-10
  
  // Motion characteristics
  hasAnimation             Boolean            @default(false) @map("has_animation")
  animationIntensity       AnimationIntensity @default(NONE) @map("animation_intensity")
  animationReducible       Boolean            @default(true) @map("animation_reducible")
  hasQuickMotion           Boolean            @default(false) @map("has_quick_motion")
  
  // Touch/interaction characteristics
  requiresFineTouchInput   Boolean            @default(false) @map("requires_fine_touch_input")
  hasHapticFeedback        Boolean            @default(false) @map("has_haptic_feedback")
  canDisableHaptic         Boolean            @default(true) @map("can_disable_haptic")
  
  // Cognitive characteristics
  cognitiveLoad            CognitiveLoadLevel @default(MEDIUM) @map("cognitive_load")
  hasTimeLimits            Boolean            @default(false) @map("has_time_limits")
  timeLimitsAdjustable     Boolean            @default(true) @map("time_limits_adjustable")
  requiresQuickReactions   Boolean            @default(false) @map("requires_quick_reactions")
  
  // Vestibular characteristics
  hasScrolling             Boolean            @default(false) @map("has_scrolling")
  hasParallax              Boolean            @default(false) @map("has_parallax")
  
  // Overall rating
  overallIntensityScore    Int                @default(5) @map("overall_intensity_score") // 1-10
  overallWarningLevel      SensoryWarningLevel @default(INFO) @map("overall_warning_level")
  
  // Safety warnings
  sensoryWarnings          Json               @default("[]") @map("sensory_warnings")
  
  // Suitability flags
  suitableForPhotosensitive Boolean           @default(true) @map("suitable_for_photosensitive")
  suitableForAudioSensitive Boolean           @default(true) @map("suitable_for_audio_sensitive")
  suitableForMotionSensitive Boolean          @default(true) @map("suitable_for_motion_sensitive")
  
  // Metadata
  lastAnalyzedAt           DateTime?          @map("last_analyzed_at") @db.Timestamptz
  analyzedBySystem         Boolean            @default(false) @map("analyzed_by_system")
  manuallyReviewed         Boolean            @default(false) @map("manually_reviewed")
  reviewedByUserId         String?            @map("reviewed_by_user_id") @db.Uuid
  
  // Timestamps
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  
  // Relations
  learningObjectVersion    LearningObjectVersion @relation(fields: [learningObjectVersionId], references: [id], onDelete: Cascade)
  
  @@index([overallIntensityScore])
  @@index([suitableForPhotosensitive, suitableForAudioSensitive, suitableForMotionSensitive])
  @@map("content_sensory_metadata")
}

/// Learner sensory profile for personalized content matching
model LearnerSensoryProfile {
  id                       String           @id @default(uuid()) @db.Uuid
  tenantId                 String           @map("tenant_id") @db.Uuid
  learnerId                String           @map("learner_id") @db.Uuid
  
  // Audio sensitivities (1-10, higher = more sensitive)
  audioSensitivity         Int              @default(5) @map("audio_sensitivity")
  audioCategory            SensoryCategory  @default(TYPICAL) @map("audio_category")
  prefersNoSuddenSounds    Boolean          @default(false) @map("prefers_no_sudden_sounds")
  maxVolume                Int              @default(100) @map("max_volume") // 0-100
  prefersQuietEnvironment  Boolean          @default(false) @map("prefers_quiet_environment")
  
  // Visual sensitivities
  visualSensitivity        Int              @default(5) @map("visual_sensitivity")
  visualCategory           SensoryCategory  @default(TYPICAL) @map("visual_category")
  avoidsFlashing           Boolean          @default(false) @map("avoids_flashing")
  prefersSimpleVisuals     Boolean          @default(false) @map("prefers_simple_visuals")
  preferredBrightness      Int              @default(80) @map("preferred_brightness") // 0-100
  preferredContrast        String           @default("normal") @map("preferred_contrast") // low, normal, high
  
  // Motion/vestibular sensitivities
  motionSensitivity        Int              @default(5) @map("motion_sensitivity")
  motionCategory           SensoryCategory  @default(TYPICAL) @map("motion_category")
  prefersReducedMotion     Boolean          @default(false) @map("prefers_reduced_motion")
  preferredAnimationSpeed  String           @default("normal") @map("preferred_animation_speed") // slow, normal, fast
  avoidsParallax           Boolean          @default(false) @map("avoids_parallax")
  
  // Touch/tactile sensitivities
  tactileSensitivity       Int              @default(5) @map("tactile_sensitivity")
  tactileCategory          SensoryCategory  @default(TYPICAL) @map("tactile_category")
  prefersNoHaptic          Boolean          @default(false) @map("prefers_no_haptic")
  
  // Cognitive/processing preferences
  processingSpeed          String           @default("normal") @map("processing_speed") // slow, normal, fast
  preferredPacing          String           @default("normal") @map("preferred_pacing") // slow, normal, fast
  needsExtendedTime        Boolean          @default(false) @map("needs_extended_time")
  timeExtensionFactor      Float            @default(1.0) @map("time_extension_factor") // 1.0, 1.5, 2.0
  
  // Photosensitivity
  isPhotosensitive         Boolean          @default(false) @map("is_photosensitive")
  photosensitivityLevel    Int?             @map("photosensitivity_level") // 1-10
  
  // Break preferences
  needsFrequentBreaks      Boolean          @default(false) @map("needs_frequent_breaks")
  preferredBreakFrequency  String           @default("normal") @map("preferred_break_frequency") // low, normal, high, very_high
  
  // Text preferences
  preferredTextSize        String           @default("normal") @map("preferred_text_size") // small, normal, large, very_large
  prefersDyslexiaFont      Boolean          @default(false) @map("prefers_dyslexia_font")
  
  // Environment preferences
  typicalEnvironment       String           @default("mixed") @map("typical_environment") // quiet, noisy, mixed
  
  // Profile metadata
  profileSource            String           @default("manual") @map("profile_source") // manual, assessed, imported
  lastAssessedAt           DateTime?        @map("last_assessed_at") @db.Timestamptz
  assessmentVersion        String?          @map("assessment_version")
  parentConfirmedAt        DateTime?        @map("parent_confirmed_at") @db.Timestamptz
  parentConfirmedByUserId  String?          @map("parent_confirmed_by_user_id") @db.Uuid
  
  // Notes
  notes                    String?          @db.Text
  
  // Timestamps
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  
  // Relations
  incidents                SensoryIncident[]

  // TENANT ISOLATION: One sensory profile per learner per tenant
  @@unique([tenantId, learnerId])
  @@index([tenantId])
  @@index([audioCategory, visualCategory, motionCategory])
  @@map("learner_sensory_profiles")
}

/// Tracks sensory incidents to improve matching and detect issues
model SensoryIncident {
  id                   String           @id @default(uuid()) @db.Uuid
  learnerId            String           @map("learner_id") @db.Uuid
  profileId            String?          @map("profile_id") @db.Uuid
  tenantId             String           @map("tenant_id") @db.Uuid
  
  // Content reference
  contentId            String?          @map("content_id") @db.Uuid
  contentType          String?          @map("content_type")
  contentTitle         String?          @map("content_title")
  
  // Session context
  sessionId            String?          @map("session_id") @db.Uuid
  activityId           String?          @map("activity_id") @db.Uuid
  
  // Incident details
  incidentType         String           @map("incident_type") // audio_distress, visual_distress, motion_sickness, overstimulation, etc.
  severity             IncidentSeverity @default(MEDIUM)
  status               IncidentStatus   @default(REPORTED)
  
  // What triggered it
  triggerCategory      String           @map("trigger_category") // audio, visual, motion, tactile, cognitive
  triggerDescription   String?          @map("trigger_description") @db.Text
  triggerTimestamp     DateTime?        @map("trigger_timestamp") @db.Timestamptz
  
  // User feedback
  reportedByUserId     String?          @map("reported_by_user_id") @db.Uuid
  reportedByRole       String?          @map("reported_by_role") // learner, parent, teacher
  userDescription      String?          @map("user_description") @db.Text
  
  // System detection
  systemDetected       Boolean          @default(false) @map("system_detected")
  detectionMethod      String?          @map("detection_method")
  detectionConfidence  Float?           @map("detection_confidence")
  
  // Behavioral signals that triggered detection
  behavioralSignals    Json             @default("[]") @map("behavioral_signals")
  
  // Resolution
  resolvedAt           DateTime?        @map("resolved_at") @db.Timestamptz
  resolvedByUserId     String?          @map("resolved_by_user_id") @db.Uuid
  resolutionNotes      String?          @map("resolution_notes") @db.Text
  
  // Actions taken
  actionsTaken         Json             @default("[]") @map("actions_taken")
  profileUpdated       Boolean          @default(false) @map("profile_updated")
  contentFlagged       Boolean          @default(false) @map("content_flagged")
  
  // Timestamps
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  
  // Relations
  profile              LearnerSensoryProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  
  @@index([learnerId, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([contentId])
  @@index([status, severity])
  @@index([profileId])
  @@map("sensory_incidents")
}

// ══════════════════════════════════════════════════════════════════════════════
// LESSON BUILDER MODELS
// ══════════════════════════════════════════════════════════════════════════════

enum LessonStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED

  @@map("lesson_status")
}

/// Main lesson draft entity for the lesson builder.
/// This is the working document that authors edit.
model LessonDraft {
  id                  String        @id @default(uuid()) @db.Uuid
  tenantId            String        @map("tenant_id") @db.Uuid
  learningObjectId    String?       @map("learning_object_id") @db.Uuid
  
  // Content
  title               String        @db.VarChar(500)
  description         String?       @db.Text
  blocks              Json          @default("[]")    // Array of content blocks
  settings            Json          @default("{}")    // Lesson-level settings
  
  // Status and versioning
  status              LessonStatus  @default(DRAFT)
  version             Int           @default(1)       // Current working version number
  
  // Audit
  createdById         String        @map("created_by_id") @db.Uuid
  lastModifiedById    String        @map("last_modified_by_id") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  publishedAt         DateTime?     @map("published_at") @db.Timestamptz
  archivedAt          DateTime?     @map("archived_at") @db.Timestamptz
  
  // Relations
  versions            LessonVersion[]
  learningObject      LearningObject? @relation(fields: [learningObjectId], references: [id], onDelete: SetNull)
  
  @@index([tenantId])
  @@index([learningObjectId])
  @@index([status])
  @@index([createdById])
  @@index([lastModifiedById])
  @@map("lesson_drafts")
}

/// Snapshot of a lesson at a point in time.
/// Created when lessons are published or manually saved.
model LessonVersion {
  id              String      @id @default(uuid()) @db.Uuid
  lessonDraftId   String      @map("lesson_draft_id") @db.Uuid
  
  // Version info
  versionNumber   Int         @map("version_number")
  title           String      @db.VarChar(500)
  description     String?     @db.Text
  blocks          Json        @default("[]")
  settings        Json        @default("{}")
  
  // Publishing info
  isPublished     Boolean     @default(false) @map("is_published")
  note            String?     @db.Text    // Version note/changelog
  
  // Audit
  createdById     String      @map("created_by_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  
  // Relations
  lessonDraft     LessonDraft @relation(fields: [lessonDraftId], references: [id], onDelete: Cascade)
  
  @@unique([lessonDraftId, versionNumber])
  @@index([lessonDraftId])
  @@index([isPublished])
  @@map("lesson_versions")
}

/// Reusable lesson templates for quick lesson creation.
model LessonTemplate {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String?   @map("tenant_id") @db.Uuid  // null = global template

  // Template info
  name            String    @db.VarChar(200)
  description     String?   @db.Text
  category        String    @db.VarChar(100)    // e.g., "Reading Comprehension", "Math Practice"
  subject         String?   @db.VarChar(50)     // ELA, MATH, SCIENCE, etc. (optional)
  gradeBand       String?   @map("grade_band") @db.VarChar(50)  // K_2, G3_5, etc. (optional)

  // Template content
  blocks          Json      @default("[]")      // Template blocks
  settings        Json      @default("{}")      // Default settings
  tags            String[]  @default([])        // Searchable tags

  // Display
  thumbnail       String?   @db.VarChar(500)    // Thumbnail URL
  thumbnailUrl    String?   @map("thumbnail_url") @db.VarChar(500) // Deprecated, use thumbnail
  isActive        Boolean   @default(true) @map("is_active")
  isPublic        Boolean   @default(false) @map("is_public")  // Global public template
  usageCount      Int       @default(0) @map("usage_count")

  // Audit
  createdById     String    @map("created_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([tenantId])
  @@index([category])
  @@index([subject])
  @@index([gradeBand])
  @@index([isActive])
  @@index([isPublic])
  @@map("lesson_templates")
}

// ══════════════════════════════════════════════════════════════════════════════
// INTERNATIONAL CURRICULUM ALIGNMENT - Sprint 2
// Support for multiple curriculum frameworks worldwide
// ══════════════════════════════════════════════════════════════════════════════

/// Supported curriculum frameworks worldwide
enum CurriculumFrameworkCode {
  // United States
  COMMON_CORE           // Common Core State Standards
  NGSS                  // Next Generation Science Standards
  C3                    // College, Career, and Civic Life (Social Studies)
  TEKS                  // Texas Essential Knowledge and Skills
  
  // United Kingdom
  UK_NATIONAL_CURRICULUM    // England National Curriculum
  CURRICULUM_FOR_EXCELLENCE // Scotland
  CURRICULUM_WALES          // Wales
  
  // International
  IB_PYP                // International Baccalaureate Primary Years
  IB_MYP                // International Baccalaureate Middle Years
  IB_DP                 // International Baccalaureate Diploma
  CAMBRIDGE_PRIMARY     // Cambridge Primary
  CAMBRIDGE_SECONDARY   // Cambridge Secondary
  
  // Asia Pacific
  AUSTRALIAN_CURRICULUM // Australia
  NEW_ZEALAND_CURRICULUM // New Zealand
  CBSE                  // India - Central Board of Secondary Education
  ICSE                  // India - Indian Certificate of Secondary Education
  STATE_BOARD_INDIA     // India - Various State Boards
  CHINA_NATIONAL_CURRICULUM // China
  
  // Middle East
  UAE_MOE               // UAE Ministry of Education
  ADEK                  // Abu Dhabi Education
  SAUDI_MOE             // Saudi Arabia Ministry of Education
  
  // Africa
  CAPS                  // South Africa - Curriculum and Assessment Policy
  
  // Canada
  ONTARIO_CURRICULUM    // Ontario
  ALBERTA_PROGRAM       // Alberta
  BC_CURRICULUM         // British Columbia
  QUEBEC_QEP            // Quebec Education Program
  
  @@map("curriculum_framework_code")
}

/// Subject area standardization across curricula
enum StandardizedSubject {
  // Core Academic
  MATHEMATICS
  ENGLISH_LANGUAGE_ARTS
  SCIENCE
  SOCIAL_STUDIES
  
  // Languages
  WORLD_LANGUAGES
  ENGLISH_AS_ADDITIONAL_LANGUAGE
  
  // Arts
  VISUAL_ARTS
  PERFORMING_ARTS
  MUSIC
  
  // Physical & Health
  PHYSICAL_EDUCATION
  HEALTH_EDUCATION
  
  // Technology
  COMPUTER_SCIENCE
  DIGITAL_LITERACY
  
  // Social Emotional
  SOCIAL_EMOTIONAL_LEARNING
  
  // Career & Life Skills
  CAREER_EDUCATION
  LIFE_SKILLS
  
  @@map("standardized_subject")
}

/// Curriculum framework definitions with metadata
model CurriculumFramework {
  id                    String                   @id @default(uuid()) @db.Uuid
  code                  CurriculumFrameworkCode  @unique
  name                  String                   @db.VarChar(200)
  shortName             String                   @map("short_name") @db.VarChar(50)
  description           String?                  @db.Text
  
  // Geographic scope
  countryCode           String                   @map("country_code") @db.VarChar(2)  // ISO 3166-1 alpha-2
  regionCode            String?                  @map("region_code") @db.VarChar(10)  // State/province code
  
  // Grade structure
  gradeSystem           String                   @map("grade_system") @db.VarChar(50) // e.g., "K-12", "Year 1-13"
  minGrade              Int                      @map("min_grade")
  maxGrade              Int                      @map("max_grade")
  
  // Official resources
  officialUrl           String?                  @map("official_url") @db.VarChar(500)
  standardsDocUrl       String?                  @map("standards_doc_url") @db.VarChar(500)
  
  // Status
  isActive              Boolean                  @default(true) @map("is_active")
  lastUpdatedVersion    String?                  @map("last_updated_version") @db.VarChar(50)
  effectiveDate         DateTime?                @map("effective_date") @db.Date
  
  // Timestamps
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  
  // Relations
  gradeEquivalencies    GradeEquivalency[]
  learningStandards     LearningStandard[]
  subjectMappings       SubjectMapping[]
  contentAlignments     ContentCurriculumAlignment[]
  
  @@index([countryCode])
  @@index([isActive])
  @@map("curriculum_frameworks")
}

/// Grade level equivalency mapping across curriculum frameworks
/// Enables: US Grade 5 = UK Year 6 = AU Year 5 = IN Class 5
model GradeEquivalency {
  id                    String                   @id @default(uuid()) @db.Uuid
  frameworkId           String                   @map("framework_id") @db.Uuid
  
  // Local grade representation
  gradeLevel            Int                      @map("grade_level")       // Numeric level (0=K, 1-12)
  gradeLabel            String                   @map("grade_label") @db.VarChar(50)  // Display: "Grade 5", "Year 6", "Class 5"
  gradeCode             String                   @map("grade_code") @db.VarChar(20)   // Standard code: "G5", "Y6", "CL5"
  
  // Age range for this grade
  typicalAgeMin         Int                      @map("typical_age_min")
  typicalAgeMax         Int                      @map("typical_age_max")
  
  // Standardized reference (for cross-curriculum mapping)
  standardizedLevel     Int                      @map("standardized_level")  // 0-12 universal scale
  
  // Educational stage
  educationStage        String                   @map("education_stage") @db.VarChar(50)  // PRIMARY, LOWER_SECONDARY, etc.
  
  // Description
  description           String?                  @db.Text
  
  // Timestamps
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  
  // Relations
  framework             CurriculumFramework      @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  
  @@unique([frameworkId, gradeLevel])
  @@index([standardizedLevel])
  @@index([educationStage])
  @@map("grade_equivalencies")
}

/// Subject area mapping between curriculum frameworks and standardized subjects
model SubjectMapping {
  id                    String                   @id @default(uuid()) @db.Uuid
  frameworkId           String                   @map("framework_id") @db.Uuid
  
  // Standard subject
  standardizedSubject   StandardizedSubject      @map("standardized_subject")
  
  // Local subject representation
  localSubjectCode      String                   @map("local_subject_code") @db.VarChar(50)
  localSubjectName      String                   @map("local_subject_name") @db.VarChar(200)
  localSubjectNameNative String?                 @map("local_subject_name_native") @db.VarChar(200) // In local language
  
  // Grade range this subject covers
  gradeMin              Int?                     @map("grade_min")
  gradeMax              Int?                     @map("grade_max")
  
  // Whether this is a core/required subject
  isCore                Boolean                  @default(true) @map("is_core")
  
  // Weighting/priority
  priority              Int                      @default(0)
  
  // Timestamps
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  
  // Relations
  framework             CurriculumFramework      @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  learningStandards     LearningStandard[]
  
  @@unique([frameworkId, standardizedSubject])
  @@index([standardizedSubject])
  @@map("subject_mappings")
}

/// Learning standards from curriculum frameworks
/// e.g., CCSS.MATH.CONTENT.3.OA.A.1
model LearningStandard {
  id                    String                   @id @default(uuid()) @db.Uuid
  frameworkId           String                   @map("framework_id") @db.Uuid
  subjectMappingId      String?                  @map("subject_mapping_id") @db.Uuid
  
  // Standard identification
  standardCode          String                   @map("standard_code") @db.VarChar(100)  // e.g., "CCSS.MATH.CONTENT.3.OA.A.1"
  fullCode              String                   @map("full_code") @db.VarChar(200)      // Complete hierarchical code
  
  // Hierarchy
  parentStandardId      String?                  @map("parent_standard_id") @db.Uuid
  hierarchyLevel        Int                      @map("hierarchy_level")  // 0=domain, 1=cluster, 2=standard
  hierarchyPath         String                   @map("hierarchy_path") @db.VarChar(500) // e.g., "MATH/OA/A/1"
  
  // Content
  title                 String                   @db.VarChar(500)
  description           String                   @db.Text
  keywords              String[]                 @default([])
  
  // Grade/level applicability
  gradeLevel            Int?                     @map("grade_level")
  gradeBand             String?                  @map("grade_band") @db.VarChar(20)  // e.g., "K-2", "3-5"
  
  // Cross-references
  crossCuttingConcepts  String[]                 @default([]) @map("cross_cutting_concepts")
  relatedStandardCodes  String[]                 @default([]) @map("related_standard_codes")
  
  // Bloom's taxonomy level
  cognitiveLevel        String?                  @map("cognitive_level") @db.VarChar(50)  // REMEMBER, UNDERSTAND, APPLY, etc.
  
  // Status
  isActive              Boolean                  @default(true) @map("is_active")
  
  // Timestamps
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  
  // Relations
  framework             CurriculumFramework      @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  subjectMapping        SubjectMapping?          @relation(fields: [subjectMappingId], references: [id])
  parentStandard        LearningStandard?        @relation("StandardHierarchy", fields: [parentStandardId], references: [id])
  childStandards        LearningStandard[]       @relation("StandardHierarchy")
  contentAlignments     ContentStandardAlignment[]
  standardEquivalencies StandardEquivalency[]    @relation("SourceStandard")
  equivalentTo          StandardEquivalency[]    @relation("TargetStandard")
  
  @@unique([frameworkId, standardCode])
  @@index([frameworkId, gradeLevel])
  @@index([frameworkId, hierarchyPath])
  @@index([subjectMappingId])
  @@index([parentStandardId])
  @@index([keywords], type: Gin)
  @@map("learning_standards")
}

/// Cross-curriculum standard equivalencies
/// Maps equivalent standards across different frameworks
model StandardEquivalency {
  id                    String                   @id @default(uuid()) @db.Uuid
  
  // Source standard
  sourceStandardId      String                   @map("source_standard_id") @db.Uuid
  
  // Target standard (equivalent in another framework)
  targetStandardId      String                   @map("target_standard_id") @db.Uuid
  
  // Relationship type
  equivalencyType       String                   @map("equivalency_type") @db.VarChar(50)
  // EXACT: Same learning objective
  // PARTIAL: Overlapping but not complete
  // BROADER: Source is more specific than target
  // NARROWER: Source is more general than target
  // RELATED: Conceptually related but different
  
  // Confidence/quality score (0-1)
  confidenceScore       Decimal                  @map("confidence_score") @db.Decimal(3, 2)
  
  // Mapping notes
  notes                 String?                  @db.Text
  
  // How this mapping was created
  mappingSource         String                   @map("mapping_source") @db.VarChar(50)  // MANUAL, AI_GENERATED, OFFICIAL
  verifiedBy            String?                  @map("verified_by") @db.Uuid  // User who verified
  verifiedAt            DateTime?                @map("verified_at") @db.Timestamptz
  
  // Timestamps
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  
  // Relations
  sourceStandard        LearningStandard         @relation("SourceStandard", fields: [sourceStandardId], references: [id], onDelete: Cascade)
  targetStandard        LearningStandard         @relation("TargetStandard", fields: [targetStandardId], references: [id], onDelete: Cascade)
  
  @@unique([sourceStandardId, targetStandardId])
  @@index([sourceStandardId])
  @@index([targetStandardId])
  @@index([equivalencyType])
  @@map("standard_equivalencies")
}

/// Content alignment to curriculum frameworks
/// Links learning objects to specific curriculum frameworks
model ContentCurriculumAlignment {
  id                    String                   @id @default(uuid()) @db.Uuid
  
  // Content reference
  learningObjectId      String                   @map("learning_object_id") @db.Uuid
  learningObjectVersionId String?                @map("learning_object_version_id") @db.Uuid
  
  // Curriculum reference
  frameworkId           String                   @map("framework_id") @db.Uuid
  
  // Grade alignment
  alignedGradeLevel     Int?                     @map("aligned_grade_level")
  alignedGradeBand      String?                  @map("aligned_grade_band") @db.VarChar(20)
  
  // Alignment quality
  alignmentScore        Decimal?                 @map("alignment_score") @db.Decimal(3, 2)  // 0-1 quality score
  isPrimary             Boolean                  @default(false) @map("is_primary")  // Primary framework for this content
  
  // Status
  isActive              Boolean                  @default(true) @map("is_active")
  
  // Audit
  alignedBy             String?                  @map("aligned_by") @db.Uuid  // User who created alignment
  verifiedBy            String?                  @map("verified_by") @db.Uuid  // User who verified
  verifiedAt            DateTime?                @map("verified_at") @db.Timestamptz
  
  // Timestamps
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  
  // Relations
  framework             CurriculumFramework      @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  standardAlignments    ContentStandardAlignment[]
  
  @@unique([learningObjectId, frameworkId])
  @@index([learningObjectId])
  @@index([frameworkId])
  @@index([alignedGradeLevel])
  @@map("content_curriculum_alignments")
}

/// Specific standard alignments for content
/// Links content to individual learning standards
model ContentStandardAlignment {
  id                    String                   @id @default(uuid()) @db.Uuid
  
  // Parent alignment
  curriculumAlignmentId String                   @map("curriculum_alignment_id") @db.Uuid
  
  // Standard reference
  standardId            String                   @map("standard_id") @db.Uuid
  
  // Alignment details
  alignmentStrength     String                   @map("alignment_strength") @db.VarChar(20)
  // PRIMARY: Main standard addressed
  // SUPPORTING: Secondary/supporting standard
  // PREREQUISITE: Required prior knowledge
  // EXTENSION: Goes beyond the standard
  
  // Coverage estimate (what % of standard this content covers)
  coveragePercent       Int?                     @map("coverage_percent")
  
  // Notes on alignment
  alignmentNotes        String?                  @map("alignment_notes") @db.Text
  
  // Timestamps
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  
  // Relations
  curriculumAlignment   ContentCurriculumAlignment @relation(fields: [curriculumAlignmentId], references: [id], onDelete: Cascade)
  standard              LearningStandard         @relation(fields: [standardId], references: [id], onDelete: Cascade)
  
  @@unique([curriculumAlignmentId, standardId])
  @@index([standardId])
  @@map("content_standard_alignments")
}

