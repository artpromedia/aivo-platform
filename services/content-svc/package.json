{
  "name": "@aivo/content-svc",
  "version": "0.0.1",
  "description": "Learning Object content management service",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "(prisma generate || true) && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src test --ext .ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aivo/events": "workspace:^",
    "@aivo/ts-api-utils": "workspace:*",
    "@aivo/ts-rbac": "workspace:*",
    "@aivo/ts-shared": "workspace:*",
    "@aivo/ts-storage": "workspace:*",
    "@aivo/ts-types": "workspace:*",
    "@aivo/ts-utils": "workspace:*",
    "@fastify/cors": "^8.5.0",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.22.0",
    "@types/pg": "^8.16.0",
    "fast-xml-parser": "^4.5.0",
    "fastify": "^4.28.1",
    "jszip": "^3.10.1",
    "pg": "^8.17.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
