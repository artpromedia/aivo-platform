  @@unique([roundId, tenantId])
  @@index([roundId])
  @@index([tenantId])
  @@map("federated_contributions")
}

// =============================================================================
// Federated Models
// =============================================================================

model FederatedModel {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
