// =============================================================================
// Federated Rounds
// =============================================================================

model FederatedRound {
  roundId              String    @id @map("round_id") @db.Uuid
  modelType            String    @map("model_type")
  status               String    @default("initializing") // initializing, collecting, aggregating, distributing, completed, failed
  config               Json
  eligibleTenants      String[]  @default([]) @map("eligible_tenants") @db.Uuid
  participatingTenants String[]  @default([]) @map("participating_tenants") @db.Uuid
  contributionCount    Int       @default(0) @map("contribution_count")
  distributedCount     Int       @default(0) @map("distributed_count")
  errors               Json      @default("[]")
  startedAt            DateTime  @default(now()) @map("started_at") @db.Timestamptz
  collectionDeadline   DateTime? @map("collection_deadline") @db.Timestamptz
  completedAt          DateTime? @map("completed_at") @db.Timestamptz

  contributions   FederatedContribution[]
  federatedModels FederatedModel[]
  tenantModels    TenantModel[]
  pendingUpdates  PendingModelUpdate[]

  @@index([status])
  @@index([modelType])
  @@index([startedAt(sort: Desc)])
  @@map("federated_rounds")
}

// =============================================================================
// Federated Contributions
// =============================================================================

model FederatedContribution {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roundId        String   @map("round_id") @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  gradients      Json
  sampleWeight   Int      @map("sample_weight")
