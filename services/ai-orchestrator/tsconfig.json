{
  "extends": "../../tsconfig.compat.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": false,
    "typeRoots": ["./src/types", "./node_modules/@types"]
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*", "eval/**/*"],
  "exclude": ["dist", "node_modules", "build"]
}
