PORT=4010
AI_PROVIDER=MOCK
AI_MOCK_SEED=demo-seed
INTERNAL_API_KEY=dev-internal-key
DATABASE_URL=postgresql://user:password@localhost:5432/aivo
AGENT_CONFIG_CACHE_TTL_MS=30000

# ======================================
# LLM Provider Configuration
# ======================================

# Ollama Configuration (Local LLM - recommended for development)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_DEFAULT_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=120000

# Google Gemini Configuration (PRIMARY for Production)
GOOGLE_GEMINI_API_KEY=AIza...
GOOGLE_PROJECT_ID=your-project-id
GOOGLE_LOCATION=us-central1
GOOGLE_RATE_LIMIT_TPM=100000
GOOGLE_RATE_LIMIT_RPM=500

# OpenAI Configuration (Fallback 1)
OPENAI_API_KEY=sk-...
OPENAI_ORGANIZATION_ID=org-...
OPENAI_RATE_LIMIT_TPM=150000
OPENAI_RATE_LIMIT_RPM=500

# Anthropic Configuration (Fallback 2)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_RATE_LIMIT_TPM=100000
ANTHROPIC_RATE_LIMIT_RPM=500

# LLM Orchestrator Configuration
# ────────────────────────────────────────
# For LOCAL DEVELOPMENT: ollama (runs on local machine, no API costs)
# For PRODUCTION: google (Google Gemini AI as primary, OpenAI/Anthropic as fallbacks)
# ────────────────────────────────────────
# LOCAL DEV:
LLM_PRIMARY_PROVIDER=ollama
LLM_FALLBACK_ORDER=ollama

# PRODUCTION (uncomment below, comment above):
# LLM_PRIMARY_PROVIDER=google
# LLM_FALLBACK_ORDER=google,openai,anthropic

# LLM Cache Configuration
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=3600
LLM_CACHE_REDIS_URL=redis://localhost:6379/1

# Safety Configuration
SAFETY_STRICT_MODE=true
SAFETY_LOG_BLOCKED_CONTENT=true
SAFETY_ENABLED=true
SAFETY_MINIMUM_SCORE=0.6
AUDIT_SVC_URL=http://audit-svc:4050
NATS_URL=nats://localhost:4222
REDIS_URL=redis://localhost:6379
