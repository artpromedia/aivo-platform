{{!-- Caregiver Email Verification Template --}}
{{!-- Sent when a caregiver registers and needs to verify their email --}}

{{#> layouts/base}}

<div style="text-align: center; margin-bottom: 24px;">
  <div style="width: 64px; height: 64px; background-color: #dbeafe; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin: 0 auto;">
    <span style="font-size: 28px;">✉️</span>
  </div>
</div>

<h1 style="text-align: center;">Verify Your Email Address</h1>

<p style="text-align: center; font-size: 18px;">
  Hi {{firstName}},
</p>

<p style="text-align: center; color: #52525b;">
  Thank you for registering as a caregiver with AIVO Learning. To continue with your registration, please verify your email address using the code below.
</p>

<div style="background-color: #f4f4f5; border-radius: 12px; padding: 32px; margin: 32px 0; text-align: center;">
  <p style="margin: 0 0 12px 0; font-size: 14px; color: #71717a; text-transform: uppercase; letter-spacing: 1px;">
    Your Verification Code
  </p>
  <p style="margin: 0; font-size: 40px; font-weight: 700; letter-spacing: 8px; color: #18181b; font-family: 'Courier New', monospace;">
    {{verificationCode}}
  </p>
  <p style="margin: 16px 0 0 0; font-size: 14px; color: #f59e0b;">
    ⏱️ This code expires in {{expiryHours}} hours
  </p>
</div>

<div style="background-color: #eff6ff; border-radius: 8px; padding: 16px; margin: 24px 0;">
  <p style="margin: 0; color: #1e40af; font-size: 14px;">
    <strong>What happens next?</strong><br>
    After verifying your email, you'll be able to add your learner(s) and complete the registration process.
  </p>
</div>

<p style="text-align: center; color: #71717a; font-size: 14px; margin-top: 24px;">
  Enter this code on the registration page to continue.
</p>

<hr style="border: none; border-top: 1px solid #e4e4e7; margin: 24px 0;">

<div style="background-color: #fef2f2; border-radius: 8px; padding: 16px; margin: 24px 0;">
  <p style="margin: 0; color: #991b1b; font-size: 13px;">
    <strong>🔒 Security Notice:</strong> If you didn't request this verification code, please ignore this email. Someone may have entered your email address by mistake.
  </p>
</div>

<p style="text-align: center; color: #71717a; font-size: 13px;">
  Need help? Visit our <a href="{{supportUrl}}" style="color: {{brandColor}};">Support Center</a>
</p>

{{/layouts/base}}
