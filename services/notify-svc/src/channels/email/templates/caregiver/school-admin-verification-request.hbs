{{!-- School Admin Verification Request Template --}}
{{!-- Sent to school administrators when a new caregiver link request needs approval --}}

{{#> layouts/base}}

<div style="text-align: center; margin-bottom: 24px;">
  <div style="width: 64px; height: 64px; background-color: #dbeafe; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin: 0 auto;">
    <span style="font-size: 28px;">🔔</span>
  </div>
</div>

<h1 style="text-align: center;">New Caregiver Verification Request</h1>

<p style="text-align: center; color: #52525b;">
  A caregiver has requested to link their account with a learner at your school. Please review and verify this request.
</p>

<div style="background-color: #f4f4f5; border-radius: 8px; padding: 24px; margin: 24px 0;">
  <h2 style="margin: 0 0 16px 0; font-size: 16px; color: #18181b; border-bottom: 1px solid #e4e4e7; padding-bottom: 12px;">
    Caregiver Information
  </h2>

  <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="font-size: 14px;">
    <tr>
      <td style="padding: 8px 0; color: #71717a; width: 140px;">Name:</td>
      <td style="padding: 8px 0; color: #18181b; font-weight: 500;">{{caregiverName}}</td>
    </tr>
    <tr>
      <td style="padding: 8px 0; color: #71717a;">Email:</td>
      <td style="padding: 8px 0; color: #18181b;">{{caregiverEmail}}</td>
    </tr>
    <tr>
      <td style="padding: 8px 0; color: #71717a;">Relationship:</td>
      <td style="padding: 8px 0; color: #18181b;">{{relationship}}</td>
    </tr>
    <tr>
      <td style="padding: 8px 0; color: #71717a;">Submitted:</td>
      <td style="padding: 8px 0; color: #18181b;">{{formatDate submittedAt 'long'}}</td>
    </tr>
  </table>
</div>

<div style="background-color: #eff6ff; border-radius: 8px; padding: 24px; margin: 24px 0;">
  <h2 style="margin: 0 0 16px 0; font-size: 16px; color: #1e40af; border-bottom: 1px solid #bfdbfe; padding-bottom: 12px;">
    Learner Information Provided
  </h2>

  <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="font-size: 14px;">
    {{#if learnerEmail}}
    <tr>
      <td style="padding: 8px 0; color: #3b82f6; width: 140px;">Email:</td>
      <td style="padding: 8px 0; color: #1e40af;">{{learnerEmail}}</td>
    </tr>
    {{/if}}
    {{#if studentId}}
    <tr>
      <td style="padding: 8px 0; color: #3b82f6;">Student ID:</td>
      <td style="padding: 8px 0; color: #1e40af;">{{studentId}}</td>
    </tr>
    {{/if}}
    {{#if learnerFirstName}}
    <tr>
      <td style="padding: 8px 0; color: #3b82f6;">First Name:</td>
      <td style="padding: 8px 0; color: #1e40af;">{{learnerFirstName}}</td>
    </tr>
    {{/if}}
    {{#if learnerLastName}}
    <tr>
      <td style="padding: 8px 0; color: #3b82f6;">Last Name:</td>
      <td style="padding: 8px 0; color: #1e40af;">{{learnerLastName}}</td>
    </tr>
    {{/if}}
    {{#if learnerDateOfBirth}}
    <tr>
      <td style="padding: 8px 0; color: #3b82f6;">Date of Birth:</td>
      <td style="padding: 8px 0; color: #1e40af;">{{formatDate learnerDateOfBirth 'short'}}</td>
    </tr>
    {{/if}}
  </table>
</div>

{{#if matchedLearner}}
<div style="background-color: #d1fae5; border-radius: 8px; padding: 16px; margin: 24px 0;">
  <p style="margin: 0; color: #065f46; font-size: 14px;">
    <strong>✓ Potential Match Found:</strong> {{matchedLearnerName}}{{#if matchedLearnerGrade}} (Grade {{matchedLearnerGrade}}){{/if}}
  </p>
</div>
{{else}}
<div style="background-color: #fef3c7; border-radius: 8px; padding: 16px; margin: 24px 0;">
  <p style="margin: 0; color: #92400e; font-size: 14px;">
    <strong>⚠️ No automatic match found.</strong> Manual verification required.
  </p>
</div>
{{/if}}

<div style="text-align: center; margin: 32px 0;">
  <a href="{{reviewUrl}}" class="btn-primary" style="background-color: {{brandColor}}; color: #ffffff; text-decoration: none; padding: 14px 32px; border-radius: 8px; font-weight: 600; display: inline-block;">
    Review Request
  </a>
</div>

<div style="background-color: #fef2f2; border-radius: 8px; padding: 16px; margin: 24px 0;">
  <p style="margin: 0; color: #991b1b; font-size: 13px;">
    <strong>🔒 Important:</strong> Please verify the caregiver's relationship with the learner before approving. You may want to cross-reference with your student records or contact the family directly.
  </p>
</div>

<hr style="border: none; border-top: 1px solid #e4e4e7; margin: 24px 0;">

<p style="text-align: center; color: #71717a; font-size: 14px;">
  You can manage all pending requests in the <a href="{{adminDashboardUrl}}" style="color: {{brandColor}};">Admin Dashboard</a>
</p>

{{/layouts/base}}
