{{!-- Trial Ending Email Template --}}
{{!-- Sent as trial/pilot approaches end (14 days, 7 days, 48 hours) --}}

{{#> layouts/base}}

<div style="text-align: center; margin-bottom: 24px;">
  <div style="width: 64px; height: 64px; background-color: #dbeafe; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin: 0 auto;">
    <span style="font-size: 28px;">📅</span>
  </div>
</div>

<h1 style="text-align: center; color: #1e40af;">Your Trial Ends {{#if daysRemainingLabel}}{{daysRemainingLabel}}{{else}}Soon{{/if}}</h1>

<p style="text-align: center; font-size: 18px;">
  Hi {{recipientName}},
</p>

<p style="text-align: center; color: #52525b;">
  {{#if daysRemaining}}
    {{#if (gt daysRemaining 2)}}
      Your free trial ends in <strong>{{daysRemaining}} days</strong> ({{trialEndDate}}).
    {{else}}
      Your free trial ends in less than <strong>48 hours</strong> ({{trialEndDate}}).
    {{/if}}
  {{else}}
    Your free trial is ending soon.
  {{/if}}
  Don't lose access to your content and progress!
</p>

<!-- Trial Status -->
<div style="background-color: #eff6ff; border: 1px solid #bfdbfe; border-radius: 12px; padding: 24px; margin: 24px 0;">
  <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
    <tr>
      <td>
        <p style="margin: 0; font-size: 14px; color: #1e40af;">Trial Ends</p>
        <p style="margin: 4px 0 0 0; font-size: 20px; font-weight: 700; color: #1e40af;">{{trialEndDate}}</p>
      </td>
      {{#if chargeAmount}}
      <td style="text-align: right;">
        <p style="margin: 0; font-size: 14px; color: #1e40af;">Plan Price</p>
        <p style="margin: 4px 0 0 0; font-size: 20px; font-weight: 700; color: #1e40af;">{{chargeAmount}}</p>
      </td>
      {{/if}}
    </tr>
  </table>
</div>

{{#unless hasPaymentMethod}}
<!-- No payment method warning -->
<div style="background-color: #fef3c7; border-left: 4px solid #f59e0b; border-radius: 0 8px 8px 0; padding: 16px; margin: 24px 0;">
  <p style="margin: 0; color: #92400e;">
    <strong>⚠️ No payment method on file</strong><br>
    Add a payment method before your trial ends to continue using all features without interruption.
  </p>
</div>
{{/unless}}

{{#if hasPaymentMethod}}
<!-- Payment method on file -->
<div style="background-color: #f0fdf4; border-radius: 8px; padding: 16px; margin: 24px 0;">
  <p style="margin: 0; color: #166534;">
    ✅ <strong>Payment method on file</strong> — Your subscription will activate automatically when the trial ends.
    {{#if chargeAmount}}You'll be charged <strong>{{chargeAmount}}</strong>.{{/if}}
  </p>
</div>
{{/if}}

<!-- What you'll keep -->
<div style="background-color: #f8fafc; border-radius: 8px; padding: 20px; margin: 24px 0;">
  <h2 style="margin: 0 0 12px 0; color: #18181b;">What you'll keep with a subscription:</h2>
  <ul style="margin: 0; padding-left: 20px; color: #52525b;">
    <li style="padding: 6px 0;">All your content and learning progress</li>
    <li style="padding: 6px 0;">Access to all platform features</li>
    <li style="padding: 6px 0;">Priority support</li>
  </ul>
</div>

<!-- CTA -->
<div style="text-align: center; margin: 32px 0;">
  <a href="{{billingPortalUrl}}" class="btn-primary" style="background-color: {{brandColor}}; color: #ffffff; text-decoration: none; padding: 14px 32px; border-radius: 8px; font-weight: 600; display: inline-block;">
    {{#if hasPaymentMethod}}Manage Subscription{{else}}Add Payment Method{{/if}}
  </a>
</div>

<hr style="border: none; border-top: 1px solid #e4e4e7; margin: 32px 0;">

<p style="text-align: center; color: #71717a; font-size: 14px;">
  Questions about pricing or plans?
  <a href="mailto:{{supportEmail}}" style="color: {{brandColor}};">{{supportEmail}}</a>
</p>

{{/layouts/base}}
