{{!-- Limited Mode Activated Email Template --}}
{{!-- Sent on day 7 of dunning — account restricted --}}

{{#> layouts/base}}

<div style="text-align: center; margin-bottom: 24px;">
  <div style="width: 64px; height: 64px; background-color: #fee2e2; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin: 0 auto;">
    <span style="font-size: 28px;">🔒</span>
  </div>
</div>

<h1 style="text-align: center; color: #dc2626;">Service Limited: Payment Required</h1>

<p style="text-align: center; font-size: 18px;">
  Hi {{recipientName}},
</p>

<p style="text-align: center; color: #52525b;">
  Your subscription is now in limited mode due to an unpaid balance. Some features have been restricted until payment is resolved.
</p>

<!-- Payment Details -->
<div style="background-color: #fef2f2; border: 1px solid #fecaca; border-radius: 12px; padding: 24px; margin: 24px 0;">
  <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
    <tr>
      <td>
        <p style="margin: 0; font-size: 14px; color: #991b1b;">Unpaid Balance</p>
        <p style="margin: 4px 0 0 0; font-size: 24px; font-weight: 700; color: #dc2626;">{{amount}}</p>
      </td>
      <td style="text-align: right;">
        <p style="margin: 0; font-size: 14px; color: #991b1b;">Plan</p>
        <p style="margin: 4px 0 0 0; font-weight: 500; color: #dc2626;">{{planName}}</p>
      </td>
    </tr>
  </table>
</div>

<!-- What's restricted -->
<div style="background-color: #fef2f2; border-left: 4px solid #dc2626; border-radius: 0 8px 8px 0; padding: 16px; margin: 24px 0;">
  <p style="margin: 0 0 12px 0; font-weight: 600; color: #991b1b;">What's affected:</p>
  <ul style="margin: 0; padding-left: 20px; color: #991b1b; font-size: 14px;">
    <li style="padding: 4px 0;">New content creation is disabled</li>
    <li style="padding: 4px 0;">Advanced features are restricted</li>
    <li style="padding: 4px 0;">Existing content remains accessible in read-only mode</li>
  </ul>
</div>

<!-- Restore notice -->
<div style="background-color: #f0fdf4; border-radius: 8px; padding: 16px; margin: 24px 0; text-align: center;">
  <p style="margin: 0; color: #166534;">
    <strong>✨ Restore full access instantly</strong><br>
    Update your payment method and your account will be fully restored right away.
  </p>
</div>

<!-- CTA -->
<div style="text-align: center; margin: 32px 0;">
  <a href="{{billingPortalUrl}}" class="btn-primary" style="background-color: #dc2626; color: #ffffff; text-decoration: none; padding: 14px 32px; border-radius: 8px; font-weight: 600; display: inline-block;">
    Resolve Payment Now
  </a>
</div>

<hr style="border: none; border-top: 1px solid #e4e4e7; margin: 32px 0;">

<p style="text-align: center; color: #71717a; font-size: 14px;">
  Need help? Contact us at
  <a href="mailto:{{supportEmail}}" style="color: {{brandColor}};">{{supportEmail}}</a>
</p>

{{/layouts/base}}
