{{!-- Annual FERPA Notification Email Template --}}
{{!-- Sent annually to parents/guardians per 34 CFR § 99.7 --}}
{{!-- Required: Notify parents of their rights under FERPA each school year --}}

{{#> layouts/base coppaNotice=true}}

<h1 style="color: {{brandColor}}; font-size: 24px; margin-bottom: 8px;">
  {{t 'ferpa_annual.title'}}
</h1>

<p style="color: #71717a; font-size: 14px; margin-bottom: 24px;">
  {{t 'ferpa_annual.school_year' schoolYear=schoolYear}}
</p>

<p>{{t 'ferpa_annual.greeting' parentName=parentName}}</p>

<p>{{t 'ferpa_annual.intro' districtName=districtName}}</p>

<!-- FERPA Rights Overview -->
<div style="background-color: #eff6ff; border: 1px solid #bfdbfe; border-radius: 12px; padding: 24px; margin: 24px 0;">
  <h2 style="margin: 0 0 16px 0; color: #1e40af; font-size: 18px;">
    {{t 'ferpa_annual.rights_heading'}}
  </h2>
  <p style="margin: 0 0 16px 0; color: #1e3a5f; font-size: 14px;">
    {{t 'ferpa_annual.rights_intro'}}
  </p>
</div>

<!-- Right 1: Inspect & Review -->
<div style="margin: 20px 0; padding: 20px; background-color: #f8fafc; border-radius: 8px; border-left: 4px solid {{brandColor}};">
  <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
    <tr>
      <td width="48" style="vertical-align: top;">
        <div style="width: 40px; height: 40px; background-color: {{brandColor}}20; border-radius: 50%; text-align: center; line-height: 40px; font-size: 20px;">
          &#128269;
        </div>
      </td>
      <td style="padding-left: 12px;">
        <h3 style="margin: 0 0 8px 0; color: #18181b; font-size: 16px;">
          {{t 'ferpa_annual.right_inspect_title'}}
        </h3>
        <p style="margin: 0; color: #52525b; font-size: 14px; line-height: 1.6;">
          {{t 'ferpa_annual.right_inspect_desc'}}
        </p>
      </td>
    </tr>
  </table>
</div>

<!-- Right 2: Request Amendment -->
<div style="margin: 20px 0; padding: 20px; background-color: #f8fafc; border-radius: 8px; border-left: 4px solid {{brandColor}};">
  <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
    <tr>
      <td width="48" style="vertical-align: top;">
        <div style="width: 40px; height: 40px; background-color: {{brandColor}}20; border-radius: 50%; text-align: center; line-height: 40px; font-size: 20px;">
          &#9998;
        </div>
      </td>
      <td style="padding-left: 12px;">
        <h3 style="margin: 0 0 8px 0; color: #18181b; font-size: 16px;">
          {{t 'ferpa_annual.right_amend_title'}}
        </h3>
        <p style="margin: 0; color: #52525b; font-size: 14px; line-height: 1.6;">
          {{t 'ferpa_annual.right_amend_desc'}}
        </p>
      </td>
    </tr>
  </table>
</div>

<!-- Right 3: Consent to Disclosure -->
<div style="margin: 20px 0; padding: 20px; background-color: #f8fafc; border-radius: 8px; border-left: 4px solid {{brandColor}};">
  <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
    <tr>
      <td width="48" style="vertical-align: top;">
        <div style="width: 40px; height: 40px; background-color: {{brandColor}}20; border-radius: 50%; text-align: center; line-height: 40px; font-size: 20px;">
          &#128274;
        </div>
      </td>
      <td style="padding-left: 12px;">
        <h3 style="margin: 0 0 8px 0; color: #18181b; font-size: 16px;">
          {{t 'ferpa_annual.right_consent_title'}}
        </h3>
        <p style="margin: 0; color: #52525b; font-size: 14px; line-height: 1.6;">
          {{t 'ferpa_annual.right_consent_desc'}}
        </p>
      </td>
    </tr>
  </table>
</div>

<!-- Right 4: File a Complaint -->
<div style="margin: 20px 0; padding: 20px; background-color: #f8fafc; border-radius: 8px; border-left: 4px solid {{brandColor}};">
  <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
    <tr>
      <td width="48" style="vertical-align: top;">
        <div style="width: 40px; height: 40px; background-color: {{brandColor}}20; border-radius: 50%; text-align: center; line-height: 40px; font-size: 20px;">
          &#128221;
        </div>
      </td>
      <td style="padding-left: 12px;">
        <h3 style="margin: 0 0 8px 0; color: #18181b; font-size: 16px;">
          {{t 'ferpa_annual.right_complaint_title'}}
        </h3>
        <p style="margin: 0; color: #52525b; font-size: 14px; line-height: 1.6;">
          {{t 'ferpa_annual.right_complaint_desc'}}
        </p>
        <div style="margin-top: 12px; padding: 12px; background-color: #f0f9ff; border-radius: 6px;">
          <p style="margin: 0; color: #1e40af; font-size: 13px; font-weight: 600;">
            Family Policy Compliance Office
          </p>
          <p style="margin: 4px 0 0 0; color: #3b82f6; font-size: 13px;">
            U.S. Department of Education<br/>
            400 Maryland Avenue, SW<br/>
            Washington, DC 20202
          </p>
        </div>
      </td>
    </tr>
  </table>
</div>

<!-- Directory Information Notice -->
<div style="margin: 24px 0; padding: 20px; background-color: #fefce8; border: 1px solid #fde68a; border-radius: 8px;">
  <h3 style="margin: 0 0 12px 0; color: #92400e; font-size: 16px;">
    {{t 'ferpa_annual.directory_info_title'}}
  </h3>
  <p style="margin: 0 0 12px 0; color: #78350f; font-size: 14px; line-height: 1.6;">
    {{t 'ferpa_annual.directory_info_desc'}}
  </p>
  <p style="margin: 0; color: #78350f; font-size: 13px;">
    {{t 'ferpa_annual.directory_info_optout' optOutDeadline=optOutDeadline}}
  </p>
</div>

<!-- AIVO Platform-Specific Notice -->
<div style="margin: 24px 0; padding: 20px; background-color: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px;">
  <h3 style="margin: 0 0 12px 0; color: #166534; font-size: 16px;">
    {{t 'ferpa_annual.platform_notice_title'}}
  </h3>
  <p style="margin: 0 0 8px 0; color: #15803d; font-size: 14px; line-height: 1.6;">
    {{t 'ferpa_annual.platform_notice_desc' districtName=districtName}}
  </p>
  <ul style="margin: 8px 0; padding-left: 20px; color: #15803d; font-size: 14px; line-height: 1.8;">
    <li>{{t 'ferpa_annual.platform_data_1'}}</li>
    <li>{{t 'ferpa_annual.platform_data_2'}}</li>
    <li>{{t 'ferpa_annual.platform_data_3'}}</li>
    <li>{{t 'ferpa_annual.platform_data_4'}}</li>
  </ul>
  <p style="margin: 8px 0 0 0; color: #15803d; font-size: 14px;">
    {{t 'ferpa_annual.platform_privacy_link'}}
  </p>
</div>

<!-- Action Buttons -->
<div style="margin: 32px 0; text-align: center;">
  <a href="{{privacySettingsUrl}}" style="display: inline-block; background-color: {{brandColor}}; color: #ffffff; text-decoration: none; padding: 14px 28px; border-radius: 8px; font-weight: 600; font-size: 15px; margin: 0 8px 12px;">
    {{t 'ferpa_annual.review_privacy_settings'}}
  </a>
  <a href="{{dataRequestUrl}}" style="display: inline-block; background-color: #ffffff; color: {{brandColor}}; text-decoration: none; padding: 14px 28px; border-radius: 8px; font-weight: 600; font-size: 15px; border: 2px solid {{brandColor}}; margin: 0 8px 12px;">
    {{t 'ferpa_annual.request_records'}}
  </a>
</div>

<!-- Contact Info -->
<div style="margin: 24px 0; padding: 20px; background-color: #f8fafc; border-radius: 8px; text-align: center;">
  <p style="margin: 0 0 8px 0; color: #52525b; font-size: 14px;">
    {{t 'ferpa_annual.questions_contact'}}
  </p>
  <p style="margin: 0; color: #18181b; font-size: 14px; font-weight: 600;">
    {{districtContactName}} — {{districtContactEmail}}
  </p>
</div>

<p style="color: #a1a1aa; font-size: 12px; margin-top: 32px; text-align: center; line-height: 1.6;">
  {{t 'ferpa_annual.legal_footer'}}
</p>

{{/layouts/base}}
