{
  "extends": "../../tsconfig.compat.json",
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*", "generated/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "src/__tests__/**",
    "src/**/__tests__/**",
    "src/controllers/**",
    "src/services/push-notification.service.ts",
    "src/channels/email/analytics.service.ts",
    "src/channels/email/suppression-sync.service.ts"
  ]
}
