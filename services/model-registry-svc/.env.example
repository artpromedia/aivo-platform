# ══════════════════════════════════════════════════════════════════════════════
# AIVO Model Registry Service - Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════

# Server
PORT=4051
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://localhost:5432/aivo_model_registry

# JWT Authentication
JWT_PUBLIC_KEY_PATH=../../.keys/jwt-public.pem
INTERNAL_API_KEY=dev-internal-key

# Redis
REDIS_URL=redis://localhost:6379

# NATS
NATS_URL=nats://localhost:4222
NATS_ENABLED=true

# S3 Storage for Model Artifacts
S3_BUCKET=aivo-model-registry
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=http://localhost:9000  # For MinIO/LocalStack

# Registry Settings
MAX_ARTIFACT_SIZE_BYTES=10737418240
PRESIGNED_URL_EXPIRES_SEC=3600

# Service URLs
AUTH_SVC_URL=http://auth-svc:4001
AUDIT_SVC_URL=http://audit-svc:4050
