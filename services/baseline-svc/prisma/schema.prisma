generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum BaselineDomain {
  ELA
  MATH
  SCIENCE
  SPEECH
  SEL

  @@map("baseline_domain")
}

enum GradeBand {
  K5
  G6_8
  G9_12

  @@map("grade_band")
}

enum BaselineStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  RETEST_ALLOWED
  FINAL_ACCEPTED

  @@map("baseline_status")
}

enum RetestReasonType {
  DISTRACTED
  ANXIETY
  TECHNICAL_ISSUE
  OTHER

  @@map("retest_reason_type")
}

// ── Models ───────────────────────────────────────────────────────────────────

model BaselineProfile {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @db.Uuid
  learnerId      String         @db.Uuid
  gradeBand      GradeBand      @map("grade_band")
  status         BaselineStatus @default(NOT_STARTED)
  attemptCount   Int            @default(0) @map("attempt_count") @db.SmallInt
  finalAttemptId String?        @unique @map("final_attempt_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  attempts     BaselineAttempt[]      @relation("ProfileAttempts")
  finalAttempt BaselineAttempt?       @relation("FinalAttempt", fields: [finalAttemptId], references: [id])
  iepDocuments BaselineIepDocument[]  // Uploaded IEP documents for comparison
  parentAssessment ParentAssessment?  // Parent's pre-baseline assessment

  @@unique([tenantId, learnerId])
  @@index([tenantId, learnerId])
  @@map("baseline_profiles")
}

model BaselineAttempt {
  id                  String            @id @default(uuid()) @db.Uuid
  baselineProfileId   String            @map("baseline_profile_id") @db.Uuid
  attemptNumber       Int               @map("attempt_number") @db.SmallInt
  startedAt           DateTime?         @map("started_at") @db.Timestamptz
  completedAt         DateTime?         @map("completed_at") @db.Timestamptz
  domainScoresJson    Json?             @map("domain_scores_json")
  overallEstimateJson Json?             @map("overall_estimate_json")
  retestReasonType    RetestReasonType? @map("retest_reason_type")
  retestReasonNotes   String?           @map("retest_reason_notes")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  profile         BaselineProfile          @relation("ProfileAttempts", fields: [baselineProfileId], references: [id], onDelete: Cascade)
  profileFinal    BaselineProfile?         @relation("FinalAttempt")
  items           BaselineItem[]
  skillEstimates  BaselineSkillEstimate[]
  iepComparisons  IepComparison[]          // Comparisons with uploaded IEP documents

  @@unique([baselineProfileId, attemptNumber])
  @@index([baselineProfileId, attemptNumber])
  @@map("baseline_attempts")
}

model BaselineItem {
  id                String         @id @default(uuid()) @db.Uuid
  baselineAttemptId String         @map("baseline_attempt_id") @db.Uuid
  sequenceIndex     Int            @map("sequence_index") @db.SmallInt
  domain            BaselineDomain
  gradeBand         GradeBand      @map("grade_band")
  promptJson        Json           @map("prompt_json")
  correctAnswerJson Json           @map("correct_answer_json")
  aiMetadataJson    Json?          @map("ai_metadata_json")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz

  attempt   BaselineAttempt    @relation(fields: [baselineAttemptId], references: [id], onDelete: Cascade)
  responses BaselineResponse[]

  @@unique([baselineAttemptId, sequenceIndex])
  @@index([baselineAttemptId, domain, sequenceIndex])
  @@map("baseline_items")
}

model BaselineResponse {
  id             String   @id @default(uuid()) @db.Uuid
  baselineItemId String   @map("baseline_item_id") @db.Uuid
  learnerId      String   @map("learner_id") @db.Uuid
  responseJson   Json     @map("response_json")
  isCorrect      Boolean? @map("is_correct")
  score          Decimal? @db.Decimal(5, 3)
  latencyMs      Int?     @map("latency_ms")
  submittedAt    DateTime @default(now()) @map("submitted_at") @db.Timestamptz

  item BaselineItem @relation(fields: [baselineItemId], references: [id], onDelete: Cascade)

  @@unique([baselineItemId, learnerId])
  @@index([learnerId, baselineItemId])
  @@map("baseline_responses")
}

model BaselineSkillEstimate {
  id                String         @id @default(uuid()) @db.Uuid
  baselineAttemptId String         @map("baseline_attempt_id") @db.Uuid
  skillCode         String         @map("skill_code")
  domain            BaselineDomain
  estimatedLevel    Decimal        @map("estimated_level") @db.Decimal(6, 3)
  confidence        Decimal        @db.Decimal(5, 3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz

  attempt BaselineAttempt @relation(fields: [baselineAttemptId], references: [id], onDelete: Cascade)

  @@unique([baselineAttemptId, skillCode])
  @@index([baselineAttemptId, skillCode])
  @@map("baseline_skill_estimates")
}

// ── IEP Document Upload Models ──────────────────────────────────────────────

enum IepDocumentStatus {
  PENDING          // Uploaded, awaiting processing
  PROCESSING       // OCR/AI extraction in progress
  PROCESSED        // Successfully extracted and analyzed
  COMPARISON_READY // Comparison with assessment complete
  APPROVED         // Parent/teacher approved to proceed
  REJECTED         // Document rejected or invalid
  ERROR            // Processing error occurred

  @@map("iep_document_status")
}

enum IepComparisonDecision {
  PENDING           // Awaiting parent/teacher decision
  AGREE_WITH_SYSTEM // Parent agrees with system assessment
  PREFER_EXISTING   // Parent prefers existing IEP goals
  MERGE_BOTH        // Combine goals from both sources
  REQUEST_REVIEW    // Request professional review

  @@map("iep_comparison_decision")
}

enum ParentAssessmentStatus {
  PENDING      // Invitation sent, parent hasn't started
  IN_PROGRESS  // Parent started but hasn't submitted
  COMPLETED    // Parent submitted assessment

  @@map("parent_assessment_status")
}

/// Assessment type aligned with IDEA/Section 504 requirements
enum AssessmentType {
  STANDARD                      // Full baseline assessment, all domains, 4 options
  STANDARD_WITH_ACCOMMODATIONS  // Standard with extended time, breaks, simplified navigation
  MODIFIED                      // Simplified language, visual supports, 3 options, shorter sessions
  ALTERNATE                     // Performance-based, caregiver-assisted, 2-3 options, functional skills
  
  @@map("assessment_type")
}

/// Parent's pre-baseline assessment of their child
/// Provides valuable context before child takes baseline assessment
model ParentAssessment {
  id                String                  @id @default(uuid()) @db.Uuid
  baselineProfileId String                  @unique @map("baseline_profile_id") @db.Uuid
  
  // Parent information
  parentUserId      String                  @map("parent_user_id") @db.Uuid
  parentEmail       String?                 @map("parent_email")
  
  // Assessment status
  status            ParentAssessmentStatus  @default(PENDING)
  
  // ── IDEA/Section 504 Aligned Assessment Type ────────────────────────────────
  /// Determined assessment type based on responses
  assessmentType    AssessmentType          @default(STANDARD) @map("assessment_type")
  
  /// Support level score (0-100, higher = more support needed)
  supportLevel      Float?                  @map("support_level")
  
  /// IEP/504 documentation flags
  hasExistingIep    Boolean                 @default(false) @map("has_existing_iep")
  hasExisting504    Boolean                 @default(false) @map("has_existing_504")
  
  /// IDEA disability categories (array of category codes)
  disabilityCategoriesJson Json?            @map("disability_categories_json")
  
  /// Current services the child receives
  currentServicesJson Json?                 @map("current_services_json")
  
  /// Assistive technology in use
  assistiveTechnologyJson Json?             @map("assistive_technology_json")
  
  /// Recommended accommodations based on assessment
  recommendationsJson Json?                 @map("recommendations_json")
  
  // Assessment responses (JSON array of question/answer pairs)
  responsesJson     Json?                   @map("responses_json")
  
  // Extracted insights for AI consumption
  learningStyleNotes String?               @map("learning_style_notes")
  strengthsNotes     String?               @map("strengths_notes")
  challengesNotes    String?               @map("challenges_notes")
  behaviorNotes      String?               @map("behavior_notes")
  
  // Enrollment context
  enrolledByRole    String                  @map("enrolled_by_role") // 'parent' or 'teacher'
  
  // Timestamps
  invitedAt         DateTime                @default(now()) @map("invited_at") @db.Timestamptz
  startedAt         DateTime?               @map("started_at") @db.Timestamptz
  completedAt       DateTime?               @map("completed_at") @db.Timestamptz
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  profile BaselineProfile @relation(fields: [baselineProfileId], references: [id], onDelete: Cascade)

  @@index([parentUserId])
  @@index([status])
  @@index([baselineProfileId, status])
  @@map("parent_assessments")
}

/// Uploaded IEP document linked to a baseline profile
model BaselineIepDocument {
  id                String            @id @default(uuid()) @db.Uuid
  baselineProfileId String            @map("baseline_profile_id") @db.Uuid

  // File information
  fileId            String            @map("file_id") @db.Uuid
  filename          String
  mimeType          String            @map("mime_type")
  fileSizeBytes     Int               @map("file_size_bytes")
  s3Key             String            @map("s3_key")

  // Processing status
  status            IepDocumentStatus @default(PENDING)
  processingError   String?           @map("processing_error")

  // Extracted content from OCR/AI
  extractedTextJson Json?             @map("extracted_text_json")
  extractedGoalsJson Json?            @map("extracted_goals_json")
  extractedAccommodationsJson Json?   @map("extracted_accommodations_json")
  extractedServicesJson Json?         @map("extracted_services_json")
  extractedMetadataJson Json?         @map("extracted_metadata_json")

  // Upload metadata
  uploadedByUserId  String            @map("uploaded_by_user_id") @db.Uuid
  uploadedByRole    String            @map("uploaded_by_role") // 'parent' or 'teacher'
  uploadNotes       String?           @map("upload_notes")

  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  processedAt       DateTime?         @map("processed_at") @db.Timestamptz

  profile     BaselineProfile      @relation(fields: [baselineProfileId], references: [id], onDelete: Cascade)
  comparisons IepComparison[]

  @@index([baselineProfileId])
  @@index([status])
  @@map("baseline_iep_documents")
}

/// Comparison results between uploaded IEP and system assessment
model IepComparison {
  id                  String               @id @default(uuid()) @db.Uuid
  iepDocumentId       String               @map("iep_document_id") @db.Uuid
  baselineAttemptId   String               @map("baseline_attempt_id") @db.Uuid

  // Comparison analysis results (AI-generated)
  summaryJson         Json                 @map("summary_json")
  domainComparisonsJson Json               @map("domain_comparisons_json")
  goalAlignmentJson   Json                 @map("goal_alignment_json")
  discrepanciesJson   Json?                @map("discrepancies_json")
  recommendationsJson Json?                @map("recommendations_json")

  // Confidence scores
  overallMatchScore   Decimal              @map("overall_match_score") @db.Decimal(5, 3)
  confidenceLevel     Decimal              @map("confidence_level") @db.Decimal(5, 3)

  // Parent/Teacher decision
  decision            IepComparisonDecision @default(PENDING)
  decisionByUserId    String?              @map("decision_by_user_id") @db.Uuid
  decisionByRole      String?              @map("decision_by_role")
  decisionNotes       String?              @map("decision_notes")
  decisionAt          DateTime?            @map("decision_at") @db.Timestamptz

  // New IEP generation (if approved)
  newIepGenerated     Boolean              @default(false) @map("new_iep_generated")
  generatedIepId      String?              @map("generated_iep_id") @db.Uuid

  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  iepDocument   BaselineIepDocument @relation(fields: [iepDocumentId], references: [id], onDelete: Cascade)
  attempt       BaselineAttempt     @relation(fields: [baselineAttemptId], references: [id], onDelete: Cascade)

  @@unique([iepDocumentId, baselineAttemptId])
  @@index([iepDocumentId])
  @@index([baselineAttemptId])
  @@index([decision])
  @@map("iep_comparisons")
}
