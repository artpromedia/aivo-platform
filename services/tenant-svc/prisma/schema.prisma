generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantType {
  CONSUMER
  DISTRICT
  CLINIC
}

/// Tenant lifecycle status for soft delete support
enum TenantStatus {
  ACTIVE          // Normal operation
  SUSPENDED       // Temporarily disabled (e.g., billing issue)
  PENDING_DELETE  // Soft-deleted, in 90-day grace period
  DELETED         // Hard-deleted (data purged)
}

model Tenant {
  id              String    @id @default(uuid()) @db.Uuid
  type            TenantType
  name            String
  primaryDomain   String    @unique
  billingPlanId   String?
  settingsJson    Json?

  // Domain configuration for multi-tenant access
  subdomain       String?   @unique  // e.g., "springfield-schools"
  customDomain    String?   @unique  // e.g., "learning.springfield.edu"
  domainVerified  Boolean   @default(false) @map("domain_verified")
  domainVerifiedAt DateTime? @map("domain_verified_at")

  // Geographic location for district auto-detection
  stateCode       String?   @map("state_code") @db.VarChar(2)  // US state: "CA", "TX", etc.
  zipCode         String?   @map("zip_code") @db.VarChar(10)   // ZIP code: "94105" or "94105-1234"
  city            String?   @db.VarChar(100)
  county          String?   @db.VarChar(100)
  ncesDistrictId  String?   @unique @map("nces_district_id")   // NCES district ID for matching

  // Region for data residency
  region          String    @default("us-east-1")
  isActive        Boolean   @default(true) @map("is_active")
  
  // Lifecycle status for soft delete
  status          TenantStatus @default(ACTIVE)
  deletedAt       DateTime?    @map("deleted_at")
  deleteGraceEndsAt DateTime?  @map("delete_grace_ends_at")
  deletedByUserId String?      @map("deleted_by_user_id") @db.Uuid
  
  // Branding
  logoUrl         String?   @map("logo_url")
  primaryColor    String?   @map("primary_color")
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  schools         School[]
  domainVerifications TenantDomainVerification[]
  config          TenantConfig?
  branding        TenantBranding?
  usageRecords    TenantUsage[]
  auditEvents     TenantAuditEvent[]
  
  @@index([subdomain])
  @@index([customDomain])
  @@index([isActive])
  @@index([status])
  @@index([deleteGraceEndsAt])
  @@index([stateCode])
  @@index([zipCode])
  @@index([ncesDistrictId])
}

// ══════════════════════════════════════════════════════════════════════════════
// Domain Verification for Custom Domains
// ══════════════════════════════════════════════════════════════════════════════

enum DomainVerificationType {
  TXT
  CNAME
}

enum DomainVerificationStatus {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

/// Domain verification records for custom domain setup
model TenantDomainVerification {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  domain            String
  
  // DNS verification
  verificationToken String   @map("verification_token")
  verificationType  DomainVerificationType @map("verification_type")
  verificationValue String   @map("verification_value")
  
  // Status tracking
  status            DomainVerificationStatus @default(PENDING)
  lastChecked       DateTime? @map("last_checked")
  failureReason     String?   @map("failure_reason")
  verifiedAt        DateTime? @map("verified_at")
  
  createdAt         DateTime @default(now())
  expiresAt         DateTime @map("expires_at")
  
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, domain])
  @@index([domain])
  @@index([status])
  @@index([expiresAt])
  @@map("tenant_domain_verifications")
}

model School {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  name        String
  address     String?
  externalId  String?

  // Geographic location
  stateCode   String?   @map("state_code") @db.VarChar(2)
  zipCode     String?   @map("zip_code") @db.VarChar(10)
  city        String?   @db.VarChar(100)
  county      String?   @db.VarChar(100)
  ncesSchoolId String?  @unique @map("nces_school_id")  // NCES school ID

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  classrooms  Classroom[]

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([stateCode])
  @@index([zipCode])
}

model Classroom {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  name      String
  grade     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sessionCodes ClassroomSessionCode[]
  learners     ClassroomLearner[]

  @@index([schoolId])
}

// ══════════════════════════════════════════════════════════════════════════════
// Classroom Session Codes (for shared device login)
// ══════════════════════════════════════════════════════════════════════════════

/// Privacy display mode for roster on shared devices
enum RosterDisplayMode {
  FIRST_NAME_LAST_INITIAL  // "John S."
  PSEUDONYM                 // "Blue Tiger 7"
  FIRST_NAME_ONLY           // "John"
}

/// Session code for shared device class login
model ClassroomSessionCode {
  id          String   @id @default(uuid()) @db.Uuid
  classroomId String   @db.Uuid
  code        String   @unique  // e.g., "ABC123"
  teacherId   String   @db.Uuid
  teacherName String?  // Display name for the teacher (optional for backwards compat)
  isActive    Boolean  @default(true)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@index([classroomId])
  @@index([code])
  @@index([expiresAt])
}

/// Learners enrolled in a classroom (for roster display)
model ClassroomLearner {
  id          String   @id @default(uuid()) @db.Uuid
  classroomId String   @db.Uuid
  learnerId   String   @db.Uuid
  displayName String   // "John S." or pseudonym depending on privacy
  pseudonym   String?  // Optional fun name: "Blue Tiger 7"
  avatarUrl   String?
  gradeBand   String?  // K_2, G3_5, G6_8, G9_12
  pinHash     String?  // bcrypt hash of learner's PIN
  pinAttempts Int      @default(0)
  pinLockedUntil DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([classroomId, learnerId])
  @@index([classroomId])
  @@index([learnerId])
}

// ══════════════════════════════════════════════════════════════════════════════
// Tenant Configuration
// ══════════════════════════════════════════════════════════════════════════════

/// AI provider allowed for this tenant
enum AllowedAIProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
  AZURE_OPENAI
  LOCAL
}

/// Tenant-specific configuration for features, AI, and data governance
model TenantConfig {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @unique @map("tenant_id") @db.Uuid
  
  // AI Configuration
  allowedAIProviders    AllowedAIProvider[] @default([OPENAI, ANTHROPIC])
  defaultAIProvider     AllowedAIProvider   @default(OPENAI)
  aiModelOverrides      Json?               @map("ai_model_overrides") // {"homework": "gpt-4o", "focus": "claude-3"}
  
  // Data Residency
  dataResidencyRegion   String   @default("us-east-1") @map("data_residency_region")
  backupRegion          String?  @map("backup_region")
  
  // Curriculum Configuration
  enabledModules        String[] @default(["ELA", "MATH"]) @map("enabled_modules")
  curriculumStandards   String[] @default(["COMMON_CORE"]) @map("curriculum_standards")
  gradeLevels           String[] @default(["K", "1", "2", "3", "4", "5", "6", "7", "8"]) @map("grade_levels")
  
  // Feature Flags
  enableHomeworkHelper  Boolean  @default(true)  @map("enable_homework_helper")
  enableFocusMode       Boolean  @default(true)  @map("enable_focus_mode")
  enableParentPortal    Boolean  @default(true)  @map("enable_parent_portal")
  enableTeacherDashboard Boolean @default(true) @map("enable_teacher_dashboard")
  
  // Usage Limits (0 = unlimited)
  dailyLLMCallLimit     Int      @default(10000) @map("daily_llm_call_limit")
  dailyTutorTurnLimit   Int      @default(50000) @map("daily_tutor_turn_limit")
  maxLearnersPerTenant  Int      @default(0)     @map("max_learners_per_tenant")
  storageQuotaGB        Int      @default(100)   @map("storage_quota_gb")
  
  // Safety & Compliance
  contentFilterLevel    String   @default("STANDARD") @map("content_filter_level") // STRICT, STANDARD, MINIMAL
  enablePIIRedaction    Boolean  @default(true)  @map("enable_pii_redaction")
  retentionDays         Int      @default(2555)  @map("retention_days") // 7 years FERPA
  
  // Custom JSON settings for extensibility
  customSettings        Json?    @map("custom_settings")
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@map("tenant_configs")
}

// ══════════════════════════════════════════════════════════════════════════════
// Tenant Usage Tracking
// ══════════════════════════════════════════════════════════════════════════════

/// Daily usage aggregates for quota tracking
model TenantUsage {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  usageDate       DateTime @map("usage_date") @db.Date
  
  // LLM Usage
  llmCallCount    Int      @default(0) @map("llm_call_count")
  llmTokensUsed   BigInt   @default(0) @map("llm_tokens_used")
  llmCostCents    Int      @default(0) @map("llm_cost_cents")
  
  // Tutor Usage
  tutorTurnCount  Int      @default(0) @map("tutor_turn_count")
  sessionCount    Int      @default(0) @map("session_count")
  activeUsers     Int      @default(0) @map("active_users")
  
  // Storage Usage (in MB)
  storageUsedMB   Int      @default(0) @map("storage_used_mb")
  filesUploaded   Int      @default(0) @map("files_uploaded")
  
  // Quota Status
  llmQuotaReached     Boolean @default(false) @map("llm_quota_reached")
  tutorQuotaReached   Boolean @default(false) @map("tutor_quota_reached")
  quotaWarningAt      DateTime? @map("quota_warning_at")
  quotaBlockedAt      DateTime? @map("quota_blocked_at")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, usageDate])
  @@index([tenantId, usageDate])
  @@index([llmQuotaReached])
  @@index([tutorQuotaReached])
  @@map("tenant_usage")
}

// ══════════════════════════════════════════════════════════════════════════════
// Tenant Audit Events
// ══════════════════════════════════════════════════════════════════════════════

/// Type of tenant audit event
enum TenantAuditEventType {
  TENANT_CREATED
  TENANT_UPDATED
  TENANT_SUSPENDED
  TENANT_REACTIVATED
  TENANT_DELETE_INITIATED
  TENANT_DELETE_CANCELLED
  TENANT_DELETED
  CONFIG_UPDATED
  DOMAIN_VERIFIED
  DOMAIN_REMOVED
  QUOTA_WARNING
  QUOTA_EXCEEDED
  QUOTA_RESET
  ADMIN_ACCESS
  PROVISIONING_STARTED
  PROVISIONING_COMPLETED
  PROVISIONING_FAILED
  PROVISIONING_ROLLED_BACK
  TRIAL_STARTED
  TRIAL_EXPIRING
  TRIAL_EXPIRED
  TRIAL_CONVERTED
}

/// Audit log for tenant lifecycle events
model TenantAuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  eventType     TenantAuditEventType @map("event_type")
  
  // Actor information
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  actorEmail    String?  @map("actor_email")
  actorRole     String?  @map("actor_role")
  actorIp       String?  @map("actor_ip")
  
  // Event details
  description   String
  beforeState   Json?    @map("before_state")
  afterState    Json?    @map("after_state")
  metadata      Json?
  
  createdAt     DateTime @default(now())
  
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId, createdAt])
  @@index([eventType])
  @@index([actorUserId])
  @@map("tenant_audit_events")
}

// ══════════════════════════════════════════════════════════════════════════════
// District Lookup (ZIP to District Mapping)
// ══════════════════════════════════════════════════════════════════════════════

/// District lookup table for auto-detecting district from ZIP code
/// Populated from NCES data (National Center for Education Statistics)
model DistrictLookup {
  id              String   @id @default(uuid()) @db.Uuid
  ncesDistrictId  String   @map("nces_district_id")          // NCES LEA ID
  districtName    String   @map("district_name")
  stateCode       String   @map("state_code") @db.VarChar(2)
  stateName       String   @map("state_name")

  // Geographic coverage
  zipCodes        String[] @map("zip_codes")                  // All ZIP codes in this district
  counties        String[] @default([])
  city            String?

  // District metadata
  districtType    String?  @map("district_type")              // Regular, Charter, etc.
  gradeSpan       String?  @map("grade_span")                 // e.g., "PK-12"
  enrollmentCount Int?     @map("enrollment_count")
  schoolCount     Int?     @map("school_count")

  // Contact info
  phone           String?
  website         String?
  address         String?

  // Data source tracking
  lastUpdated     DateTime @default(now()) @map("last_updated")
  dataSource      String   @default("NCES") @map("data_source")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([ncesDistrictId])
  @@index([stateCode])
  @@index([zipCodes])
  @@map("district_lookups")
}

/// ZIP code to district mapping (for efficient lookups)
model ZipCodeDistrict {
  id              String   @id @default(uuid()) @db.Uuid
  zipCode         String   @map("zip_code") @db.VarChar(5)
  stateCode       String   @map("state_code") @db.VarChar(2)

  // Can have multiple districts per ZIP (rare but possible)
  ncesDistrictIds String[] @map("nces_district_ids")
  primaryDistrictId String? @map("primary_district_id")       // Most common district for this ZIP

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([zipCode])
  @@index([stateCode])
  @@map("zip_code_districts")
}

// ══════════════════════════════════════════════════════════════════════════════
// State Curriculum Standards Mapping
// ══════════════════════════════════════════════════════════════════════════════

/// Curriculum standard framework
enum CurriculumFramework {
  COMMON_CORE          // Common Core State Standards
  NGSS                 // Next Generation Science Standards
  C3                   // College, Career, and Civic Life (Social Studies)
  STATE_SPECIFIC       // State-developed standards
  TEKS                 // Texas Essential Knowledge and Skills
  CCSS_MATH            // Common Core Math
  CCSS_ELA             // Common Core ELA
  STATE_SCIENCE        // State science standards
  STATE_SOCIAL_STUDIES // State social studies standards
}

/// Maps US states to their adopted curriculum standards
model StateCurriculumStandards {
  id              String   @id @default(uuid()) @db.Uuid
  stateCode       String   @map("state_code") @db.VarChar(2)
  stateName       String   @map("state_name")

  // Adopted frameworks
  mathFramework         CurriculumFramework @default(COMMON_CORE) @map("math_framework")
  elaFramework          CurriculumFramework @default(COMMON_CORE) @map("ela_framework")
  scienceFramework      CurriculumFramework @default(NGSS) @map("science_framework")
  socialStudiesFramework CurriculumFramework @default(C3) @map("social_studies_framework")

  // State-specific standards identifiers (for states with custom standards)
  stateStandardsVersion String? @map("state_standards_version")  // e.g., "TEKS 2023"
  stateStandardsUrl     String? @map("state_standards_url")

  // Additional frameworks adopted (e.g., SEL standards)
  additionalFrameworks  String[] @default([]) @map("additional_frameworks")

  // Metadata
  adoptedYear           Int?     @map("adopted_year")
  lastRevisedYear       Int?     @map("last_revised_year")
  notes                 String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([stateCode])
  @@map("state_curriculum_standards")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enterprise Tenant Admin Controls (Sprint A5)
// ─────────────────────────────────────────────────────────────────────────────

/// IP allow-list entries per tenant (CIDR notation)
model TenantIpAllowlist {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  cidr      String   @db.VarChar(45)   // supports IPv4 /32 and IPv6 /128
  label     String?  @db.VarChar(120)
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("tenant_ip_allowlist")
}

enum DomainStatus {
  PENDING_VERIFICATION
  VERIFIED
  FAILED
}

/// Custom domains mapped to tenants with DNS verification
model TenantCustomDomain {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  domain            String       @unique @db.VarChar(253)
  status            DomainStatus @default(PENDING_VERIFICATION)
  verificationToken String       @map("verification_token") @db.VarChar(64)
  verifiedAt        DateTime?    @map("verified_at")
  createdAt         DateTime     @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([domain])
  @@index([status])
  @@map("tenant_custom_domain")
}

// ══════════════════════════════════════════════════════════════════════════════
// Tenant Branding (white-label customization)
// ══════════════════════════════════════════════════════════════════════════════

/// Per-tenant branding configuration for white-label support
model TenantBranding {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @unique @map("tenant_id") @db.Uuid

  // Display
  displayName       String?  @map("display_name")
  logoUrl           String?  @map("logo_url")
  logoSmallUrl      String?  @map("logo_small_url")
  faviconUrl        String?  @map("favicon_url")

  // Colors
  primaryColor      String   @default("#6366F1") @map("primary_color")
  primaryColorLight String   @default("#818CF8") @map("primary_color_light")
  primaryColorDark  String   @default("#4F46E5") @map("primary_color_dark")
  secondaryColor    String   @default("#EC4899") @map("secondary_color")
  accentColor       String   @default("#F59E0B") @map("accent_color")
  backgroundColor   String   @default("#FFFFFF") @map("background_color")
  surfaceColor      String   @default("#F8FAFC") @map("surface_color")
  textColor         String   @default("#0F172A") @map("text_color")
  textMutedColor    String   @default("#64748B") @map("text_muted_color")

  // Typography & Layout
  fontFamily        String   @default("Inter") @map("font_family")
  borderRadius      String   @default("0.5rem") @map("border_radius")

  // Login customization
  loginBackground   String?  @map("login_background")
  loginMessage      String?  @map("login_message")

  // Support & legal links
  supportEmail      String?  @map("support_email")
  supportUrl        String?  @map("support_url")
  privacyPolicyUrl  String?  @map("privacy_policy_url")
  termsOfServiceUrl String?  @map("terms_of_service_url")

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_branding")
}

// ══════════════════════════════════════════════════════════════════════════════
// Tenant Provisioning Jobs
// ══════════════════════════════════════════════════════════════════════════════

/// Provisioning job status for tenant creation pipeline
model TenantProvisioningJob {
  id                String   @id @default(uuid()) @db.Uuid
  idempotencyKey    String   @unique @map("idempotency_key")

  // Input data
  organizationName  String   @map("organization_name")
  adminEmail        String   @map("admin_email")
  adminName         String?  @map("admin_name")
  organizationType  String   @default("DISTRICT") @map("organization_type")
  planId            String?  @map("plan_id")
  districtSize      String?  @map("district_size")
  stateCode         String?  @map("state_code") @db.VarChar(2)
  zipCode           String?  @map("zip_code") @db.VarChar(10)
  metadata          Json     @default("{}")

  // Pipeline state
  status            String   @default("PENDING")
  currentStep       Int      @default(0) @map("current_step")
  totalSteps        Int      @default(10) @map("total_steps")
  stepLog           Json     @default("[]") @map("step_log")
  tenantId          String?  @map("tenant_id") @db.Uuid

  // Failure / retry tracking
  failedStep        String?  @map("failed_step")
  failedReason      String?  @map("failed_reason")
  retryCount        Int      @default(0) @map("retry_count")
  maxRetries        Int      @default(3) @map("max_retries")
  lastRetriedAt     DateTime? @map("last_retried_at")

  // Lifecycle
  completedAt       DateTime? @map("completed_at")
  rolledBackAt      DateTime? @map("rolled_back_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([adminEmail])
  @@index([status])
  @@index([tenantId])
  @@map("tenant_provisioning_jobs")
}

/// Feature flags that district admins can toggle per tenant
model TenantFeatureFlag {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  flag     String   @db.VarChar(80)
  enabled  Boolean  @default(false)
  setBy    String?  @map("set_by") @db.Uuid
  setAt    DateTime @default(now()) @map("set_at")

  @@unique([tenantId, flag])
  @@index([tenantId])
  @@map("tenant_feature_flag")
}
