# Server
PORT=4020

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aivo_brain_orchestrator

# JWT
JWT_SECRET=your-jwt-secret-key
JWT_PUBLIC_KEY_PATH=../../.keys/jwt.pub

# External Services
LEARNER_MODEL_SVC_URL=http://localhost:4015
LESSON_SVC_URL=http://localhost:4016
ASSESSMENT_SVC_URL=http://localhost:3006
HOMEWORK_HELPER_SVC_URL=http://localhost:4017
FOCUS_SVC_URL=http://localhost:4018
VIRTUAL_BRAIN_SVC_URL=http://localhost:4019
AI_ORCHESTRATOR_URL=http://localhost:4005

# NATS
NATS_URL=nats://localhost:4222

# CORS
