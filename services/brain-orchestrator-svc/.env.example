# Cognitive Load Settings
COGNITIVE_LOAD_UPDATE_INTERVAL_MS=100
DEFAULT_BREAK_INTERVAL_MINUTES=25
MAX_COGNITIVE_LOAD_SCORE=100
FATIGUE_THRESHOLD=70

# Performance
MAX_CONCURRENT_TASKS_PER_LEARNER=5
TASK_TIMEOUT_MS=300000
