{
  "name": "@aivo/curriculum-svc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "seed:k5": "tsx prisma/seed-k5-curriculum.ts",
    "seed:6-8": "tsx prisma/seed-6-8-curriculum.ts",
    "seed:9-12": "tsx prisma/seed-9-12-curriculum.ts",
    "seed:links": "tsx prisma/seed-content-links.ts",
    "seed:all": "tsx prisma/seed-k5-curriculum.ts && tsx prisma/seed-6-8-curriculum.ts && tsx prisma/seed-9-12-curriculum.ts && tsx prisma/seed-content-links.ts",
    "lint": "eslint src",
    "test": "vitest"
  },
  "dependencies": {
    "@aivo/ts-api-utils": "workspace:^",
    "@fastify/cors": "^8.4.0",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.6.0",
    "dotenv": "^16.3.1",
    "fastify": "^4.24.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "prisma": "^5.6.0",
    "tsx": "^4.1.2",
    "typescript": "^5.2.2",
    "vitest": "^0.34.6"
  },
  "aivo": {
    "phase": 2,
    "disposition": "freeze",
    "framework": "fastify"
  }
}
