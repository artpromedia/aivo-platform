# ==============================================================================
# AIVO Status Page Service — Environment Variables
# ==============================================================================

# Server
PORT=3090
HOST=0.0.0.0
NODE_ENV=development

# SQLite database path (independent — NOT the platform PostgreSQL)
DATABASE_PATH=./data/status.db

# Prometheus endpoint (to query platform metrics)
PROMETHEUS_URL=http://prometheus:9090

# Alertmanager webhook secret (shared with Alertmanager config)
ALERTMANAGER_WEBHOOK_SECRET=change-me-in-production

# Notification settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=status@aivolearning.com

# Public URL (for feed links and unsubscribe URLs)
PUBLIC_URL=https://status.aivolearning.com

# CORS allowed origins
CORS_ORIGIN=https://status.aivolearning.com
