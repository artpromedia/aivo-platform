# Tutor Service - Environment Variables

# Server
PORT=4020

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aivo_tutor

# JWT (for auth middleware)
JWT_PUBLIC_KEY_PATH=../../.keys/jwt.pub

# AI Orchestrator
AI_ORCHESTRATOR_URL=http://localhost:4005
AI_ORCHESTRATOR_API_KEY=

# Billing Service
BILLING_SVC_URL=http://localhost:3150

# Redis (for session caching)
REDIS_URL=redis://localhost:6379

# TTS Provider
TTS_PROVIDER=azure
TTS_API_KEY=
TTS_REGION=eastus
