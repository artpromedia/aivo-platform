# Realtime Service - Python WebSocket Manager
# Environment Configuration

# Service Configuration
SERVICE_NAME=realtime-svc-python
SERVICE_VERSION=1.0.0
HOST=0.0.0.0
PORT=8080
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=100
REDIS_CONNECTION_TIMEOUT=10
REDIS_KEY_PREFIX=ws:py:

# WebSocket Configuration
WS_PATH=/ws
WS_PING_INTERVAL=25
WS_PING_TIMEOUT=60
WS_MAX_MESSAGE_SIZE=1048576
WS_MAX_CONNECTIONS_PER_LEARNER=5

# Heartbeat Configuration
HEARTBEAT_INTERVAL=30
HEARTBEAT_TIMEOUT=90
HEARTBEAT_CHECK_INTERVAL=15

# Connection Configuration
CONNECTION_TTL=3600
STALE_CONNECTION_TIMEOUT=300
RECONNECTION_GRACE_PERIOD=30

# Room Configuration
ROOM_TTL=86400
ROOM_MAX_MEMBERS=1000
ROOM_MESSAGE_HISTORY_LIMIT=100

# Cognitive State Configuration
COGNITIVE_UPDATE_INTERVAL=5
FRUSTRATION_THRESHOLD=0.7
COGNITIVE_OVERLOAD_THRESHOLD=0.8
ENGAGEMENT_LOW_THRESHOLD=0.3

# Intervention Configuration
MIN_INTERVENTION_INTERVAL=60
MAX_INTERVENTIONS_PER_SESSION=10

# Metrics Configuration
METRICS_ENABLED=true
METRICS_COLLECTION_INTERVAL=30
METRICS_PREFIX=realtime_ws

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true

# Authentication
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256
AUTH_REQUIRED=false

# External Services (optional)
# COGNITIVE_SERVICE_URL=http://cognitive-svc:4000
# INTERVENTION_SERVICE_URL=http://intervention-svc:4001
# ANALYTICS_SERVICE_URL=http://analytics-svc:4006
# RABBITMQ_URL=amqp://guest:guest@localhost:5672
