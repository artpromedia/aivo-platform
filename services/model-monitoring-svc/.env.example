# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aivo_model_monitoring

# Server
PORT=4074
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Authentication
JWT_PUBLIC_KEY_PATH=/etc/secrets/jwt-public.pem
INTERNAL_API_KEY=dev-internal-key

# External Services
MODEL_REGISTRY_URL=http://localhost:4012

# Monitoring Settings
DEFAULT_METRIC_WINDOW=3600
PREDICTION_RETENTION_DAYS=90

# Alert Settings
ALERT_CHECK_INTERVAL=300
WEBHOOK_TIMEOUT=10000

# Feature Importance
FEATURE_IMPORTANCE_INTERVAL=86400

# Data Drift
DRIFT_CHECK_INTERVAL=86400
DRIFT_DETECTION_METHOD=ks_test

# Performance
BATCH_PREDICTION_LOG_SIZE=1000
METRICS_BATCH_SIZE=10000
