# Geolocation Service Environment Variables

# Server Configuration
NODE_ENV=development
HOST=0.0.0.0
PORT=4090

# Database
DATABASE_URL=postgresql://aivo:aivo@localhost:5433/geolocation

# Redis Cache
REDIS_URL=redis://localhost:6380/8

# MaxMind GeoIP2 Configuration
# Get a free license key at: https://www.maxmind.com/en/geolite2/signup
MAXMIND_LICENSE_KEY=
MAXMIND_ACCOUNT_ID=
MAXMIND_DB_PATH=./data/GeoLite2-City.mmdb

# Logging
LOG_LEVEL=info

# Cache TTL (seconds)
IP_CACHE_TTL=86400
COUNTRY_CACHE_TTL=604800
CURRENCY_CACHE_TTL=3600
