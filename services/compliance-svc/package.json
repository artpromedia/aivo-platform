{
  "name": "@aivo/compliance-svc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-framework compliance monitoring and dashboard service",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aivo/events": "workspace:*",
    "@aivo/ts-api-utils": "workspace:*",
    "@aivo/ts-rbac": "workspace:*",
    "@aivo/ts-shared": "workspace:*",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "node-cron": "^3.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "aivo": {
    "phase": 1,
    "disposition": "merge-target",
    "framework": "fastify",
    "mergeAbsorbs": [
      "consent-svc",
      "legal-hold-svc",
      "dsr-svc"
    ]
  }
}
