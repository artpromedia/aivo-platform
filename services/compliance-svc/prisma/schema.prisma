// ══════════════════════════════════════════════════════════════════════════════
// AIVO Compliance Service - Unified Prisma Schema
// ══════════════════════════════════════════════════════════════════════════════
// Consolidated: compliance + consent (COPPA) + legal-hold + DSR modules

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════════════════════════════════════════════
// ENUMS
// ══════════════════════════════════════════════════════════════════════════════

/// Supported compliance frameworks
enum Framework {
  FERPA       // Family Educational Rights and Privacy Act
  COPPA       // Children's Online Privacy Protection Act
  GDPR        // General Data Protection Regulation
  CCPA        // California Consumer Privacy Act
  SOC2        // Service Organization Control 2
  HIPAA       // Health Insurance Portability and Accountability Act
  PCI_DSS     // Payment Card Industry Data Security Standard
  ISO27001    // Information Security Management
  NIST_CSF    // NIST Cybersecurity Framework
  CIPA        // Children's Internet Protection Act
  IDEA        // Individuals with Disabilities Education Act
  CUSTOM      // Custom/internal framework
}

/// Control status
enum ControlStatus {
  NOT_STARTED
  IN_PROGRESS
  IMPLEMENTED
  NOT_APPLICABLE
  PARTIALLY_IMPLEMENTED
}

/// Assessment status
enum AssessmentStatus {
  DRAFT
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETED
  ARCHIVED
}

/// Finding severity
enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFORMATIONAL
}

/// Finding status
enum FindingStatus {
  OPEN
  IN_REMEDIATION
  REMEDIATED
  ACCEPTED_RISK
  FALSE_POSITIVE
  CLOSED
}

/// Evidence type
enum EvidenceType {
  DOCUMENT
  SCREENSHOT
  LOG_EXPORT
  CONFIGURATION
  POLICY
  PROCEDURE
  TRAINING_RECORD
  AUDIT_REPORT
  ATTESTATION
  AUTOMATED_CHECK
  OTHER
}

/// Evidence status
enum EvidenceStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  SUPERSEDED
}

/// Remediation priority
enum RemediationPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

/// Remediation status
enum RemediationStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

// ══════════════════════════════════════════════════════════════════════════════
// FRAMEWORK & CONTROLS
// ══════════════════════════════════════════════════════════════════════════════

/// Compliance framework configuration for a tenant
model TenantFramework {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @db.Uuid

  framework       Framework
  displayName     String         // Custom name if desired
  description     String?

  // Configuration
  isActive        Boolean        @default(true)
  priority        Int            @default(0)  // For ordering

  // Scope
  applicableFrom  DateTime?      // When framework became applicable
  applicableUntil DateTime?      // When it will cease to apply

  // Metadata
  regulatoryBody  String?        // e.g., "U.S. Department of Education"
  jurisdiction    String?        // e.g., "United States", "European Union"
  version         String?        // Framework version

  // Timestamps
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  enabledBy       String?        @db.Uuid

  // Relations
  controls        Control[]
  assessments     Assessment[]

  @@unique([tenantId, framework])
  @@index([tenantId])
  @@index([tenantId, isActive])
}

/// Individual control/requirement within a framework
model Control {
  id                  String         @id @default(uuid()) @db.Uuid
  tenantFrameworkId   String         @db.Uuid

  // Control identification
  controlId           String         // Framework-specific ID (e.g., "164.312(a)(1)")
  title               String
  description         String?
  guidance            String?        // Implementation guidance

  // Categorization
  category            String?        // e.g., "Access Control", "Data Protection"
  subcategory         String?
  domain              String?        // High-level domain

  // Requirements
  requirement         String?        // Specific requirement text
  implementationSpec  String?        // How to implement

  // Classification
  isMandatory         Boolean        @default(true)
  isAutomatable       Boolean        @default(false)
  frequency           String?        // How often to verify (e.g., "annual", "continuous")

  // Current status
  status              ControlStatus  @default(NOT_STARTED)
  statusUpdatedAt     DateTime?
  statusUpdatedBy     String?        @db.Uuid

  // Implementation details
  implementationNotes String?
  implementedAt       DateTime?
  implementedBy       String?        @db.Uuid

  // Risk if not implemented
  riskLevel           FindingSeverity?

  // Ownership
  ownerId             String?        @db.Uuid
  ownerEmail          String?

  // Timestamps
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Relations
  tenantFramework     TenantFramework @relation(fields: [tenantFrameworkId], references: [id], onDelete: Cascade)
  evidence            ControlEvidence[]
  findings            Finding[]
  mappings            ControlMapping[] @relation("SourceControl")
  mappedFrom          ControlMapping[] @relation("TargetControl")
  assessmentControls  AssessmentControl[]

  @@unique([tenantFrameworkId, controlId])
  @@index([tenantFrameworkId])
  @@index([status])
  @@index([category])
  @@index([ownerId])
}

/// Mapping between controls across frameworks
model ControlMapping {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @db.Uuid

  sourceControlId   String         @db.Uuid
  targetControlId   String         @db.Uuid

  // Mapping details
  mappingType       String         // "equivalent", "partial", "related"
  confidence        Float          @default(1.0)  // 0-1 confidence score
  notes             String?

  // Source
  mappedBy          String?        @db.Uuid  // null if auto-mapped
  isAutoMapped      Boolean        @default(false)

  createdAt         DateTime       @default(now())

  // Relations
  sourceControl     Control        @relation("SourceControl", fields: [sourceControlId], references: [id], onDelete: Cascade)
  targetControl     Control        @relation("TargetControl", fields: [targetControlId], references: [id], onDelete: Cascade)

  @@unique([sourceControlId, targetControlId])
  @@index([tenantId])
  @@index([sourceControlId])
  @@index([targetControlId])
}

// ══════════════════════════════════════════════════════════════════════════════
// ASSESSMENTS
// ══════════════════════════════════════════════════════════════════════════════

/// Compliance assessment/audit
model Assessment {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @db.Uuid
  tenantFrameworkId String            @db.Uuid

  // Assessment info
  name              String
  description       String?
  assessmentType    String            // "internal", "external", "self", "certification"

  // Scope
  scopeDescription  String?
  inScopeServices   String[]          @default([])
  excludedServices  String[]          @default([])

  // Period
  periodStart       DateTime
  periodEnd         DateTime

  // Status
  status            AssessmentStatus  @default(DRAFT)
  statusChangedAt   DateTime?
  statusChangedBy   String?           @db.Uuid

  // Ownership
  leadAssessorId    String?           @db.Uuid
  leadAssessorEmail String?
  assessorTeam      String[]          @default([])

  // Results summary
  totalControls     Int               @default(0)
  passedControls    Int               @default(0)
  failedControls    Int               @default(0)
  naControls        Int               @default(0)
  complianceScore   Float?            // Percentage

  // Completion
  startedAt         DateTime?
  completedAt       DateTime?
  signedOffAt       DateTime?
  signedOffBy       String?           @db.Uuid

  // External audit details
  auditorFirm       String?
  auditorContact    String?
  reportUrl         String?

  // Timestamps
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdBy         String            @db.Uuid

  // Relations
  tenantFramework   TenantFramework   @relation(fields: [tenantFrameworkId], references: [id])
  controls          AssessmentControl[]
  findings          Finding[]

  @@index([tenantId])
  @@index([tenantFrameworkId])
  @@index([status])
  @@index([periodStart, periodEnd])
}

/// Control evaluation within an assessment
model AssessmentControl {
  id              String            @id @default(uuid()) @db.Uuid
  assessmentId    String            @db.Uuid
  controlId       String            @db.Uuid

  // Evaluation
  status          ControlStatus     @default(NOT_STARTED)
  evaluationNotes String?
  testedAt        DateTime?
  testedBy        String?           @db.Uuid

  // Test results
  testProcedure   String?           // What was tested
  testResult      String?           // "pass", "fail", "partial", "not_tested"
  testEvidence    String?           // Reference to evidence

  // Timestamps
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  assessment      Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  control         Control           @relation(fields: [controlId], references: [id])

  @@unique([assessmentId, controlId])
  @@index([assessmentId])
  @@index([controlId])
}

// ══════════════════════════════════════════════════════════════════════════════
// EVIDENCE
// ══════════════════════════════════════════════════════════════════════════════

/// Evidence attached to a control
model ControlEvidence {
  id              String           @id @default(uuid()) @db.Uuid
  controlId       String           @db.Uuid
  evidenceId      String           @db.Uuid

  // Mapping details
  relevance       String?          // How this evidence relates to the control
  isPrimary       Boolean          @default(false)

  attachedAt      DateTime         @default(now())
  attachedBy      String           @db.Uuid

  // Relations
  control         Control          @relation(fields: [controlId], references: [id], onDelete: Cascade)
  evidence        Evidence         @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([controlId, evidenceId])
  @@index([controlId])
  @@index([evidenceId])
}

/// Evidence document/artifact
model Evidence {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid

  // Evidence info
  title           String
  description     String?
  type            EvidenceType

  // Status
  status          EvidenceStatus   @default(PENDING_REVIEW)
  reviewedAt      DateTime?
  reviewedBy      String?          @db.Uuid
  reviewNotes     String?

  // Validity
  validFrom       DateTime         @default(now())
  validUntil      DateTime?        // When evidence expires
  collectedAt     DateTime         @default(now())

  // Storage
  fileUrl         String?          // S3 URL
  fileName        String?
  fileSize        Int?
  mimeType        String?
  checksum        String?

  // For automated evidence
  sourceSystem    String?          // System that generated evidence
  sourceQuery     String?          // Query/command used
  automatedAt     DateTime?

  // Metadata
  tags            String[]         @default([])
  metadata        Json?

  // Timestamps
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  uploadedBy      String           @db.Uuid

  // Relations
  controlMappings ControlEvidence[]

  @@index([tenantId])
  @@index([type])
  @@index([status])
  @@index([validUntil])
}

// ══════════════════════════════════════════════════════════════════════════════
// FINDINGS & REMEDIATION
// ══════════════════════════════════════════════════════════════════════════════

/// Compliance finding/gap
model Finding {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid

  // Context
  assessmentId    String?          @db.Uuid
  controlId       String?          @db.Uuid

  // Finding details
  title           String
  description     String
  severity        FindingSeverity
  status          FindingStatus    @default(OPEN)

  // Details
  rootCause       String?
  impact          String?          // Business impact
  likelihood      String?          // Likelihood of occurrence
  affectedSystems String[]         @default([])

  // Risk scoring
  riskScore       Float?           // Calculated risk score
  inherentRisk    Float?           // Risk without controls
  residualRisk    Float?           // Risk with current controls

  // Timeline
  identifiedAt    DateTime         @default(now())
  identifiedBy    String           @db.Uuid
  dueDate         DateTime?        // When finding should be resolved

  // Resolution
  resolvedAt      DateTime?
  resolvedBy      String?          @db.Uuid
  resolution      String?          // How it was resolved
  verifiedAt      DateTime?
  verifiedBy      String?          @db.Uuid

  // If risk accepted
  riskAcceptedAt  DateTime?
  riskAcceptedBy  String?          @db.Uuid
  riskAcceptReason String?

  // Timestamps
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  assessment      Assessment?      @relation(fields: [assessmentId], references: [id])
  control         Control?         @relation(fields: [controlId], references: [id])
  remediations    Remediation[]

  @@index([tenantId])
  @@index([assessmentId])
  @@index([controlId])
  @@index([severity])
  @@index([status])
  @@index([dueDate])
}

/// Remediation plan for a finding
model Remediation {
  id              String             @id @default(uuid()) @db.Uuid
  findingId       String             @db.Uuid

  // Plan details
  title           String
  description     String
  priority        RemediationPriority
  status          RemediationStatus  @default(NOT_STARTED)

  // Actions
  actionPlan      String?            // Step-by-step plan
  mitigatingControl String?          // Temporary mitigation

  // Resources
  estimatedEffort String?            // e.g., "2 weeks", "40 hours"
  estimatedCost   Float?
  actualEffort    String?
  actualCost      Float?

  // Ownership
  assigneeId      String?            @db.Uuid
  assigneeEmail   String?
  teamId          String?            @db.Uuid

  // Timeline
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?

  // Progress
  progressPercent  Int               @default(0)
  progressNotes    String?
  blockerNotes     String?

  // Verification
  verificationPlan String?
  verifiedAt       DateTime?
  verifiedBy       String?           @db.Uuid

  // Timestamps
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  createdBy       String             @db.Uuid

  // Relations
  finding         Finding            @relation(fields: [findingId], references: [id], onDelete: Cascade)
  tasks           RemediationTask[]

  @@index([findingId])
  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([plannedEndDate])
}

/// Individual task within a remediation plan
model RemediationTask {
  id              String             @id @default(uuid()) @db.Uuid
  remediationId   String             @db.Uuid

  // Task details
  title           String
  description     String?
  orderIndex      Int                @default(0)

  // Status
  isCompleted     Boolean            @default(false)
  completedAt     DateTime?
  completedBy     String?            @db.Uuid

  // Assignment
  assigneeId      String?            @db.Uuid
  dueDate         DateTime?

  // Timestamps
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  // Relations
  remediation     Remediation        @relation(fields: [remediationId], references: [id], onDelete: Cascade)

  @@index([remediationId])
  @@index([assigneeId])
}

// ══════════════════════════════════════════════════════════════════════════════
// COMPLIANCE DASHBOARD
// ══════════════════════════════════════════════════════════════════════════════

/// Cached compliance score snapshot
model ComplianceSnapshot {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @db.Uuid
  framework       Framework?     // null for overall score

  // Scores
  overallScore    Float          // 0-100 percentage
  controlsTotal   Int
  controlsPassed  Int
  controlsFailed  Int
  controlsNA      Int
  controlsInProgress Int

  // Findings summary
  findingsOpen    Int            @default(0)
  findingsCritical Int           @default(0)
  findingsHigh    Int            @default(0)
  findingsMedium  Int            @default(0)
  findingsLow     Int            @default(0)

  // Trend (vs previous snapshot)
  scoreDelta      Float?         // Change from previous
  trendDirection  String?        // "up", "down", "stable"

  // Snapshot time
  snapshotAt      DateTime       @default(now())

  @@index([tenantId, snapshotAt])
  @@index([tenantId, framework])
}

/// Compliance alerts/notifications
model ComplianceAlert {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @db.Uuid

  // Alert details
  alertType       String         // "evidence_expiring", "assessment_due", "finding_overdue", etc.
  title           String
  message         String
  severity        FindingSeverity

  // Related entity
  entityType      String?        // "control", "evidence", "finding", "assessment"
  entityId        String?        @db.Uuid

  // Status
  isRead          Boolean        @default(false)
  readAt          DateTime?
  readBy          String?        @db.Uuid

  isDismissed     Boolean        @default(false)
  dismissedAt     DateTime?
  dismissedBy     String?        @db.Uuid

  // Action
  actionUrl       String?
  actionLabel     String?

  // Timestamps
  createdAt       DateTime       @default(now())
  expiresAt       DateTime?

  @@index([tenantId, isRead])
  @@index([tenantId, alertType])
  @@index([tenantId, createdAt])
}

// =============================================================================
// DATA BREACH MANAGEMENT (GDPR Art. 33-34, FERPA, COPPA)
// =============================================================================

/// Severity level for data breaches
enum BreachSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Status of a data breach
enum BreachStatus {
  DETECTED
  INVESTIGATING
  CONTAINED
  REMEDIATED
  CLOSED
}

/// Data breach record for compliance tracking
model DataBreach {
  id                          String         @id @default(uuid()) @db.Uuid
  tenantId                    String         @db.Uuid
  
  // Breach identification
  title                       String
  description                 String
  severity                    BreachSeverity
  status                      BreachStatus   @default(DETECTED)
  
  // When breach occurred/discovered
  detectedAt                  DateTime       @default(now())
  occurredAt                  DateTime?
  containedAt                 DateTime?
  resolvedAt                  DateTime?
  
  // Affected data
  affectedDataTypes           Json           @default("[]") // Array of data types: ["PERSONAL", "EDUCATIONAL", "FINANCIAL"]
  affectedRecordsCount        Int?
  affectedUsersCount          Int?
  affectedUserCategories      Json           @default("[]") // ["STUDENT", "PARENT", "TEACHER"]
  
  // Root cause & impact
  rootCause                   String?
  attackVector                String?        // "PHISHING", "MALWARE", "INSIDER", "MISCONFIGURATION", etc.
  impactDescription           String?
  
  // Regulatory notifications
  notifyAuthority             Boolean        @default(false)
  authorityNotificationDeadline DateTime?
  authorityNotifiedAt         DateTime?
  authorityJurisdictions      Json           @default("[]") // Array of jurisdiction codes
  authorityReferenceNumber    String?
  
  notifySubjects              Boolean        @default(false)
  subjectNotificationDeadline DateTime?
  subjectsNotifiedAt          DateTime?
  subjectNotificationMethod   String?        // "EMAIL", "LETTER", "WEBSITE", "ALL"
  
  // Remediation
  remediationSteps            Json           @default("[]") // Array of remediation actions
  lessonsLearned              String?
  
  // Audit trail
  reportedByUserId            String?        @db.Uuid
  assignedToUserId            String?        @db.Uuid
  
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt
  
  // Relations
  notifications               BreachNotification[]
  auditLog                    BreachAuditLog[]
  
  @@index([tenantId, status])
  @@index([tenantId, severity])
  @@index([detectedAt(sort: Desc)])
  @@index([tenantId, notifyAuthority, authorityNotifiedAt])
}

/// Notifications sent for a data breach
model BreachNotification {
  id               String    @id @default(uuid()) @db.Uuid
  breachId         String    @db.Uuid
  tenantId         String    @db.Uuid
  
  // Notification details
  notificationType String    // "AUTHORITY", "SUBJECT", "INTERNAL"
  templateId       String?
  language         String    @default("en")
  
  // Recipient
  recipientType    String?   // "DPA", "INDIVIDUAL", "CLASS_ACTION"
  recipientEmail   String?
  recipientName    String?
  recipientAddress String?
  
  // Content
  subject          String?
  body             String?
  
  // Status
  status           String    @default("PENDING") // "PENDING", "SENT", "DELIVERED", "FAILED"
  sentAt           DateTime?
  deliveredAt      DateTime?
  failureReason    String?
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  breach           DataBreach @relation(fields: [breachId], references: [id], onDelete: Cascade)
  
  @@index([breachId])
  @@index([tenantId, status])
  @@index([tenantId, notificationType])
}

/// Audit log for breach-related actions
model BreachAuditLog {
  id            String    @id @default(uuid()) @db.Uuid
  breachId      String    @db.Uuid
  tenantId      String    @db.Uuid
  
  action        String    // "CREATED", "UPDATED", "STATUS_CHANGED", "NOTIFICATION_SENT", etc.
  performedBy   String?   @db.Uuid
  ipAddress     String?
  userAgent     String?
  
  previousValue Json?
  newValue      Json?
  notes         String?
  
  createdAt     DateTime  @default(now())
  
  breach        DataBreach @relation(fields: [breachId], references: [id], onDelete: Cascade)
  
  @@index([breachId])
  @@index([tenantId, createdAt])
}

// ══════════════════════════════════════════════════════════════════════════════
// CONSENT MODULE (formerly consent-svc) — COPPA/FERPA consent management
// ══════════════════════════════════════════════════════════════════════════════

enum ConsentStatus {
  PENDING
  GRANTED
  DENIED
  REVOKED
  EXPIRED
}

enum ConsentType {
  COPPA
  FERPA
  MARKETING
  DATA_SHARING
  ANALYTICS
  THIRD_PARTY
  AI_FEATURES
  COMMUNICATION
}

enum ConsentSource {
  PARENT_PORTAL
  EMAIL_LINK
  PAPER_FORM
  IN_PERSON
  BULK_IMPORT
  SCHOOL_ADMIN
  API
}

model Consent {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String        @db.Uuid
  learnerId         String        @db.Uuid
  parentId          String?       @db.Uuid
  consentType       ConsentType
  status            ConsentStatus @default(PENDING)
  consentedAt       DateTime?
  expiresAt         DateTime?
  revokedAt         DateTime?
  consentSource     ConsentSource
  ipAddress         String?
  userAgent         String?
  version           Int           @default(1)
  documentVersion   String?
  legalGuardianName String?
  relationship      String?
  signatureData     String?
  notes             String?
  metadataJson      Json          @default("{}")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  auditLogs ConsentAuditLog[]

  @@unique([tenantId, learnerId, consentType])
  @@index([tenantId, learnerId])
  @@index([tenantId, status])
  @@index([expiresAt])
  @@map("consents")
}

model ConsentAuditLog {
  id              String   @id @default(uuid()) @db.Uuid
  consentId       String   @db.Uuid
  tenantId        String   @db.Uuid
  action          String
  previousStatus  String?
  newStatus       String?
  performedBy     String   @db.Uuid
  performedByRole String
  ipAddress       String?
  userAgent       String?
  reason          String?
  metadataJson    Json     @default("{}")
  createdAt       DateTime @default(now())

  consent Consent @relation(fields: [consentId], references: [id], onDelete: Cascade)

  @@index([consentId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([performedBy])
  @@map("consent_audit_log")
}

model ConsentLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  learnerId   String   @db.Uuid
  parentEmail String
  consentType String
  grantedAt   DateTime @default(now())
  ipAddress   String?
  userAgent   String?
  source      String   @default("WEB")
  createdAt   DateTime @default(now())

  @@index([tenantId, learnerId])
  @@map("consent_logs")
}

model ParentalConsentLink {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  learnerId      String    @db.Uuid
  parentEmail    String
  consentTypes   String[]  @default([])
  token          String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  reminderSentAt DateTime?
  reminderCount  Int       @default(0)
  createdAt      DateTime  @default(now())

  @@index([token])
  @@index([tenantId, learnerId])
  @@index([expiresAt])
  @@map("parental_consent_links")
}

model ConsentVerificationMethod {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  name              String
  methodType        String
  description       String?
  isActive          Boolean  @default(true)
  isDefault         Boolean  @default(false)
  config            Json     @default("{}")
  verificationLevel String   @default("STANDARD")
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, methodType])
  @@index([tenantId, isActive])
  @@map("consent_verification_methods")
}

model ConsentStatusCache {
  tenantId              String   @db.Uuid
  learnerId             String   @db.Uuid
  hasCoppaConsent       Boolean  @default(false)
  hasFerpaConsent       Boolean  @default(false)
  hasMarketingConsent   Boolean  @default(false)
  hasDataSharingConsent Boolean  @default(false)
  hasAiFeatures         Boolean  @default(false)
  consentSummary        Json     @default("{}")
  lastUpdatedAt         DateTime @default(now())

  @@id([tenantId, learnerId])
  @@map("consent_status_cache")
}

model TenantCoppaSettings {
  tenantId                   String   @id @db.Uuid
  requireVerifiableConsent   Boolean  @default(true)
  defaultConsentExpiry       Int      @default(365)
  allowedVerificationMethods String[] @default(["EMAIL", "PHONE"])
  reminderEnabled            Boolean  @default(true)
  reminderDays               Int[]    @default([7, 3, 1])
  graceperiodDays            Int      @default(30)
  customConsentDocument      String?
  customPrivacyPolicy        String?
  notificationEmail          String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@map("tenant_coppa_settings")
}

// ══════════════════════════════════════════════════════════════════════════════
// LEGAL HOLD MODULE (formerly legal-hold-svc)
// ══════════════════════════════════════════════════════════════════════════════

enum MatterType {
  LITIGATION
  REGULATORY
  INVESTIGATION
  AUDIT
  ARBITRATION
  COMPLIANCE
  OTHER
}

enum MatterStatus {
  ACTIVE
  ON_HOLD
  SETTLED
  CLOSED
  ARCHIVED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum HoldStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ISSUED
  ACTIVE
  SUSPENDED
  RELEASED
  ARCHIVED
}

enum HoldPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CustodianStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  ON_LEAVE
}

enum HoldCustodianStatus {
  PENDING
  NOTIFIED
  ACKNOWLEDGED
  NON_COMPLIANT
  ESCALATED
  RELEASED
  EXEMPT
}

enum DataSourceType {
  EMAIL
  FILE_SHARE
  SHAREPOINT
  ONEDRIVE
  GOOGLE_DRIVE
  SLACK
  TEAMS
  DATABASE
  APPLICATION
  ARCHIVE
  BACKUP
  OTHER
}

enum PreservationStatus {
  PENDING
  IN_PROGRESS
  PRESERVED
  FAILED
  RELEASED
}

model LegalMatter {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @db.Uuid
  matterNumber    String
  name            String
  description     String?
  matterType      MatterType
  status          MatterStatus @default(ACTIVE)
  openedAt        DateTime     @default(now())
  closedAt        DateTime?
  anticipatedEnd  DateTime?
  leadCounsel     String?
  outsideCounsel  String?
  paralegal       String?
  jurisdiction    String?
  caseNumber      String?
  opposingParty   String?
  claimAmount     Decimal?     @db.Decimal(15, 2)
  riskLevel       RiskLevel    @default(MEDIUM)
  riskNotes       String?
  tags            String[]
  metadata        Json?
  createdBy       String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  holds           LegalHold[]
  custodians      MatterCustodian[]
  documents       MatterDocument[]
  notes           MatterNote[]
  activities      MatterActivity[]

  @@unique([tenantId, matterNumber])
  @@index([tenantId, status])
  @@index([tenantId, matterType])
  @@index([tenantId, openedAt])
  @@map("legal_matters")
}

model LegalHold {
  id                  String       @id @default(uuid()) @db.Uuid
  tenantId            String       @db.Uuid
  matterId            String       @db.Uuid
  holdNumber          String
  name                String
  description         String?
  status              HoldStatus   @default(DRAFT)
  scopeDescription    String?
  dataTypes           String[]
  dateRangeStart      DateTime?
  dateRangeEnd        DateTime?
  keywords            String[]
  issuedAt            DateTime?
  effectiveAt         DateTime?
  releasedAt          DateTime?
  notificationSubject String?
  notificationBody    String?      @db.Text
  reminderFrequency   Int?
  escalationAfter     Int?
  acknowledgmentDue   DateTime?
  complianceDeadline  DateTime?
  isConfidential      Boolean      @default(false)
  priority            HoldPriority @default(NORMAL)
  tags                String[]
  metadata            Json?
  createdBy           String
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  matter              LegalMatter  @relation(fields: [matterId], references: [id])
  custodians          HoldCustodian[]
  dataSources         HoldDataSource[]
  notifications       HoldNotification[]
  acknowledgments     HoldAcknowledgment[]
  releases            HoldRelease[]
  auditLog            HoldAuditLog[]

  @@unique([tenantId, holdNumber])
  @@index([tenantId, status])
  @@index([tenantId, matterId])
  @@index([tenantId, issuedAt])
  @@map("legal_holds")
}

model Custodian {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  userId          String?
  employeeId      String?
  email           String
  firstName       String
  lastName        String
  displayName     String
  department      String?
  title           String?
  location        String?
  manager         String?
  phone           String?
  alternateEmail  String?
  status          CustodianStatus @default(ACTIVE)
  hireDate        DateTime?
  terminationDate DateTime?
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  matters         MatterCustodian[]
  holds           HoldCustodian[]
  dataSources     CustodianDataSource[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([tenantId, department])
  @@index([tenantId, userId])
  @@map("custodians")
}

model MatterCustodian {
  id          String      @id @default(uuid()) @db.Uuid
  matterId    String      @db.Uuid
  custodianId String      @db.Uuid
  role        String?
  relevance   String?
  notes       String?
  addedAt     DateTime    @default(now())
  addedBy     String
  removedAt   DateTime?
  removedBy   String?

  matter      LegalMatter @relation(fields: [matterId], references: [id])
  custodian   Custodian   @relation(fields: [custodianId], references: [id])

  @@unique([matterId, custodianId])
  @@index([matterId])
  @@index([custodianId])
  @@map("matter_custodians")
}

model HoldCustodian {
  id                  String              @id @default(uuid()) @db.Uuid
  holdId              String              @db.Uuid
  custodianId         String              @db.Uuid
  status              HoldCustodianStatus @default(PENDING)
  notifiedAt          DateTime?
  notificationMethod  String?
  reminderCount       Int                 @default(0)
  lastReminderAt      DateTime?
  escalatedAt         DateTime?
  escalatedTo         String?
  acknowledgedAt      DateTime?
  acknowledgmentNotes String?
  releasedAt          DateTime?
  releaseReason       String?
  releasedBy          String?
  notes               String?
  metadata            Json?
  addedAt             DateTime            @default(now())
  addedBy             String

  hold      LegalHold @relation(fields: [holdId], references: [id])
  custodian Custodian @relation(fields: [custodianId], references: [id])

  @@unique([holdId, custodianId])
  @@index([holdId, status])
  @@index([custodianId])
  @@map("hold_custodians")
}

model DataSource {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @db.Uuid
  name           String
  description    String?
  sourceType     DataSourceType
  connectionInfo Json?
  canPreserve    Boolean        @default(true)
  canExport      Boolean        @default(true)
  canSearch      Boolean        @default(true)
  isActive       Boolean        @default(true)
  lastSyncAt     DateTime?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  custodians CustodianDataSource[]
  holds      HoldDataSource[]

  @@unique([tenantId, name])
  @@index([tenantId, sourceType])
  @@map("data_sources")
}

model CustodianDataSource {
  id            String     @id @default(uuid()) @db.Uuid
  custodianId   String     @db.Uuid
  dataSourceId  String     @db.Uuid
  identifier    String?
  estimatedSize BigInt?
  itemCount     Int?
  lastScanned   DateTime?

  custodian  Custodian  @relation(fields: [custodianId], references: [id])
  dataSource DataSource @relation(fields: [dataSourceId], references: [id])

  @@unique([custodianId, dataSourceId])
  @@index([custodianId])
  @@index([dataSourceId])
  @@map("custodian_data_sources")
}

model HoldDataSource {
  id              String             @id @default(uuid()) @db.Uuid
  holdId          String             @db.Uuid
  dataSourceId    String             @db.Uuid
  status          PreservationStatus @default(PENDING)
  preservedAt     DateTime?
  preservedBy     String?
  preservationId  String?
  itemsPreserved  Int?
  sizePreserved   BigInt?
  releasedAt      DateTime?
  releasedBy      String?
  notes           String?

  hold       LegalHold  @relation(fields: [holdId], references: [id])
  dataSource DataSource @relation(fields: [dataSourceId], references: [id])

  @@unique([holdId, dataSourceId])
  @@index([holdId, status])
  @@map("hold_data_sources")
}

model HoldNotification {
  id               String    @id @default(uuid()) @db.Uuid
  holdId           String    @db.Uuid
  tenantId         String    @db.Uuid
  notificationType String
  recipientEmail   String
  recipientName    String?
  subject          String
  body             String    @db.Text
  status           String    @default("PENDING")
  sentAt           DateTime?
  deliveredAt      DateTime?
  failureReason    String?
  retryCount       Int       @default(0)
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  hold LegalHold @relation(fields: [holdId], references: [id], onDelete: Cascade)

  @@index([holdId])
  @@index([tenantId, status])
  @@map("hold_notifications")
}

model HoldAcknowledgment {
  id                  String    @id @default(uuid()) @db.Uuid
  holdId              String    @db.Uuid
  tenantId            String    @db.Uuid
  custodianId         String    @db.Uuid
  token               String    @unique
  acknowledgedAt      DateTime?
  ipAddress           String?
  userAgent           String?
  acknowledgmentNotes String?
  isValid             Boolean   @default(true)
  expiresAt           DateTime
  createdAt           DateTime  @default(now())

  hold LegalHold @relation(fields: [holdId], references: [id], onDelete: Cascade)

  @@index([holdId])
  @@index([token])
  @@map("hold_acknowledgments")
}

model HoldRelease {
  id          String   @id @default(uuid()) @db.Uuid
  holdId      String   @db.Uuid
  tenantId    String   @db.Uuid
  releaseType String
  releasedBy  String   @db.Uuid
  reason      String?
  notes       String?
  effectiveAt DateTime @default(now())
  metadata    Json?
  createdAt   DateTime @default(now())

  hold LegalHold @relation(fields: [holdId], references: [id], onDelete: Cascade)

  @@index([holdId])
  @@map("hold_releases")
}

model HoldAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  holdId      String   @db.Uuid
  tenantId    String   @db.Uuid
  action      String
  performedBy String?  @db.Uuid
  ipAddress   String?
  userAgent   String?
  details     Json?
  createdAt   DateTime @default(now())

  hold LegalHold @relation(fields: [holdId], references: [id], onDelete: Cascade)

  @@index([holdId])
  @@index([tenantId, createdAt])
  @@map("hold_audit_log")
}

model MatterDocument {
  id          String      @id @default(uuid()) @db.Uuid
  matterId    String      @db.Uuid
  tenantId    String      @db.Uuid
  title       String
  description String?
  fileUrl     String?
  fileName    String?
  fileSize    Int?
  mimeType    String?
  uploadedBy  String      @db.Uuid
  tags        String[]
  metadata    Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  matter LegalMatter @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@index([matterId])
  @@index([tenantId])
  @@map("matter_documents")
}

model MatterNote {
  id        String      @id @default(uuid()) @db.Uuid
  matterId  String      @db.Uuid
  tenantId  String      @db.Uuid
  content   String      @db.Text
  createdBy String      @db.Uuid
  isPrivate Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  matter LegalMatter @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@index([matterId])
  @@map("matter_notes")
}

model MatterActivity {
  id           String      @id @default(uuid()) @db.Uuid
  matterId     String      @db.Uuid
  tenantId     String      @db.Uuid
  activityType String
  description  String
  performedBy  String?     @db.Uuid
  metadata     Json?
  createdAt    DateTime    @default(now())

  matter LegalMatter @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@index([matterId])
  @@index([tenantId, createdAt])
  @@map("matter_activities")
}

// ══════════════════════════════════════════════════════════════════════════════
// DSR MODULE (formerly dsr-svc) — Data Subject Requests (GDPR/CCPA)
// ══════════════════════════════════════════════════════════════════════════════

model DsrRequest {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  requestType        String    // ACCESS, DELETE, RECTIFY, PORTABILITY, RESTRICT
  status             String    @default("PENDING")
  requesterId        String    @db.Uuid
  requesterEmail     String
  requesterRole      String
  subjectId          String    @db.Uuid
  subjectType        String
  relationship       String?
  verificationMethod String?
  verifiedAt         DateTime?
  verifiedBy         String?   @db.Uuid
  assignedTo         String?   @db.Uuid
  priority           String    @default("NORMAL")
  dueDate            DateTime
  completedAt        DateTime?
  completedBy        String?   @db.Uuid
  rejectionReason    String?
  notes              String?
  metadataJson       Json      @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  jobs      DsrJob[]
  artifacts DsrExportArtifact[]

  @@index([tenantId, status])
  @@index([tenantId, subjectId])
  @@index([status, dueDate])
  @@index([createdAt(sort: Desc)])
  @@map("dsr_requests")
}

model DsrJob {
  id             String    @id @default(uuid()) @db.Uuid
  requestId      String    @db.Uuid
  tenantId       String    @db.Uuid
  serviceName    String
  jobType        String
  status         String    @default("PENDING")
  progress       Int       @default(0)
  itemsProcessed Int       @default(0)
  itemsTotal     Int       @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  error          String?
  resultSummary  Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  request DsrRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([tenantId, status])
  @@index([serviceName, status])
  @@map("dsr_jobs")
}

model DsrExportArtifact {
  id            String    @id @default(uuid()) @db.Uuid
  requestId     String    @db.Uuid
  tenantId      String    @db.Uuid
  serviceName   String
  artifactType  String
  fileName      String
  filePath      String?
  storageUrl    String?
  fileSizeBytes BigInt    @default(0)
  checksum      String?
  encryptionKey String?
  expiresAt     DateTime
  downloadedAt  DateTime?
  downloadCount Int       @default(0)
  createdAt     DateTime  @default(now())

  request DsrRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([tenantId])
  @@index([expiresAt])
  @@map("dsr_export_artifacts")
}

model DataExport {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  dsrRequestId      String?   @db.Uuid
  subjectId         String    @db.Uuid
  subjectType       String
  format            String
  categories        Json      @default("[]")
  dateRangeFrom     DateTime?
  dateRangeTo       DateTime?
  includeMetadata   Boolean   @default(true)
  encryptExport     Boolean   @default(false)
  encryptionKeyId   String?
  status            String    @default("PENDING")
  progress          Int       @default(0)
  startedAt         DateTime?
  completedAt       DateTime?
  failedAt          DateTime?
  failureReason     String?
  outputPath        String?
  outputSize        BigInt?
  checksum          String?
  downloadUrl       String?
  downloadExpiresAt DateTime?
  downloadCount     Int       @default(0)
  requestedByUserId String    @db.Uuid
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  jobs ExportJob[]

  @@index([tenantId, status])
  @@index([tenantId, subjectId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("data_exports")
}

model ExportJob {
  id          String    @id @default(uuid()) @db.Uuid
  exportId    String    @db.Uuid
  tenantId    String    @db.Uuid
  status      String    @default("QUEUED")
  priority    String    @default("NORMAL")
  workerId    String?
  startedAt   DateTime?
  completedAt DateTime?
  retryCount  Int       @default(0)
  maxRetries  Int       @default(3)
  lastError   String?
  nextRetryAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  export DataExport @relation(fields: [exportId], references: [id], onDelete: Cascade)

  @@index([status, priority])
  @@index([exportId])
  @@index([tenantId])
  @@map("export_jobs")
}
