# ══════════════════════════════════════════════════════════════════════════════
# AIVO Compliance Service - Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════

# Server
PORT=4052
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://localhost:5432/aivo_compliance

# JWT Authentication
JWT_PUBLIC_KEY_PATH=../../.keys/jwt-public.pem
INTERNAL_API_KEY=dev-internal-key

# Redis
REDIS_URL=redis://localhost:6379

# NATS
NATS_URL=nats://localhost:4222
NATS_ENABLED=true

# Compliance Settings
SNAPSHOT_INTERVAL_HOURS=24
EVIDENCE_EXPIRY_WARNING_DAYS=30
FINDING_OVERDUE_DAYS=90

# Service URLs
AUTH_SVC_URL=http://auth-svc:4001
AUDIT_SVC_URL=http://audit-svc:4050
