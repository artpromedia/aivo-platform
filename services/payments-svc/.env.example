# ══════════════════════════════════════════════════════════════════════════════
# AIVO Platform - Payments Service Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and configure values for your environment.
# NEVER commit actual secrets to version control!

# ══════════════════════════════════════════════════════════════════════════════
# SERVICE CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════
NODE_ENV=development
PORT=4070
HOST=0.0.0.0

# ══════════════════════════════════════════════════════════════════════════════
# STRIPE CONFIGURATION - CRITICAL
# ══════════════════════════════════════════════════════════════════════════════
# In production, these MUST be set to valid Stripe keys.
# The service will FAIL to start if placeholder values are detected in production.
#
# Get your keys from: https://dashboard.stripe.com/apikeys
#
# For test mode (development/staging):
#   STRIPE_SECRET_KEY=sk_test_xxx...
#   STRIPE_WEBHOOK_SECRET=whsec_xxx... (from Stripe CLI or Dashboard)
#
# For live mode (production):
#   STRIPE_SECRET_KEY=sk_live_xxx...
#   STRIPE_WEBHOOK_SECRET=whsec_xxx... (from Dashboard Webhooks)

STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# ══════════════════════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://aivo:aivo@localhost:5432/aivo_billing

# ══════════════════════════════════════════════════════════════════════════════
# SERVICE URLS
# ══════════════════════════════════════════════════════════════════════════════
BILLING_SERVICE_URL=http://localhost:4060
ENTITLEMENTS_SVC_URL=http://localhost:4080

# ══════════════════════════════════════════════════════════════════════════════
# REDIS / EVENT BUS
# ══════════════════════════════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379
EVENT_BUS_CHANNEL_PREFIX=aivo:billing
EVENT_BUS_ENABLED=true

# ══════════════════════════════════════════════════════════════════════════════
# SUBSCRIPTION DEFAULTS
# ══════════════════════════════════════════════════════════════════════════════
DEFAULT_TRIAL_DAYS=30

# ══════════════════════════════════════════════════════════════════════════════
# DUNNING CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════
# Grace period before downgrading after failed payment (in days)
DUNNING_GRACE_PERIOD_DAYS=7
# Whether to automatically downgrade on payment failure
DUNNING_AUTO_DOWNGRADE=true
