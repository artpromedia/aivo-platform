{
  "extends": "../../tsconfig.compat.json",
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts", "src/security/**", "src/prisma/prisma.module.ts", "src/prisma/prisma.service.ts", "src/prisma/index.ts"]
}

