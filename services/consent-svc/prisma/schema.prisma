// Consent Service Prisma Schema
// COPPA/FERPA compliant consent management
// Converted from SQL migrations 0001-0003

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums
// =============================================================================

enum ConsentStatus {
  PENDING
  GRANTED
  DENIED
  REVOKED
  EXPIRED

  @@map("consent_status")
}

enum ConsentType {
  COPPA
  FERPA
  MARKETING
  DATA_SHARING
  ANALYTICS
  THIRD_PARTY
  AI_FEATURES
  COMMUNICATION

  @@map("consent_type_enum")
}

enum ConsentSource {
  PARENT_PORTAL
  EMAIL_LINK
  PAPER_FORM
  IN_PERSON
  BULK_IMPORT
  SCHOOL_ADMIN
  API

  @@map("consent_source")
}

// =============================================================================
// Consents
// =============================================================================

model Consent {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  learnerId         String        @map("learner_id") @db.Uuid
  parentId          String?       @map("parent_id") @db.Uuid
  consentType       ConsentType   @map("consent_type")
  status            ConsentStatus @default(PENDING)
  consentedAt       DateTime?     @map("consented_at") @db.Timestamptz
  expiresAt         DateTime?     @map("expires_at") @db.Timestamptz
  revokedAt         DateTime?     @map("revoked_at") @db.Timestamptz
  consentSource     ConsentSource @map("consent_source")
  ipAddress         String?       @map("ip_address") @db.Inet
  userAgent         String?       @map("user_agent")
  version           Int           @default(1)
  documentVersion   String?       @map("document_version")
  legalGuardianName String?       @map("legal_guardian_name")
  relationship      String?
  signatureData     String?       @map("signature_data")
  notes             String?
  metadataJson      Json          @default("{}") @map("metadata_json")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  auditLogs ConsentAuditLog[]

  @@unique([tenantId, learnerId, consentType], map: "uq_consent_learner_type")
  @@index([tenantId, learnerId])
  @@index([tenantId, status])
  @@index([expiresAt])
  @@map("consents")
}

// =============================================================================
// Consent Audit Log
// =============================================================================

model ConsentAuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consentId    String   @map("consent_id") @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  action       String   // CREATED, GRANTED, DENIED, REVOKED, EXPIRED, RENEWED
  previousStatus String? @map("previous_status")
  newStatus    String?  @map("new_status")
  performedBy  String   @map("performed_by") @db.Uuid
  performedByRole String @map("performed_by_role")
  ipAddress    String?  @map("ip_address") @db.Inet
  userAgent    String?  @map("user_agent")
  reason       String?
  metadataJson Json     @default("{}") @map("metadata_json")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  consent Consent @relation(fields: [consentId], references: [id], onDelete: Cascade)

  @@index([consentId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([performedBy])
  @@map("consent_audit_log")
}

// =============================================================================
// Legacy Consent Logs (for backward compatibility)
// =============================================================================

model ConsentLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  learnerId   String   @map("learner_id") @db.Uuid
  parentEmail String   @map("parent_email")
  consentType String   @map("consent_type")
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz
  ipAddress   String?  @map("ip_address") @db.Inet
  userAgent   String?  @map("user_agent")
  source      String   @default("WEB")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, learnerId])
  @@map("consent_logs")
}

// =============================================================================
// Parental Consent Links
// =============================================================================

model ParentalConsentLink {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  learnerId    String    @map("learner_id") @db.Uuid
  parentEmail  String    @map("parent_email")
  consentTypes String[]  @default([]) @map("consent_types")
  token        String    @unique
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  usedAt       DateTime? @map("used_at") @db.Timestamptz
  reminderSentAt DateTime? @map("reminder_sent_at") @db.Timestamptz
  reminderCount Int      @default(0) @map("reminder_count")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([token])
  @@index([tenantId, learnerId])
  @@index([expiresAt])
  @@map("parental_consent_links")
}

// =============================================================================
// Consent Verification Methods
// =============================================================================

model ConsentVerificationMethod {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  name             String
  methodType       String   @map("method_type") // EMAIL, PHONE, VIDEO, DOCUMENT, CREDIT_CARD_VERIFICATION
  description      String?
  isActive         Boolean  @default(true) @map("is_active")
  isDefault        Boolean  @default(false) @map("is_default")
  config           Json     @default("{}")
  verificationLevel String  @default("STANDARD") @map("verification_level") // BASIC, STANDARD, ENHANCED
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([tenantId, methodType], map: "uq_tenant_method_type")
  @@index([tenantId, isActive])
  @@map("consent_verification_methods")
}

// =============================================================================
// Consent Status Cache
// =============================================================================

model ConsentStatusCache {
  tenantId          String   @map("tenant_id") @db.Uuid
  learnerId         String   @map("learner_id") @db.Uuid
  hasCoppaConsent   Boolean  @default(false) @map("has_coppa_consent")
  hasFerpaConsent   Boolean  @default(false) @map("has_ferpa_consent")
  hasMarketingConsent Boolean @default(false) @map("has_marketing_consent")
  hasDataSharingConsent Boolean @default(false) @map("has_data_sharing_consent")
  hasAiFeatures     Boolean  @default(false) @map("has_ai_features")
  consentSummary    Json     @default("{}") @map("consent_summary")
  lastUpdatedAt     DateTime @default(now()) @map("last_updated_at") @db.Timestamptz

  @@id([tenantId, learnerId])
  @@map("consent_status_cache")
}

// =============================================================================
// Tenant COPPA Settings
// =============================================================================

model TenantCoppaSettings {
  tenantId                   String   @id @map("tenant_id") @db.Uuid
  requireVerifiableConsent   Boolean  @default(true) @map("require_verifiable_consent")
  defaultConsentExpiry       Int      @default(365) @map("default_consent_expiry_days")
  allowedVerificationMethods String[] @default(["EMAIL", "PHONE"]) @map("allowed_verification_methods")
  reminderEnabled            Boolean  @default(true) @map("reminder_enabled")
  reminderDays               Int[]    @default([7, 3, 1]) @map("reminder_days")
  graceperiodDays            Int      @default(30) @map("graceperiod_days")
  customConsentDocument      String?  @map("custom_consent_document")
  customPrivacyPolicy        String?  @map("custom_privacy_policy")
  notificationEmail          String?  @map("notification_email")
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("tenant_coppa_settings")
}
