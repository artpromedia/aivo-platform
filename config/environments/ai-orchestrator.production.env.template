# ═══════════════════════════════════════════════════════════════════════════════
# AI Orchestrator - PRODUCTION Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# 
# DEPLOYMENT NOTES:
# - Google Gemini AI is the PRIMARY provider (cost-effective, fast)
# - OpenAI is Fallback 1 (reliable, high quality)
# - Anthropic is Fallback 2 (safety-focused, good for educational content)
# - Ollama is NOT used in production (local development only)
#
# FAILOVER BEHAVIOR:
# 1. Try Google Gemini first
# 2. If Google fails (rate limit, timeout, error) → circuit breaker opens
# 3. Automatically failover to OpenAI
# 4. If OpenAI fails → failover to Anthropic
# 5. Circuit breakers auto-reset after 30 seconds
#
# ═══════════════════════════════════════════════════════════════════════════════

# Core Service Configuration
PORT=4010
NODE_ENV=production
INTERNAL_API_KEY=${INTERNAL_API_KEY}
DATABASE_URL=${DATABASE_URL}
AGENT_CONFIG_CACHE_TTL_MS=60000

# ═══════════════════════════════════════════════════════════════════════════════
# LLM PROVIDER CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# Primary Provider: Google Gemini AI
LLM_PRIMARY_PROVIDER=google
LLM_FALLBACK_ORDER=google,openai,anthropic

# ───────────────────────────────────────────────────────────────────────────────
# Google Gemini (PRIMARY)
# ───────────────────────────────────────────────────────────────────────────────
# Get API key from: https://aistudio.google.com/app/apikey
# Or use Vertex AI with service account for enterprise

GOOGLE_GEMINI_API_KEY=${GOOGLE_GEMINI_API_KEY}
GOOGLE_PROJECT_ID=${GCP_PROJECT_ID}
GOOGLE_LOCATION=us-central1
GOOGLE_RATE_LIMIT_TPM=100000
GOOGLE_RATE_LIMIT_RPM=500

# ───────────────────────────────────────────────────────────────────────────────
# OpenAI (FALLBACK 1)
# ───────────────────────────────────────────────────────────────────────────────
# Get API key from: https://platform.openai.com/api-keys

OPENAI_API_KEY=${OPENAI_API_KEY}
OPENAI_ORGANIZATION_ID=${OPENAI_ORG_ID}
OPENAI_RATE_LIMIT_TPM=150000
OPENAI_RATE_LIMIT_RPM=500

# ───────────────────────────────────────────────────────────────────────────────
# Anthropic (FALLBACK 2)
# ───────────────────────────────────────────────────────────────────────────────
# Get API key from: https://console.anthropic.com/

ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
ANTHROPIC_RATE_LIMIT_TPM=100000
ANTHROPIC_RATE_LIMIT_RPM=500

# ═══════════════════════════════════════════════════════════════════════════════
# LLM CACHE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
# Redis cache reduces API costs by caching identical prompts

LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=3600
LLM_CACHE_REDIS_URL=${REDIS_URL}

# ═══════════════════════════════════════════════════════════════════════════════
# SAFETY CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

SAFETY_STRICT_MODE=true
SAFETY_LOG_BLOCKED_CONTENT=true

# ═══════════════════════════════════════════════════════════════════════════════
# OBSERVABILITY
# ═══════════════════════════════════════════════════════════════════════════════

LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=${OTEL_ENDPOINT}
OTEL_SERVICE_NAME=ai-orchestrator
