# Mobile Learner App - Environment Configuration
# Copy this file to .env and fill in your values
# These are passed to Flutter via --dart-define-from-file

# ============================================================================
# ENVIRONMENT
# ============================================================================
APP_ENV=production              # development, staging, production
ENABLE_MOCK_MODE=false         # NEVER enable in production (COPPA compliance)

# ============================================================================
# BACKEND SERVICE URLS
# ============================================================================

# Core Services
AUTH_BASE_URL=https://api.aivo.app/auth
LEARNER_BASE_URL=https://api.aivo.app/learner
BASELINE_BASE_URL=https://api.aivo.app/baseline

# Learning & AI
LEARNER_MODEL_BASE_URL=https://api.aivo.app/learner-model
AI_ORCHESTRATOR_BASE_URL=https://api.aivo.app/ai
SESSION_BASE_URL=https://api.aivo.app/sessions
HOMEWORK_HELPER_BASE_URL=https://api.aivo.app/homework

# Focus & Executive Function
FOCUS_BASE_URL=https://api.aivo.app/focus
EXECUTIVE_FUNCTION_BASE_URL=https://api.aivo.app/executive-function

# Analytics & Gamification
ANALYTICS_BASE_URL=https://api.aivo.app/analytics
GAMIFICATION_BASE_URL=https://api.aivo.app/gamification
GAME_LIBRARY_BASE_URL=https://api.aivo.app/games

# Educational Tools
READING_TOOLS_BASE_URL=https://api.aivo.app/reading-tools
STUDY_SKILLS_BASE_URL=https://api.aivo.app/study-skills
VISUAL_LEARNING_BASE_URL=https://api.aivo.app/visual-learning

# Neurodivergent Support
SENSORY_BASE_URL=https://api.aivo.app/sensory
SENSORY_ACCOMMODATIONS_BASE_URL=https://api.aivo.app/sensory-accommodations
SPEECH_THERAPY_BASE_URL=https://api.aivo.app/speech-therapy
SOCIAL_STORIES_BASE_URL=https://api.aivo.app/social-stories
MOTOR_SKILLS_BASE_URL=https://api.aivo.app/motor-skills
SEL_BASE_URL=https://api.aivo.app/sel

# Content & Offline Support
CONTENT_BASE_URL=https://api.aivo.app/content
OFFLINE_SYNC_BASE_URL=https://api.aivo.app/offline

# Profile & Settings
PROFILE_SVC_BASE_URL=https://api.aivo.app/profile

# ============================================================================
# FIREBASE CONFIGURATION (COPPA Compliant)
# ============================================================================
# Generated via: flutterfire configure
# Download google-services.json and GoogleService-Info.plist from Firebase Console
# IMPORTANT: Configure Crashlytics with is_child_device: true

FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_PROJECT_ID=aivo-platform
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_STORAGE_BUCKET=aivo-platform.appspot.com

# ============================================================================
# BUILD CONFIGURATION
# ============================================================================
FLAVOR=prod                    # dev, staging, prod

# ============================================================================
# COPPA COMPLIANCE NOTES
# ============================================================================
# This app is for children under 13 and MUST comply with COPPA:
# - No behavioral advertising
# - No data collection for marketing
# - Parental consent required
# - Data minimization
# - See docs/compliance/COPPA_CHECKLIST.md
#
# Fastlane automatically runs COPPA checks before production builds

# ============================================================================
# USAGE IN BUILD COMMANDS
# ============================================================================
# Development:
#   flutter run --dart-define-from-file=.env.development
#
# Staging:
#   flutter build apk --dart-define-from-file=.env.staging
#
# Production:
#   flutter build appbundle --release --dart-define-from-file=.env.production
#
# With COPPA checks:
#   cd android && fastlane build_release
#
# Note: Create separate .env.development, .env.staging, .env.production files
# with environment-specific values
