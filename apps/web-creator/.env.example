# =============================================================================
# AIVO Web Creator — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in values for your environment.

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Client-side (NEXT_PUBLIC_*) ──────────────────────────────────────────────
# WebSocket URL for real-time collaboration
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Content service URL
NEXT_PUBLIC_CONTENT_SERVICE_URL=

# Research analytics API
NEXT_PUBLIC_RESEARCH_URL=http://localhost:4020

# Marketplace API URL (primary API for content items)
NEXT_PUBLIC_MARKETPLACE_API_URL=http://localhost:4070/api/v1
