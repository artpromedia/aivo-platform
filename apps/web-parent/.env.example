# =============================================================================
# AIVO Web Parent — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in values for your environment.

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Server-side ──────────────────────────────────────────────────────────────
# Tenant service for district/school lookup
TENANT_SERVICE_URL=http://localhost:3010

# Auth service for token exchange
AUTH_SVC_URL=http://localhost:4001

# Marketing API for SSO callback
NEXT_PUBLIC_MARKETING_API_URL=http://localhost:3001/api

# ── Client-side (NEXT_PUBLIC_*) ──────────────────────────────────────────────
# Core API gateway
NEXT_PUBLIC_API_URL=http://localhost:4000

# WebSocket URL for real-time notifications
NEXT_PUBLIC_WS_URL=wss://api.aivo.com/ws

# Analytics API
NEXT_PUBLIC_ANALYTICS_URL=

# Gamification service (server-side BFF calls)
GAMIFICATION_SVC_URL=http://localhost:3006
# Gamification service (client-side, if needed)
NEXT_PUBLIC_GAMIFICATION_URL=http://localhost:3006

# Billing/payments API
NEXT_PUBLIC_BILLING_URL=

# Stripe publishable key (for Stripe.js checkout redirect)
NEXT_PUBLIC_STRIPE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Feature flags
NEXT_PUBLIC_FEATURE_FLAGS=

# Auth service URL (used in login/register forms)
NEXT_PUBLIC_AUTH_URL=http://localhost:4001
