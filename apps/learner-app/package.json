{
  "name": "@aivo/learner-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start -p 3003",
    "lint": "next lint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:a11y": "pa11y-ci",
    "test:a11y:ci": "start-server-and-test 'next start -p 3003' http://localhost:3003 test:a11y",
    "audit:lighthouse": "lhci autorun",
    "audit:bundle": "ANALYZE=true next build",
    "audit:performance": "npm run audit:lighthouse",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aivo/ui": "workspace:*",
    "@sentry/nextjs": "^7.100.0",
    "@supabase/supabase-js": "^2.39.0",
    "framer-motion": "^10.18.0",
    "next": "^14.0.4",
    "next-pwa": "^5.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@axe-core/react": "^4.8.4",
    "@lhci/cli": "^0.13.0",
    "@next/bundle-analyzer": "^14.0.4",
    "@testing-library/react": "^14.1.2",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "pa11y-ci": "^3.1.0",
    "postcss": "^8.4.32",
    "sharp": "^0.33.2",
    "start-server-and-test": "^2.0.3",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.2",
    "vitest": "^1.1.0"
  }
}
