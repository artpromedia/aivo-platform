# =============================================================================
# AIVO Learner App (Next.js PWA) — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in values for your environment.

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Client-side (NEXT_PUBLIC_*) ──────────────────────────────────────────────
# Core API URL (required) — the main backend gateway
NEXT_PUBLIC_API_URL=http://localhost:4000

# App name and version
NEXT_PUBLIC_APP_NAME=AIVO Learner
NEXT_PUBLIC_APP_VERSION=1.0.0

# WebSocket URL for real-time features
NEXT_PUBLIC_WS_URL=

# AI service URL
NEXT_PUBLIC_AI_URL=

# Enable mock mode for development
NEXT_PUBLIC_ENABLE_MOCKS=false

# ── Server-side / Build ─────────────────────────────────────────────────────
# Enable bundle analyzer
ANALYZE=false

# Disable PWA in development
NEXT_PUBLIC_DISABLE_PWA=true
