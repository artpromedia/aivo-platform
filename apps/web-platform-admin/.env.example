# =============================================================================
# AIVO Web Platform Admin — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in values for your environment.

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Server-side ──────────────────────────────────────────────────────────────
# Auth service — JWT verification (required in production)
AUTH_SERVICE_URL=http://localhost:4001

# Tenant service — tenant CRUD and feature flags
TENANT_SERVICE_URL=http://localhost:4002

# AI orchestrator — model registry, usage, incidents
AI_ORCHESTRATOR_URL=http://localhost:4010

# Model registry — model cards, safety reports
MODEL_REGISTRY_URL=http://localhost:4011

# Next-Auth secret (required in production)
NEXTAUTH_SECRET=dev-secret-change-me

# Next-Auth URL
NEXTAUTH_URL=http://localhost:3000

# Learner model service — learner analytics
LEARNER_MODEL_URL=http://localhost:4025

# Legal holds service
LEGAL_HOLD_SVC_URL=http://localhost:4061

# ── Client-side (NEXT_PUBLIC_*) ──────────────────────────────────────────────
# Research analytics dashboard
NEXT_PUBLIC_RESEARCH_URL=http://localhost:3400

# Marketplace service
NEXT_PUBLIC_MARKETPLACE_API_URL=http://localhost:4070/api/v1

# Compliance dashboard URL
NEXT_PUBLIC_COMPLIANCE_URL=

# Billing FinOps URL
NEXT_PUBLIC_FINOPS_URL=http://localhost:4060
