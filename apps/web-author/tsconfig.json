{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": ".next",
    "jsx": "preserve",
    "noEmit": true,
    "moduleResolution": "Bundler",
    "module": "esnext",
    "ignoreDeprecations": "5.0",
    "exactOptionalPropertyTypes": false,
    "baseUrl": ".",
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    "paths": {
      "@aivo/i18n": ["../../packages/i18n/dist"],
      "@aivo/*": ["../../libs/*/src", "../../services/*/src", "../../apps/*/src"],
      "@/*": ["./*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "app/**/*",
    "components/**/*",
    "lib/**/*",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "middleware.ts"
  ],
  "exclude": ["node_modules", ".next", "dist", "build"]
}
