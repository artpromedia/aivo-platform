# =============================================================================
# AIVO Web Author — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in values for your environment.

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Server-side ──────────────────────────────────────────────────────────────
# Auth service — JWT verification
AUTH_SERVICE_URL=http://localhost:4001

# Auth public key for JWT verification (PEM format, optional — falls back to auth-svc)
AUTH_PUBLIC_KEY=

# Content authoring service (used in next.config.mjs rewrites)
AUTHORING_SVC_URL=http://localhost:4060

# Learner model service (used in next.config.mjs rewrites)
LEARNER_MODEL_SVC_URL=http://localhost:4025

# ── Client-side (NEXT_PUBLIC_*) ──────────────────────────────────────────────
# Authoring service URL (client-side API calls)
NEXT_PUBLIC_AUTHORING_SVC_URL=/api/authoring

# Learner model service URL (client-side)
NEXT_PUBLIC_LEARNER_MODEL_SVC_URL=/api/learner-model

# WebSocket URL for real-time collaboration
NEXT_PUBLIC_WS_URL=ws://localhost:3003
