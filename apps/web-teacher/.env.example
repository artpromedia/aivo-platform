# =============================================================================
# AIVO Web Teacher — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in values for your environment.

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Client-side (NEXT_PUBLIC_*) ──────────────────────────────────────────────
# WebSocket server for real-time collaboration (presence, live dashboard)
NEXT_PUBLIC_WS_URL=http://localhost:3003

# Analytics service URL
NEXT_PUBLIC_ANALYTICS_URL=http://localhost:8090

# Gamification service URL
NEXT_PUBLIC_GAMIFICATION_URL=http://localhost:8091

# Accessibility service URL
NEXT_PUBLIC_ACCESSIBILITY_SVC_URL=http://localhost:8092

# Professional development API URL
NEXT_PUBLIC_PD_API_URL=http://localhost:8097

# Marketplace API URL
NEXT_PUBLIC_MARKETPLACE_API_URL=http://localhost:8096

# Core API URL (used by auth and API client)
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Server-side ──────────────────────────────────────────────────────────────
# IEP service URL (proxied by /api/iep/[...path])
IEP_SVC_URL=http://localhost:4070

# Enable webpack bundle analyzer (set to "true" to enable)
ANALYZE=false
