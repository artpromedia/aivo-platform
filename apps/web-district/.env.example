# =============================================================================
# AIVO Web District — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in values for your environment.

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Server-side ──────────────────────────────────────────────────────────────
# Auth service — JWT verification and token exchange
AUTH_SERVICE_URL=http://localhost:4001

# Tenant service — multi-tenant management, district data
TENANT_SERVICE_URL=http://localhost:3010

# ── Client-side (NEXT_PUBLIC_*) ──────────────────────────────────────────────
# Core API gateway
NEXT_PUBLIC_API_URL=http://localhost:4000

# Analytics reporting API
NEXT_PUBLIC_ANALYTICS_API_URL=http://localhost:4080

# Content authoring service
NEXT_PUBLIC_AUTHORING_URL=http://localhost:4060

# Billing service
NEXT_PUBLIC_BILLING_URL=

# Marketplace service
NEXT_PUBLIC_MARKETPLACE_API_URL=http://localhost:4070/api/v1

# Entitlements service
NEXT_PUBLIC_ENTITLEMENTS_URL=http://localhost:4012

# SIS (Student Information System) integration URL
NEXT_PUBLIC_SIS_API_URL=

# WebSocket URL for real-time features
NEXT_PUBLIC_WS_URL=http://localhost:3003
