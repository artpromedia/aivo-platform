{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "outDir": ".next",
    "jsx": "preserve",
    "noEmit": true,
    "moduleResolution": "Bundler",
    "module": "esnext",
    "baseUrl": ".",
    "paths": {
      "@aivo/*": [
        "../../libs/*/src",
        "../../services/*/src",
        "../../apps/*/src",
        "../../packages/*/src"
      ],
      "@/*": ["./*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "app/**/*",
    "components/**/*",
    "lib/**/*",
    "middleware.ts",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "build",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "app/design-system/**/*"
  ]
}
